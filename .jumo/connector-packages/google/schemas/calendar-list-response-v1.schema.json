{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jumo.dev/schemas/connector-packages/google-workspace/calendar-list-response-v1",
  "type": "object",
  "properties": {
    "calendars": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "summary": { "type": "string" },
          "accessRole": {
            "type": "string",
            "enum": ["owner"],
            "description": "Only the owner's own calendars are ever returned; a shared calendar the owner can merely write to, and any other access role, is filtered out before this response is built, not merely hidden here."
          },
          "primary": { "type": "boolean" }
        },
        "required": ["id", "summary", "accessRole"],
        "additionalProperties": false
      }
    }
  },
  "required": ["calendars"],
  "additionalProperties": false
}
