jumo:ControlAssessment a sh:NodeShape ;
    rdfs:comment "Recognized result of assessing a Control against a ComplianceProfile, with observed evidence. Runtime-only (PostgreSQL), not a Git contract kind -- no apiVersion/kind wrapper. No CERTIFIED or CONFORMANT status without external attestation, evaluator identity, and a validity period (enforced in Rego)." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class jumo:ExternalAttestation ;
            sh:description "Required when status is EXTERNALLY_ATTESTED (Rego)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path jumo:attestation ],
        [ sh:datatype xsd:string ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path jumo:evidenceRefs ],
        [ sh:in ( "NOT_ASSESSED" "MAPPED" "EVIDENCED" "EXTERNALLY_ATTESTED" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 2 ;
            sh:path jumo:status ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path jumo:complianceProfileRef ;
            sh:pattern "^[a-z][a-z0-9-]*$" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path jumo:controlRef ;
            sh:pattern "^[a-z][a-z0-9-]*$" ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path jumo:assessedAt ] ;
    sh:targetClass jumo:ControlAssessment .

jumo:ControlCatalog a sh:NodeShape ;
    rdfs:comment "Internal controls, reusable across ComplianceProfiles (docs/concepts/positionnement-conceptuel.md#conformite-et-auditabilite-par-construction). Split out of the source GovernanceOverlay's inline `controls[]` array, so a control is declared once and mapped from many profiles rather than copy-pasted per referential." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class jumo:Metadata ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path jumo:metadata ],
        [ sh:class jumo:ControlCatalogSpec ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path jumo:spec ],
        [ sh:datatype xsd:string ;
            sh:in ( "jumo.dev/v1" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path jumo:apiVersion ],
        [ sh:datatype xsd:string ;
            sh:in ( "ControlCatalog" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path jumo:kind ] ;
    sh:targetClass jumo:ControlCatalog .

jumo:CoordinationProfile a sh:NodeShape ;
    rdfs:comment "A named, reusable coordination profile: authorized mechanisms, target dependencies, rhythm, and preconditions for team coordination. Distinct from TeamSpec.coordination (inline, per-team) -- a CoordinationProfile is declared once and referenced by name from multiple teams or improvement-loop targets, while TeamSpec.coordination is that team's own binding. Already used mechanisms[] in the source schema (unlike TeamSpec's single `mode`), so this class's mechanisms list was not itself the redesign target -- it gains the same CoordinationMechanismBinding shape as TeamSpec for vocabulary consistency, replacing what was a flat CoordinationMechanism list." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class jumo:CoordinationProfileSpec ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path jumo:spec ],
        [ sh:datatype xsd:string ;
            sh:in ( "CoordinationProfile" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path jumo:kind ],
        [ sh:class jumo:Metadata ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path jumo:metadata ],
        [ sh:datatype xsd:string ;
            sh:in ( "jumo.dev/v1" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path jumo:apiVersion ] ;
    sh:targetClass jumo:CoordinationProfile .

jumo:DocumentFrontMatter a sh:NodeShape ;
    rdfs:comment "Metadata every governed Markdown document declares, so a retriever can carry a passage's authority and audience along with its text. An ungoverned RAG loses both at chunk time: explanatory prose comes back looking like a rule, and a Realm-private paragraph comes back to whoever asked. Those are the documentary forms of privilege escalation, and this schema is where they are refused (ADR-0014)." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:date ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path jumo:verified_at ],
        [ sh:datatype xsd:string ;
            sh:description "Questions this document answers, in the words a person would use." ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path jumo:answers ;
            sh:pattern "^.{10,}$" ],
        [ sh:description "Widest scope a retrieval may serve this document to. Required with no default, because a default here would silently publish." ;
            sh:in ( "PUBLISHED_SUMMARY" "TYPED_ATTENTION_ONLY" "PROJECT_SCOPED" "REALM_PRIVATE" "ORGANIZATION_ONLY" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 3 ;
            sh:path jumo:audience ],
        [ sh:datatype xsd:string ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path jumo:superseded_by ;
            sh:pattern "^ADR-[0-9]{4}$" ],
        [ sh:datatype xsd:string ;
            sh:defaultValue "en"^^xsd:string ;
            sh:description "ISO 639-1 code of the document's prose. Defaults to English; a non-normative document may declare fr for explanatory text (docs/concepts/positionnement-conceptuel.md)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path jumo:lang ;
            sh:pattern "^[a-z]{2}$" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path jumo:status ;
            sh:pattern "^.{3,}$" ],
        [ sh:datatype xsd:boolean ;
            sh:description "Whether this document states rules. Travels with every chunk: a retriever may quote a false document as explanation and never as authority (ADR-0005 applied to retrieval)." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path jumo:normative ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path jumo:stale_after ;
            sh:pattern "^P(?!$)(\\d+Y)?(\\d+M)?(\\d+D)?(T(?=\\d)(\\d+H)?(\\d+M)?(\\d+S)?)?$" ],
        [ sh:datatype xsd:string ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path jumo:supersedes ;
            sh:pattern "^ADR-[0-9]{4}$" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path jumo:title ;
            sh:pattern "^.{3,}$" ],
        [ sh:datatype xsd:string ;
            sh:description "Comma-separated paths that mechanically enforce this document's rules. Checked for existence by scripts/check-corpus-budget.py." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path jumo:enforced_by ;
            sh:pattern "^.{3,}$" ],
        [ sh:datatype xsd:integer ;
            sh:description "Canonical decision numbers (docs/00-canonical-decisions.md) this ADR backs." ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path jumo:decisions ],
        [ sh:datatype xsd:date ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path jumo:last_updated ],
        [ sh:defaultValue "SEMANTIC_SECTIONS" ;
            sh:in ( "SEMANTIC_SECTIONS" "WHOLE_DOCUMENT" "EXCLUDED" ) ;
            sh:maxCount 1 ;
            sh:order 4 ;
            sh:path jumo:retrieval ] ;
    sh:targetClass jumo:DocumentFrontMatter .

jumo:DocumentTemplate a sh:NodeShape ;
    rdfs:comment "A YAML document with ${placeholder} scalars, rendered into the contract a journey proposes. The body is one string rather than a typed nesting because the shape it renders is the shape of whichever kind the journey emits -- the same reason a step payload with no generated class declares payloadSchemaRef against a raw JSON Schema (projection.yaml). Substitution happens after the body is parsed, so a placeholder standing alone as a value may be filled by a list or a mapping, not only by a scalar." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:in ( "jumo.dev/v1" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path jumo:apiVersion ],
        [ sh:class jumo:Metadata ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path jumo:metadata ],
        [ sh:datatype xsd:string ;
            sh:in ( "DocumentTemplate" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path jumo:kind ],
        [ sh:class jumo:DocumentTemplateBody ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path jumo:spec ] ;
    sh:targetClass jumo:DocumentTemplate .

