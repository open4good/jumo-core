jumo:RoutingDecision a sh:NodeShape ;
    rdfs:comment "Immutable policy-authorized adapter and cell selection for one recognized turn." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
