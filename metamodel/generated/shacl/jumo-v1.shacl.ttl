            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path jumo:renderedAssets ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path jumo:commit ;
            sh:pattern "^[0-9a-f]{40}$" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path jumo:ownerRealm ;
            sh:pattern "^[a-z][a-z0-9-]*$" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path jumo:repository ;
            sh:pattern "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" ],
        [ sh:class jumo:ContractReference ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path jumo:kitReleaseCertificationRef ] ;
    sh:targetClass jumo:KitLockSpec .

jumo:KitModule a sh:NodeShape ;
