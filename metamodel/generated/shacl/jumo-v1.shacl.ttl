        [ sh:in ( "STDIO" "STREAMABLE_HTTP" ) ;
            sh:maxCount 1 ;
            sh:order 6 ;
            sh:path jumo:localProtocol ],
        [ sh:in ( "PAIRED" "ENABLED" "SUSPENDED" "QUARANTINED" "RETIRED" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 2 ;
            sh:path jumo:lifecycle ],
        [ sh:class jumo:ContractReference ;
            sh:description "PersonalSpace documents mounted into this cell's private workspace filesystem. Each referenced PersonalSpace must belong to the same Realm as this cell (Rego, corpus.cell.workspace-realm-scoped) -- private documents never mount into another tenant's dedicated Execution Cell." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path jumo:mountedPersonalSpaceRefs ],
        [ sh:class jumo:ExecutionCellIdentity ;
