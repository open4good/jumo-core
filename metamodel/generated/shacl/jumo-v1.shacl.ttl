            sh:pattern "^.{3,}$" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path jumo:ownerRealm ;
            sh:pattern "^[a-z][a-z0-9-]*$" ],
        [ sh:datatype xsd:string ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path jumo:profiles ;
            sh:pattern "^[a-z][a-z0-9-]*$" ],
        [ sh:datatype xsd:string ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path jumo:teams ;
            sh:pattern "^[a-z][a-z0-9-]*$" ],
        [ sh:datatype xsd:string ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path jumo:roles ;
            sh:pattern "^[a-z][a-z0-9-]*$" ] ;
    sh:targetClass jumo:OrganizationTemplateSpec .

jumo:PersonalSpaceSpec a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path jumo:workspacePath ;
            sh:pattern "^[A-Za-z0-9._/-]+$" ],
        [ sh:datatype xsd:string ;
            sh:description "Principal (user or agent) owning this personal space." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path jumo:ownerPrincipal ;
            sh:pattern "^[a-z][a-z0-9-]*$" ],
        [ sh:class jumo:ContractReference ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path jumo:preferencesRef ],
        [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:minInclusive 1048576 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path jumo:storageQuotaBytes ],
        [ sh:datatype xsd:string ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path jumo:gitLfsPointers ],
        [ sh:datatype xsd:string ;
            sh:description "Realm this personal space belongs to. An ExecutionCell may only mount a PersonalSpace whose ownerRealm matches its own (Rego, corpus.cell.workspace-realm-scoped)." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path jumo:ownerRealm ;
            sh:pattern "^[a-z][a-z0-9-]*$" ] ;
    sh:targetClass jumo:PersonalSpaceSpec .

jumo:PolicyRule a sh:NodeShape ;
    rdfs:comment "Conditional requiredness (ALLOW_WITH_OBLIGATIONS / REQUIRE_APPROVAL require obligations) moves to Rego." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path jumo:id ;
            sh:pattern "^[a-z][a-z0-9-]*$" ],
        [ sh:datatype xsd:string ;
            sh:description "Named structural condition evaluated by the policy engine. Free text is not permitted at evaluation time." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path jumo:when ],
        [ sh:in ( "STEP_UP_AUTHENTICATION" "HUMAN_OWNER_APPROVAL" "INDEPENDENT_VERIFICATION" "DISCLOSE_AGENT_IDENTITY" "RETAIN_PROVENANCE" "REDACT_SECRETS" "PREVIEW_BEFORE_SEND" ) ;
            sh:order 4 ;
            sh:path jumo:obligations ],
        [ sh:datatype xsd:string ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path jumo:actions ;
            sh:pattern "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9]*){1,3}$" ],
        [ sh:in ( "ALLOW" "DENY" "ALLOW_WITH_OBLIGATIONS" "REQUIRE_APPROVAL" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 1 ;
            sh:path jumo:effect ],
        [ sh:datatype xsd:string ;
            sh:description "Sanitized code safe to expose across a Realm boundary (canonical decision 66)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path jumo:reasonCode ] ;
    sh:targetClass jumo:PolicyRule .

jumo:PolicySetSpec a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class jumo:PolicyRule ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path jumo:rules ],
        [ sh:defaultValue "REALM" ;
            sh:description "A lower scope may restrict but never silently expand a higher one (canonical decision 65)." ;
            sh:in ( "PLATFORM" "REALM" "PROJECT" "AGENT" "RUN" ) ;
            sh:maxCount 1 ;
            sh:order 0 ;
            sh:path jumo:scope ] ;
    sh:targetClass jumo:PolicySetSpec .

jumo:PracticeSpec a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class jumo:ContractReference ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path jumo:resourceBudgetRef ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path jumo:purpose ;
            sh:pattern "^.{10,}$" ],
        [ sh:description "How the result reaches the human. Always LIVE is an interruption schedule, not a rhythm." ;
            sh:in ( "LIVE" "DIGEST" "ESCALATION_ONLY" "DELEGATED" "MUTED_UNTIL" "QUIET_HOURS" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 2 ;
            sh:path jumo:delivery ],
        [ sh:class jumo:ContractReference ;
            sh:description "Exact metadata id of the retained TIMER-triggered ProcessSpec release this Practice invokes. A Practice never follows a mutable logical process pointer." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path jumo:processSpecRef ],
        [ sh:in ( "OBSERVE" "DRAFT" "SUPERVISED" "BOUNDED_AUTONOMOUS" ) ;
            sh:maxCount 1 ;
            sh:order 3 ;
            sh:path jumo:autonomy ],
        [ sh:datatype xsd:boolean ;
            sh:defaultValue true ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path jumo:enabled ] ;
    sh:targetClass jumo:PracticeSpec .

jumo:PreferencesSpec a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path jumo:ownerPrincipal ;
            sh:pattern "^[a-z][a-z0-9-]*$" ],
        [ sh:class jumo:NotificationPreferences ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path jumo:notifications ],
        [ sh:datatype xsd:string ;
            sh:defaultValue "default"^^xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path jumo:theme ],
        [ sh:datatype xsd:string ;
            sh:defaultValue "en"^^xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path jumo:language ] ;
    sh:targetClass jumo:PreferencesSpec .

jumo:PrincipalIdentityBindingSpec a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path jumo:oidcSubject ;
            sh:pattern "^.{1,}$" ],
        [ sh:class jumo:ContractReference ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path jumo:principalRef ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path jumo:ownerRealm ;
            sh:pattern "^[a-z][a-z0-9-]*$" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path jumo:issuer ;
            sh:pattern "^https://.+$" ] ;
    sh:targetClass jumo:PrincipalIdentityBindingSpec .

jumo:PrincipalSpec a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path jumo:ownerRealm ;
            sh:pattern "^[a-z][a-z0-9-]*$" ],
        [ sh:description "OWNER and MEMBER may hold a PersonalSpace and bear RoleDefinitions; a CONTACT is modeled by someone else's Realm and has neither." ;
            sh:in ( "OWNER" "MEMBER" "CONTACT" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 1 ;
            sh:path jumo:principalKind ],
        [ sh:description "NOT_APPLICABLE for OWNER and MEMBER, who consented by joining the Realm. For a CONTACT, the Realm's own record of whether that person agreed to being modeled -- never proof of consent, only a claim the Realm makes." ;
            sh:in ( "NOT_APPLICABLE" "UNKNOWN" "REQUESTED" "GRANTED" "DECLINED" "WITHDRAWN" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 4 ;
            sh:path jumo:consentState ],
        [ sh:class jumo:ContractReference ;
            sh:description "Present only for OWNER and MEMBER. A CONTACT has no login or workspace here." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path jumo:personalSpaceRef ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path jumo:displayName ;
            sh:pattern "^.{1,}$" ] ;
    sh:targetClass jumo:PrincipalSpec .

jumo:Principle a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path jumo:id ;
            sh:pattern "^[a-z][a-z0-9-]*$" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path jumo:statement ;
            sh:pattern "^.{10,}$" ],
        [ sh:datatype xsd:string ;
            sh:description "A principle may inspire a policy, but the policy must be explicit and reviewable (canonical decision 16). Documentation link, not an authorization path." ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path jumo:inspiresPolicies ;
            sh:pattern "^[a-z][a-z0-9-]*$" ] ;
    sh:targetClass jumo:Principle .

jumo:PrincipleSetSpec a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class jumo:Principle ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path jumo:principles ],
        [ sh:datatype xsd:string ;
            sh:description "Structurally enforced. A PrincipleSet cannot declare any other authority." ;
            sh:in ( "INFLUENCE_ONLY" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path jumo:authority ] ;
    sh:targetClass jumo:PrincipleSetSpec .

jumo:ProcessDurability a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:in ( "AUDIT_ALIGNED" "SHORT" "MINIMAL" ) ;
            sh:maxCount 1 ;
            sh:order 1 ;
            sh:path jumo:historyRetention ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path jumo:expectedMaximum ;
            sh:pattern "^P(?!$)(\\d+Y)?(\\d+M)?(\\d+D)?(T(?=\\d)(\\d+H)?(\\d+M)?(\\d+S)?)?$" ] ;
    sh:targetClass jumo:ProcessDurability .

jumo:ProcessFlow a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "A ProcessStep id in this same ProcessSpec." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path jumo:to ;
            sh:pattern "^[a-z][a-z0-9-]*$" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path jumo:id ;
            sh:pattern "^[a-z][a-z0-9-]*$" ],
        [ sh:datatype xsd:string ;
            sh:description "Required when `from` names a GATEWAY step with more than one outgoing flow (Rego)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path jumo:branchLabel ],
        [ sh:datatype xsd:string ;
            sh:description "A ProcessStep id in this same ProcessSpec." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path jumo:from ;
            sh:pattern "^[a-z][a-z0-9-]*$" ],
        [ sh:datatype xsd:string ;
            sh:description "A generated LinkML class name; every edge carries an explicit typed payload." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path jumo:payloadType ] ;
    sh:targetClass jumo:ProcessFlow .

jumo:ProcessSpecBody a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path jumo:processVersion ;
            sh:pattern "^\\d+\\.\\d+\\.\\d+$" ],
        [ sh:datatype xsd:string ;
            sh:description "Required only for TIMER starts; ISO-8601 duration rather than cron." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path jumo:timerDelay ;
            sh:pattern "^P(?!$)(\\d+Y)?(\\d+M)?(\\d+D)?(T(?=\\d)(\\d+H)?(\\d+M)?(\\d+S)?)?$" ],
        [ sh:class jumo:ProcessDurability ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 10 ;
            sh:path jumo:durability ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path jumo:ownerRealm ;
            sh:pattern "^[a-z][a-z0-9-]*$" ],
        [ sh:in ( "MANUAL" "TIMER" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 6 ;
            sh:path jumo:startTrigger ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path jumo:outputType ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path jumo:processId ;
            sh:pattern "^[a-z][a-z0-9-]*$" ],
        [ sh:class jumo:ProcessStageWorkerRequirement ;
            sh:description "Task requirements per model-using step (source schema's open string-keyed map, modeled as key/value pairs -- see ThemePack for the same pattern). Every key must name a declared step and every value resolves to a WorkerRequirementProfile (Rego)." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 11 ;
            sh:path jumo:stageWorkerRequirementRef ],
        [ sh:class jumo:ProcessStep ;
            sh:description "Must include exactly one START and at least one END (Rego)." ;
            sh:minCount 2 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path jumo:steps ],
        [ sh:class jumo:ContractReference ;
            sh:description "ResourceBudget governing this process." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 12 ;
            sh:path jumo:resourceBudgetRef ],
        [ sh:class jumo:ContractReference ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path jumo:projectRef ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path jumo:inputType ],
        [ sh:class jumo:ProcessFlow ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 9 ;
            sh:path jumo:flows ] ;
    sh:targetClass jumo:ProcessSpecBody .

jumo:ProcessStageWorkerRequirement a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path jumo:stepId ;
            sh:pattern "^[a-z][a-z0-9-]*$" ],
        [ sh:class jumo:ContractReference ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path jumo:workerRequirementProfileRef ] ;
    sh:targetClass jumo:ProcessStageWorkerRequirement .

jumo:ProcessStep a sh:NodeShape ;
    rdfs:comment "One node in the process graph. inputType/outputType/capabilityRef/opaEntrypoint are used selectively by kind: a GATEWAY step names opaEntrypoint (the OPA decision that selects its outgoing flow); a SERVICE step names capabilityRef and inputType/outputType; a TIMER START step carries the schedule fields Practice.processSpecRef (work.yaml) points at. Which fields apply to which kind is a Rego invariant, not encoded structurally here -- LinkML has no tagged-union/discriminated-class construct clean enough to justify one ProcessStep subclass per kind for what is otherwise one shape." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Required on a SERVICE step (Rego); must resolve in an ActionCapabilitySet." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path jumo:capabilityRef ;
            sh:pattern "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9]*){1,3}$" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path jumo:id ;
            sh:pattern "^[a-z][a-z0-9-]*$" ],
        [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:maxInclusive 100 ;
            sh:minInclusive 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path jumo:loopMaximum ],
        [ sh:datatype xsd:string ;
            sh:description "Required on USER and MESSAGE signals; resolves to a generated LinkML class." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path jumo:signalType ],
        [ sh:in ( "START" "END" "SERVICE" "USER" "TIMER" "MESSAGE" "GATEWAY" "SUBPROCESS" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 1 ;
            sh:path jumo:kind ],
        [ sh:description "Must not exceed the ringCeiling of capabilityRef's ActionCapability (Rego)." ;
            sh:in ( "RING_0_ROOT_OF_TRUST" "RING_1_CONTROL_PLANE" "RING_2_AGENT_BEHAVIOR" "RING_3_GOVERNED_PROJECT" ) ;
            sh:maxCount 1 ;
            sh:order 4 ;
            sh:path jumo:ring ],
        [ sh:in ( "EXCLUSIVE" "PARALLEL" ) ;
            sh:maxCount 1 ;
            sh:order 9 ;
            sh:path jumo:gatewayMode ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path jumo:fallbackFlowRef ;
            sh:pattern "^[a-z][a-z0-9-]*$" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 15 ;
            sh:path jumo:compensationForStepRef ;
            sh:pattern "^[a-z][a-z0-9-]*$" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path jumo:subprocessReleaseRef ;
            sh:pattern "^[a-z][a-z0-9-]*$" ],
        [ sh:in ( "SPLIT" "JOIN" ) ;
            sh:maxCount 1 ;
            sh:order 10 ;
            sh:path jumo:gatewayRole ],
        [ sh:datatype xsd:string ;
            sh:description "Required on a GATEWAY step (Rego): the Rego rule the ProcessSpec compiler wires as the decision selecting this gateway's outgoing branch." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path jumo:opaEntrypoint ;
            sh:pattern "^[a-z][a-z0-9_.]*$" ],
        [ sh:datatype xsd:string ;
            sh:description "Required on a SERVICE step whose capability producesExternalEffect (Rego)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path jumo:idempotencyKey ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path jumo:pairedGatewayRef ;
            sh:pattern "^[a-z][a-z0-9-]*$" ],
        [ sh:description "Required on END and forbidden elsewhere." ;
            sh:in ( "COMPLETED" "DECLINED" "CANCELLED" "FAILED_FINAL" "SUPERSEDED" ) ;
            sh:maxCount 1 ;
            sh:order 7 ;
            sh:path jumo:terminalState ],
        [ sh:description "The WorkflowDeclaration-era stage this step corresponds to, where applicable." ;
            sh:in ( "CAPTURE_LINKED" "NORMALIZE_CAPTURE" "INTENT_RECOGNITION" "SUFFICIENCY_ASSESSMENT" "SCOPE_RESOLUTION" "DECOMPOSITION" "WORK_DISPOSITION" "ACKNOWLEDGEMENT" "ADMISSION" "CLARIFICATION" "POLICY_EVALUATION" "CAPABILITY_ACQUISITION" "PLANNING" "EXECUTION" "EFFECT_APPLICATION" "OBSERVATION" "VERIFICATION" "STATUS_WINDOW_RESOLUTION" "STATUS_FACT_EXTRACTION" "STATUS_NARRATION" "STATUS_DELIVERY" "STATUS_CURSOR_ADVANCE" "OUTCOME_MEASUREMENT" "OUTCOME_ASSESSMENT" "IMPROVEMENT_SYNTHESIS" "COMPLETION" ) ;
            sh:maxCount 1 ;
            sh:order 2 ;
            sh:path jumo:semanticStage ] ;
    sh:targetClass jumo:ProcessStep .

jumo:ProcessingRegisterEntry a sh:NodeShape ;
    rdfs:comment "RGPD art. 30 register entry." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path jumo:purpose ;
            sh:pattern "^.{5,}$" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path jumo:retention ;
            sh:pattern "^P(?!$)(\\d+Y)?(\\d+M)?(\\d+D)?(T(?=\\d)(\\d+H)?(\\d+M)?(\\d+S)?)?$" ],
        [ sh:class jumo:ContractReference ;
            sh:description "References an EvidenceProfile carrying the DPIA (art. 35), when required." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path jumo:dpiaEvidenceProfileRef ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path jumo:activity ;
            sh:pattern "^.{5,}$" ],
        [ sh:datatype xsd:string ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path jumo:dataCategories ] ;
    sh:targetClass jumo:ProcessingRegisterEntry .

jumo:ProjectCompatibility a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path jumo:minimumJumoVersion ;
            sh:pattern "^\\d+\\.\\d+\\.\\d+" ] ;
    sh:targetClass jumo:ProjectCompatibility .

jumo:ProjectDocumentation a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Folded in from the retired ProjectContract kind (owner decision O3, 2026-08-22)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path jumo:canonicalDecisions ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path jumo:handoff ],
        [ sh:class jumo:DocumentationRoot ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path jumo:roots ] ;
    sh:targetClass jumo:ProjectDocumentation .

jumo:ProjectPersonalSpaceBinding a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class jumo:ContractReference ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path jumo:personalSpaceRef ] ;
    sh:targetClass jumo:ProjectPersonalSpaceBinding .

jumo:ProjectRuntime a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:in ( "temporal" "none" ) ;
            sh:maxCount 1 ;
            sh:order 0 ;
            sh:path jumo:durableWorkflowEngine ] ;
    sh:targetClass jumo:ProjectRuntime .

jumo:ProjectSpec a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:in ( "docker-compose" "systemd" "kubernetes" "none" ) ;
            sh:maxCount 1 ;
            sh:order 10 ;
            sh:path jumo:deployment ],
        [ sh:datatype xsd:string ;
            sh:description "A Project has exactly one canonical owner Realm (ADR-0004)." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path jumo:ownerRealm ;
            sh:pattern "^[a-z][a-z0-9-]*$" ],
        [ sh:in ( "PRIVATE" "PRIVATE_UNTIL_LICENSED" "CLIENT_SCOPED" "PUBLIC" ) ;
            sh:maxCount 1 ;
            sh:order 3 ;
            sh:path jumo:visibility ],
        [ sh:class jumo:ProjectStateAuthority ;
            sh:description "No component may treat its local representation as authority for another category (ADR-0002)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 12 ;
            sh:path jumo:authority ],
        [ sh:class jumo:ProjectRuntime ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 11 ;
            sh:path jumo:runtime ],
        [ sh:datatype xsd:string ;
            sh:in ( ".jumo" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path jumo:contractDirectory ],
        [ sh:in ( "IDEATION" "BOOTSTRAP" "ACTIVE" "MAINTENANCE" "ARCHIVED" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 2 ;
            sh:path jumo:lifecycle ],
        [ sh:class jumo:ProjectDocumentation ;
            sh:description "Where this Project's governed Markdown lives and who may retrieve it. Jumo indexes declared roots and nothing else (ADR-0014)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path jumo:documentation ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path jumo:primaryLanguage ],
        [ sh:class jumo:Milestone ;
            sh:description "Declared in delivery order. Groups the generated roadmap and bounds every WorkOrder's roadmapRef (Rego corpus.work.roadmap-ref-declared)." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 13 ;
            sh:path jumo:milestones ],
        [ sh:class jumo:ProjectPersonalSpaceBinding ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path jumo:personalSpaces ],
        [ sh:class jumo:RepositoryBinding ;
            sh:description "Zero or more Git resources governed by this Project. A repository-free Project remains valid." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path jumo:repositoryBindings ],
        [ sh:datatype xsd:string ;
            sh:description "Folded in from the retired ProjectContract kind (owner decision O3, 2026-08-22)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path jumo:purpose ;
            sh:pattern "^.{10,}$" ],
        [ sh:class jumo:ProjectCompatibility ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path jumo:compatibility ] ;
    sh:targetClass jumo:ProjectSpec .

jumo:ProjectStateAuthority a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:in ( "git" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path jumo:desiredState ],
        [ sh:in ( "temporal" "none" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 2 ;
            sh:path jumo:executionState ],
        [ sh:in ( "postgresql" "none" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 1 ;
            sh:path jumo:businessState ] ;
    sh:targetClass jumo:ProjectStateAuthority .

jumo:ProjectionField a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class jumo:ProjectionOptionCondition ;
            sh:description "Conditions every instance of `optionsFrom` must satisfy to be offered. The eligibility a selection applies is part of what the contract says the field means, so it is declared here rather than left to whichever surface happens to render the field. Conditions read the candidate's Git document only -- desired and contractual state; recognized runtime state (a machine's observed health) is a different authority and is not reachable from a projection." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path jumo:optionsEligibility ],
        [ sh:datatype xsd:string ;
            sh:description "A contract kind whose declared instances populate this field's options, replacing a hardcoded roster lookup with a projection over real Git contracts. Must name a declared kind (Rego). An instance is offered as its `metadata.id` labelled by its `metadata.name`; a projection selects which instances are offered, never how one is addressed. Mutually exclusive with optionsFromEnum (Rego)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path jumo:optionsFrom ],
        [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:maxInclusive 12 ;
            sh:minInclusive 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path jumo:span ],
        [ sh:datatype xsd:string ;
            sh:description "A generated LinkML enumeration whose permissible values populate this field's options, for a field whose domain is a closed vocabulary rather than a contract kind. Mutually exclusive with optionsFrom (Rego). Rego checks that an ENUMERATION field declares one of the two, not that this names an enumeration rather than a class: the repository facts carry per-class slots, not permissible values, so the narrower check waits on a fact this module does not produce." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path jumo:optionsFromEnum ],
        [ sh:datatype xsd:string ;
            sh:description "A slot of the ProjectionSpecBody.of class this field projects (Rego)." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path jumo:path ],
        [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path jumo:order ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path jumo:helpI18nKey ;
            sh:pattern "^[a-z][a-zA-Z0-9]*$" ],
        [ sh:in ( "SHORT_TEXT" "MULTILINE_TEXT" "IDENTIFIER" "ENUMERATION" "ENTITY_REFERENCE" "ENTITY_COLLECTION" "BOOLEAN_FLAG" "QUANTITY" "DURATION" "TIMESTAMP" "SECRET" "PATH_GLOB" "CAPABILITY_NAME" "MARKDOWN" "STRUCTURED_YAML" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 1 ;
            sh:path jumo:representation ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path jumo:i18nKey ;
            sh:pattern "^[a-z][a-zA-Z0-9]*$" ],
        [ sh:datatype xsd:boolean ;
            sh:description "When an AssistedJourneyStep declares both projectionRef and requiredFields (work.yaml), requiredFields must name exactly the fields marked required here (Rego) -- the two lists describe the same gate and must not be allowed to drift." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path jumo:required ] ;
    sh:targetClass jumo:ProjectionField .

jumo:ProjectionOptionCondition a sh:NodeShape ;
    rdfs:comment "One condition a candidate instance must satisfy to be offered as a field's option." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "A dotted path into the candidate contract document, e.g. `spec.desiredState`." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path jumo:path ],
        [ sh:datatype xsd:boolean ;
            sh:description "The value at `path` must be present and non-empty. Exactly one of equalsValue and present is required (Rego)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path jumo:present ],
        [ sh:datatype xsd:string ;
            sh:description "The value at `path` must equal this string. Exactly one of equalsValue and present is required (Rego)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path jumo:equalsValue ] ;
    sh:targetClass jumo:ProjectionOptionCondition .

jumo:ProjectionSection a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class jumo:ProjectionField ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path jumo:fields ],
        [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:maxInclusive 12 ;
            sh:minInclusive 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path jumo:columns ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path jumo:i18nKey ;
            sh:pattern "^[a-z][a-zA-Z0-9]*$" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path jumo:id ;
            sh:pattern "^[a-z][a-z0-9-]*$" ] ;
    sh:targetClass jumo:ProjectionSection .

jumo:ProjectionSpecBody a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class jumo:ProjectionSection ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path jumo:sections ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path jumo:ownerRealm ;
            sh:pattern "^[a-z][a-z0-9-]*$" ],
        [ sh:in ( "FORM" "DETAIL" "COLLECTION" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 3 ;
            sh:path jumo:projectionKind ],
        [ sh:datatype xsd:string ;
            sh:description "A generated LinkML class name (metamodel/generated/manifest.json), the same pattern ProcessFlow.payloadType and ProcessStep.signalType use. Must name a declared class (Rego). Mutually exclusive with payloadSchemaRef; exactly one of the two is required (Rego) -- a payload either has a generated class or it does not, never both." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path jumo:of ],
        [ sh:datatype xsd:string ;
            sh:description "Every named action must resolve against a declared ActionCapability (Rego, same check as every other capability reference in this metamodel) and must also be among `renderedBy`'s surface's `proposes` list (Rego) -- a projection can never claim an action its rendering surface does not offer." ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path jumo:actions ;
            sh:pattern "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9]*){1,3}$" ],
        [ sh:datatype xsd:string ;
            sh:description "The id of an InterfaceSurface `Surface` this projection is scoped to. Required and checked against every declared surface (Rego), rather than optional, so a projection nobody lists is never silently unconstrained -- the same fail-closed shape as every other reference in this metamodel." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path jumo:renderedBy ;
            sh:pattern "^[a-z][a-z0-9-]*$" ],
        [ sh:datatype xsd:string ;
            sh:description "A JSON Schema 2020-12 document declared under a corpus schemas directory (e.g. jumo-core:.jumo/schemas), for a step payload with no generated LinkML class of its own -- the metamodel names no such instance-specific class (canonical decision 15). Must resolve to a declared schema file (Rego). Mutually exclusive with of." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path jumo:payloadSchemaRef ] ;
    sh:targetClass jumo:ProjectionSpecBody .

jumo:PromptBody a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path jumo:system ],
        [ sh:datatype xsd:string ;
            sh:description "Optional path to the body, for prompts too long to inline." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path jumo:path ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path jumo:user ;
            sh:pattern "^.{1,}$" ],
        [ sh:in ( "thymeleaf" "literal" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 0 ;
            sh:path jumo:engine ] ;
    sh:targetClass jumo:PromptBody .

jumo:PromptOutput a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path jumo:schemaRef ],
        [ sh:datatype xsd:string ;
            sh:description "Fully qualified target type for STRUCTURED output." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path jumo:javaType ],
        [ sh:in ( "STRUCTURED" "TEXT" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 0 ;
            sh:path jumo:form ] ;
    sh:targetClass jumo:PromptOutput .

jumo:PromptTemplateSpec a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class jumo:ContractReference ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path jumo:workerRequirementProfileRef ],
        [ sh:class jumo:PromptBody ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path jumo:template ],
        [ sh:class jumo:ContractReference ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path jumo:resourceBudgetRef ],
        [ sh:in ( "RING_0_ROOT_OF_TRUST" "RING_1_CONTROL_PLANE" "RING_2_AGENT_BEHAVIOR" "RING_3_GOVERNED_PROJECT" ) ;
            sh:maxCount 1 ;
            sh:order 9 ;
            sh:path jumo:ring ],
        [ sh:class jumo:ContractReference ;
            sh:description "The owning AgentDefinition." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path jumo:agentDefinitionRef ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path jumo:purpose ;
            sh:pattern "^.{10,}$" ],
        [ sh:class jumo:PromptOutput ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path jumo:output ],
        [ sh:in ( "NONE" "SELF_REPORTED" "OBSERVED" "INDEPENDENTLY_VERIFIED" ) ;
            sh:maxCount 1 ;
            sh:order 8 ;
            sh:path jumo:minimumAssurance ],
        [ sh:datatype xsd:string ;
            sh:description "Enforced as a subset of the owning AgentDefinition's requestedCapabilities (Rego). Proposing is still not granting: policy decides." ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path jumo:mayProposeCapabilities ;
            sh:pattern "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9]*){1,3}$" ],
        [ sh:class jumo:PromptVariable ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path jumo:variables ],
        [ sh:description "The ConversationService task this prompt serves. Optional -- most PromptTemplate documents are referenced by a journey step, not by a conversation task, and leave this unset." ;
            sh:in ( "COORDINATE" "DELIBERATE" "COMPACT" "STRUCTURED_INTENT" ) ;
            sh:maxCount 1 ;
            sh:order 10 ;
            sh:path jumo:conversationTask ] ;
    sh:targetClass jumo:PromptTemplateSpec .

jumo:PromptVariable a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path jumo:name ;
            sh:pattern "^[a-z][a-zA-Z0-9_]*$" ],
        [ sh:in ( "TRUSTED" "UNTRUSTED" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 2 ;
            sh:path jumo:trust ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path jumo:description ],
        [ sh:datatype xsd:boolean ;
            sh:defaultValue true ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path jumo:required ] ;
    sh:targetClass jumo:PromptVariable .

jumo:ProviderAccountSpec a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class jumo:ProviderRouting ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path jumo:routing ],
        [ sh:datatype xsd:string ;
            sh:description "Vendor and access path, such as anthropic-cli or openai-api. Two accounts on the same vendor are not independent of each other." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path jumo:provider ;
            sh:pattern "^.{2,}$" ],
        [ sh:in ( "DIRECT_PROVIDER_API" "STRUCTURED_CLI_OUTPUT" "RESPONSE_HEADER" "OBSERVED_ERROR" "PARSED_HUMAN_OUTPUT" "MANUAL_DECLARATION" "ESTIMATE" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 4 ;
            sh:path jumo:observationProvenance ],
        [ sh:class jumo:ProviderQuotaWindow ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path jumo:quotaWindow ],
        [ sh:in ( "WAIT_FOR_RECOVERY" "USE_AUTHORIZED_ALTERNATIVE" "REQUEST_HUMAN_DECISION" "STOP_CLEANLY" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 5 ;
            sh:path jumo:onExhaustion ],
        [ sh:class jumo:ContractReference ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path jumo:alternativeProviderAccountRefs ],
        [ sh:class jumo:ProviderEntitlement ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path jumo:entitlement ],
        [ sh:datatype xsd:string ;
            sh:description "Accounts sharing a group are not independent. Falling back within the same group would let one account both produce and verify (docs/concepts/positionnement-conceptuel.md#diversite-des-pannes) -- a declared separation, not a proof of independence; a fault-diversity vector (provider, model, prompt, sources, tools, framing) would be the finer-grained signal, not yet modeled as its own field. Inherited from the referenced ProviderPlatform's independenceGroup when absent." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path jumo:independenceGroup ;
            sh:pattern "^[a-z][a-z0-9-]*$" ],
        [ sh:class jumo:ContractReference ;
            sh:description "The sole OpenBao binding that may hold this named account's credential; the value is never contractual state." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path jumo:secretBindingRef ] ;
    sh:targetClass jumo:ProviderAccountSpec .

jumo:ProviderEntitlement a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class jumo:EntitlementUsePermissions ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path jumo:usePermissions ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path jumo:holderRef ;
            sh:pattern "^.{2,}$" ],
        [ sh:in ( "PRINCIPAL" "ORGANIZATION" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 0 ;
            sh:path jumo:holder ] ;
    sh:targetClass jumo:ProviderEntitlement .

jumo:ProviderNativeEffort a sh:NodeShape ;
    rdfs:comment "Provider-native reasoning-effort parameters, applied verbatim by RequestShape for the rung's protocol -- OpenAI reasoning_effort, Anthropic thinking budget and max_tokens, Google thinkingConfig." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:minInclusive 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path jumo:maxOutputTokens ],
        [ sh:datatype xsd:string ;
            sh:description "Provider-native effort token passed through verbatim (e.g. OpenAI's 'medium' or 'high')." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path jumo:reasoningEffort ],
        [ sh:datatype xsd:integer ;
            sh:description "Native thinking-token budget for a protocol that exposes one (Anthropic extended thinking, Google thinkingConfig)." ;
            sh:maxCount 1 ;
            sh:minInclusive 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path jumo:thinkingBudgetTokens ] ;
    sh:targetClass jumo:ProviderNativeEffort .

jumo:ProviderPlatformSpec a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path jumo:completionPath ],
        [ sh:in ( "AUTHORIZATION_BEARER" "X_API_KEY" "X_GOOG_API_KEY" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 5 ;
            sh:path jumo:credentialHeader ],
        [ sh:class jumo:EffortRungSpec ;
            sh:description "The rung-by-rung ladder every account opened against this platform inherits unless it declares its own ProviderRouting.effortLadder." ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path jumo:defaultEffortLadder ],
        [ sh:datatype xsd:string ;
            sh:description "Fixed TLS upstream for an integrated platform. Forbidden when hostDeclaredByAccount is true (Rego); a generic platform's host is named per-account instead." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path jumo:upstreamHost ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path jumo:modelCatalogPath ],
        [ sh:datatype xsd:string ;
            sh:description "Default independenceGroup for an account opened against this platform when the account does not declare its own." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path jumo:independenceGroup ;
            sh:pattern "^[a-z][a-z0-9-]*$" ],
        [ sh:datatype xsd:boolean ;
            sh:description "True only for a generic platform (e.g. an OpenAI-compatible aggregator such as OpenRouter) whose upstream host is named per-account instead of fixed by this catalog entry." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path jumo:hostDeclaredByAccount ],
        [ sh:datatype xsd:string ;
            sh:description "Names the generated provider-egress nginx location this platform's traffic proxies through. Never a raw URL; the worker builds only /{egressRouteId}/... and cannot select an upstream itself." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path jumo:egressRouteId ;
            sh:pattern "^[a-z][a-z0-9-]*$",
                "^[a-z][a-z0-9-]{0,30}$" ],
        [ sh:in ( "ANTHROPIC_MESSAGES" "OPENAI_RESPONSES" "GOOGLE_GENAI" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 0 ;
            sh:path jumo:wireProtocol ] ;
    sh:targetClass jumo:ProviderPlatformSpec .

jumo:ProviderQuotaWindow a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:in ( "ROLLING" "CALENDAR" "METERED" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 0 ;
            sh:path jumo:kind ],
        [ sh:datatype xsd:string ;
            sh:description "Required when kind is ROLLING or CALENDAR; forbidden when METERED (Rego)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path jumo:duration ;
            sh:pattern "^P(?!$)(\\d+Y)?(\\d+M)?(\\d+D)?(T(?=\\d)(\\d+H)?(\\d+M)?(\\d+S)?)?$" ] ;
    sh:targetClass jumo:ProviderQuotaWindow .

jumo:ProviderRouting a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:in ( "PLAN_DIRECT" "GATEWAY_ROUTED" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 1 ;
            sh:path jumo:mode ],
        [ sh:class jumo:ContractReference ;
            sh:description "The ProviderPlatform catalog entry this account was opened against. Required when mode is GATEWAY_ROUTED; forbidden when PLAN_DIRECT, which has no upstream provider-egress traffic (Rego)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path jumo:platformRef ],
        [ sh:datatype xsd:integer ;
            sh:description "Deterministic account selection order for a compatible worker requirement profile. Lower values are selected first." ;
            sh:maxCount 1 ;
            sh:minInclusive 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path jumo:priority ],
        [ sh:datatype xsd:string ;
            sh:description "Required exactly when the referenced ProviderPlatform declares hostDeclaredByAccount true (a generic platform such as an OpenAI-compatible aggregator); forbidden otherwise (Rego)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path jumo:upstreamHost ],
        [ sh:datatype xsd:string ;
            sh:description "Required when mode is GATEWAY_ROUTED; forbidden when PLAN_DIRECT (Rego)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path jumo:gatewayRef ;
            sh:pattern "^[a-z][a-z0-9.-]{2,}$" ],
        [ sh:class jumo:EffortRungSpec ;
            sh:description "Overrides the platform's defaultEffortLadder rung for rung when declared. Absent by default, so a newly declared account inherits the platform's ladder and is routable immediately -- the fix for the N-times-M dead account problem a per-account requirementAliases list produced." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path jumo:effortLadder ] ;
    sh:targetClass jumo:ProviderRouting .

jumo:QuietHoursWindow a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path jumo:end ;
            sh:pattern "^([01][0-9]|2[0-3]):[0-5][0-9]$" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path jumo:start ;
            sh:pattern "^([01][0-9]|2[0-3]):[0-5][0-9]$" ] ;
    sh:targetClass jumo:QuietHoursWindow .

jumo:RealmChiefOfStaffRef a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class jumo:ContractReference ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path jumo:chiefOfStaffProfileRef ],
        [ sh:class jumo:ContractReference ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path jumo:roleDefinitionRef ] ;
    sh:targetClass jumo:RealmChiefOfStaffRef .

jumo:RealmEnforcement a sh:NodeShape ;
    rdfs:comment "ENFORCED requiring observedAt/evidenceRef/evidenceMaxAge moves to Rego: claiming enforcement costs an observation and a reference to it." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Maximum age of the Forge protection observation before an autonomy gate must treat the claim as stale (ADR-0028, default PT24H)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path jumo:evidenceMaxAge ;
            sh:pattern "^P(?!$)(\\d+Y)?(\\d+M)?(\\d+D)?(T(?=\\d)(\\d+H)?(\\d+M)?(\\d+S)?)?$" ],
        [ sh:in ( "ADVISORY" "ENFORCED" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 0 ;
            sh:path jumo:branchProtection ],
        [ sh:datatype xsd:string ;
            sh:description "Maximum age of the independent-verification observation before its ENFORCED claim must be treated as stale, default PT24H." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path jumo:independentVerificationEvidenceMaxAge ;
            sh:pattern "^P(?!$)(\\d+Y)?(\\d+M)?(\\d+D)?(T(?=\\d)(\\d+H)?(\\d+M)?(\\d+S)?)?$" ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path jumo:independentVerificationObservedAt ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path jumo:independentVerificationEvidenceRef ;
            sh:pattern "^.{1,}$" ],
        [ sh:description "Optional, additive claim distinct from branchProtection. Not wired into whether the corpus.independence.* rules apply -- those keep running unconditionally regardless of this field. Only claiming ENFORCED here has any effect: it must then carry its own fresh independentVerificationObservedAt/independentVerificationEvidenceRef within independentVerificationEvidenceMaxAge (Rego), same evidence-costs-a-claim shape as branchProtection." ;
            sh:in ( "ADVISORY" "ENFORCED" ) ;
            sh:maxCount 1 ;
            sh:order 4 ;
            sh:path jumo:independentVerification ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path jumo:observedAt ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path jumo:evidenceRef ;
            sh:pattern "^.{1,}$" ] ;
    sh:targetClass jumo:RealmEnforcement .

jumo:RealmIngressBinding a sh:NodeShape ;
    rdfs:comment "Per-tenant DNS routing for one RealmTemplate. `baseDomain` is deliberately not named `canonicalDomain` or `hostname`: OfferingTopology.canonicalDomain and OfferingTopology.hostname (this same module) already use both names for an inclusion flag, not a domain value -- a third reuse of either name for a different shape would recreate the exact collision the `ProjectionSource`/`ProjectionSpec` naming warns against elsewhere in this metamodel. Deliberately carries no audience, policy, capability or other authority-bearing attribute: Rego refusing two RealmTemplates the same hostname protects routing correctness, not authorization -- that stays on RealmEnforcement." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "The parent domain subdomain is bound under, e.g. jumo.dev or a client-owned domain." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path jumo:baseDomain ;
            sh:pattern "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)+$" ],
        [ sh:datatype xsd:string ;
            sh:description "DNS label distinguishing this Realm's hostname under baseDomain." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path jumo:subdomain ;
            sh:pattern "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$" ] ;
    sh:targetClass jumo:RealmIngressBinding .

jumo:RealmPublicationSpec a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path jumo:artifactAllowlist ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path jumo:ownerRealm ;
            sh:pattern "^[a-z][a-z0-9-]*$" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path jumo:publicHandle ;
            sh:pattern "^[a-z0-9-_]{2,64}$" ],
        [ sh:in ( "jumo-profile-v1" "bpmn-2.0-v1" "a2a-v1-read-v1" "acs-jumo-opa-v1" ) ;
            sh:minCount 1 ;
            sh:order 4 ;
            sh:path jumo:enabledAdapters ],
        [ sh:class jumo:ContractReference ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path jumo:organizationRef ],
        [ sh:in ( "PRIVATE_STEALTH" "CLUSTER_SHARED" "PUBLIC_DISCOVERABLE" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 3 ;
            sh:path jumo:exposure ] ;
    sh:targetClass jumo:RealmPublicationSpec .

jumo:RealmTemplateSpec a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class jumo:RealmEnforcement ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path jumo:enforcement ],
        [ sh:datatype xsd:string ;
            sh:description "The canonical owner Principal. A literal TODO is rejected (Rego)." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path jumo:owner ;
            sh:pattern "^.{2,}$" ],
        [ sh:datatype xsd:string ;
            sh:description "Target git repository URL or forge path for this Realm." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path jumo:contractRepository ],
        [ sh:class jumo:ContractReference ;
            sh:description "Relative paths to PolicySet documents. Resolved and existence-checked (Rego)." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path jumo:policySetRefs ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path jumo:timezone ;
            sh:pattern "^.{3,}$" ],
        [ sh:class jumo:RealmIngressBinding ;
            sh:description "Optional per-tenant subdomain routing. Absent for a Realm with no hosted hostname of its own, the same \"field-free stays valid\" shape as Project.repositoryBindings." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path jumo:ingress ],
        [ sh:class jumo:ContractReference ;
            sh:description "Ordered list of kit bindings determining precedence." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 10 ;
            sh:path jumo:kitBindingRefs ],
        [ sh:defaultValue "PRIVATE_STEALTH" ;
            sh:description "Realm exposure posture. Defaults to PRIVATE_STEALTH (fail-closed, invisible by default)." ;
            sh:in ( "PRIVATE_STEALTH" "CLUSTER_SHARED" "PUBLIC_DISCOVERABLE" ) ;
            sh:maxCount 1 ;
            sh:order 1 ;
            sh:path jumo:exposure ],
        [ sh:class jumo:RealmChiefOfStaffRef ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path jumo:chiefOfStaff ],
        [ sh:class jumo:ContractReference ;
            sh:description "Relative paths to PrincipleSet documents. Influence only." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path jumo:principleSetRefs ],
        [ sh:in ( "PERSONAL" "PROFESSIONAL" "MOBILITY" "HOUSEHOLD" "CLIENT" ) ;
            sh:order 2 ;
            sh:path jumo:spheres ] ;
    sh:targetClass jumo:RealmTemplateSpec .

jumo:RemoteMcpAppraisalSpec a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path jumo:validUntil ],
        [ sh:class jumo:ContractReference ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path jumo:remoteMcpServiceRef ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path jumo:observedAt ],
        [ sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path jumo:evidenceRefs ;
            sh:pattern "^.{3,}$" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path jumo:ownerRealm ;
            sh:pattern "^[a-z][a-z0-9-]*$" ],
        [ sh:in ( "ACCEPTED" "REFUSED" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 2 ;
            sh:path jumo:verdict ],
        [ sh:class jumo:ContractReference ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path jumo:verifiedByRoleDefinitionRef ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path jumo:inventoryDigest ;
            sh:pattern "^sha256:[0-9a-f]{64}$" ],
        [ sh:datatype xsd:string ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path jumo:semanticTools ;
            sh:pattern "^[a-z][a-z0-9-]*$" ] ;
    sh:targetClass jumo:RemoteMcpAppraisalSpec .

jumo:RemoteMcpServiceSpec a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class jumo:ContractReference ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path jumo:oauthSecretBindingRef ],
        [ sh:datatype xsd:string ;
            sh:in ( "MCP_STREAMABLE_HTTP" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path jumo:transport ],
        [ sh:class jumo:ContractReference ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path jumo:remoteMcpAppraisalRef ],
        [ sh:in ( "DECLARED" "ENABLED" "SUSPENDED" "RETIRED" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 1 ;
            sh:path jumo:lifecycle ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path jumo:endpointConfigurationRef ;
            sh:pattern "^[a-z][a-z0-9.-]{2,}$" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path jumo:ownerRealm ;
            sh:pattern "^[a-z][a-z0-9-]*$" ] ;
    sh:targetClass jumo:RemoteMcpServiceSpec .

jumo:RenderedKitAsset a sh:NodeShape ;
    rdfs:comment "Provenance for one rendered binary asset or i18n bundle -- same digest-provenance shape as RenderedKitFile, kept a separate class because the source/target patterns admit assetExports' file types instead of `.yml`." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path jumo:targetPath ;
            sh:pattern "^\\.jumo/kits/[a-z][a-z0-9-]*/assets/[A-Za-z0-9._/-]+\\.(png|jpg|jpeg|svg|webp|json)$" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path jumo:digest ;
            sh:pattern "^sha256:[0-9a-f]{64}$" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path jumo:sourcePath ;
            sh:pattern "^\\.jumo/assets/[A-Za-z0-9._/-]+\\.(png|jpg|jpeg|svg|webp|json)$" ] ;
    sh:targetClass jumo:RenderedKitAsset .

jumo:RenderedKitFile a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path jumo:digest ;
            sh:pattern "^sha256:[0-9a-f]{64}$" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path jumo:targetPath ;
            sh:pattern "^\\.jumo/kits/[a-z][a-z0-9-]*/[A-Za-z0-9._/-]+\\.yml$" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path jumo:sourcePath ;
            sh:pattern "^\\.jumo/[A-Za-z0-9._/-]+\\.yml$" ] ;
    sh:targetClass jumo:RenderedKitFile .

jumo:RepositoryBinding a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "OWNER_ONLY (default): only the ownerRealm may authorize forge writes. MUTUAL_CONSENT: every co-owner Realm must signal approval before ForgeApplier merges." ;
            sh:in ( "OWNER_ONLY" "MUTUAL_CONSENT" ) ;
            sh:maxCount 1 ;
            sh:order 4 ;
            sh:path jumo:approvalPolicy ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path jumo:id ;
            sh:pattern "^[a-z][a-z0-9-]*$" ],
        [ sh:datatype xsd:string ;
            sh:description "owner/name. A literal TODO is rejected (Rego, for the placeholder scan)." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path jumo:repository ;
            sh:pattern "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" ],
        [ sh:in ( "github" "gitlab" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 1 ;
            sh:path jumo:provider ],
        [ sh:datatype xsd:string ;
            sh:description "Additional Realm identifiers that co-govern this repository. When non-empty, all named Realms must declare a matching RepositoryBinding pointing at the same repository. Policy enforces mutual binding via Rego (corpus.project.mutual-repo-binding)." ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path jumo:coOwnerRealms ;
            sh:pattern "^[a-z][a-z0-9-]*$" ] ;
    sh:targetClass jumo:RepositoryBinding .

jumo:ResourceBudgetSpec a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class jumo:BudgetLimits ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path jumo:limits ],
        [ sh:in ( "WAIT_FOR_RECOVERY" "USE_AUTHORIZED_ALTERNATIVE" "REQUEST_HUMAN_DECISION" "STOP_CLEANLY" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 2 ;
            sh:path jumo:onExhaustion ],
        [ sh:description "A floor. Exhaustion may never push the Episode below it without explicit policy and approval." ;
            sh:in ( "NONE" "SELF_REPORTED" "OBSERVED" "INDEPENDENTLY_VERIFIED" ) ;
            sh:maxCount 1 ;
            sh:order 1 ;
            sh:path jumo:minimumAssurance ],
        [ sh:datatype xsd:boolean ;
            sh:defaultValue true ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path jumo:preferDeterministicRouting ] ;
    sh:targetClass jumo:ResourceBudgetSpec .

jumo:RoleAssignmentSpec a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class jumo:ContractReference ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path jumo:roleDefinitionRef ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path jumo:ownerRealm ;
            sh:pattern "^[a-z][a-z0-9-]*$" ],
        [ sh:class jumo:RoleBearer ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path jumo:bearer ] ;
    sh:targetClass jumo:RoleAssignmentSpec .

jumo:RoleBearer a sh:NodeShape ;
    rdfs:comment "Discriminated union (HUMAN | AGENT | FEDERATED_PEER) in the source schema. LinkML has no native discriminated union at the attribute level; modeled as one class with branch fields optional. Which fields are required for which `kind` moves to Rego, same disposition as every other conditional-requiredness invariant here." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class jumo:ContractReference ;
            sh:description "Required when kind is HUMAN." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path jumo:principalRef ],
        [ sh:in ( "HUMAN" "AGENT" "FEDERATED_PEER" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 0 ;
            sh:path jumo:kind ],
        [ sh:class jumo:ContractReference ;
            sh:description "Required when kind is AGENT." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path jumo:agentDefinitionRef ],
        [ sh:datatype xsd:string ;
            sh:description "Optional remote role identifier in the peer realm." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path jumo:remoteRoleKey ],
        [ sh:class jumo:ContractReference ;
            sh:description "Optional, only meaningful when kind is AGENT." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path jumo:defaultWorkerRequirementProfileRef ],
        [ sh:class jumo:ContractReference ;
            sh:description "Required when kind is FEDERATED_PEER. Names the FederatedPeer contract." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path jumo:federatedPeerRef ] ;
    sh:targetClass jumo:RoleBearer .

jumo:RoleDefinitionSpec a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Optional child or target Realm governed by this meta-role." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path jumo:delegatedRealmRef ;
            sh:pattern "^[a-z][a-z0-9-]*$" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path jumo:mission ;
            sh:pattern "^.{10,}$" ],
        [ sh:datatype xsd:string ;
            sh:description "Optional decorative ThemePack lookup key. Never replaces metadata.id." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path jumo:roleKey ;
            sh:pattern "^[a-z][A-Za-z0-9]*$" ],
        [ sh:datatype xsd:boolean ;
            sh:description "When true, this role acts on behalf of a Jumo Control Plane or Child Realm." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path jumo:isMetaRole ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path jumo:ownerRealm ;
            sh:pattern "^[a-z][a-z0-9-]*$" ],
        [ sh:datatype xsd:string ;
            sh:description "A role's own separation-of-duties group. Two roles sharing one group may not jointly produce and verify the same WorkOrder (governance.rego distinct_independence_groups); absent for a meta-role (Nestor, Owner) that is never itself a team roster candidate." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path jumo:independenceGroup ;
            sh:pattern "^[a-z][a-z0-9-]*$" ] ;
    sh:targetClass jumo:RoleDefinitionSpec .

jumo:RoleLifecyclePolicySpec a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:minInclusive 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path jumo:boundedTrialEpisodesRequired ],
        [ sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path jumo:evaluationCriteria ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path jumo:ownerRealm ;
            sh:pattern "^[a-z][a-z0-9-]*$" ],
        [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:minInclusive 0 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path jumo:shadowEpisodesRequired ],
        [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:minInclusive 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path jumo:maxTrialDurationDays ] ;
    sh:targetClass jumo:RoleLifecyclePolicySpec .

jumo:RoutingEligibilitySpec a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path jumo:ownerRealm ;
            sh:pattern "^[a-z][a-z0-9-]*$" ],
        [ sh:class jumo:ContractReference ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path jumo:eligibleRoleDefinitionRefs ],
        [ sh:class jumo:ContractReference ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path jumo:eligibleTeamSpecRefs ],
        [ sh:class jumo:ContractReference ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path jumo:projectRef ] ;
    sh:targetClass jumo:RoutingEligibilitySpec .

jumo:SeatIncompatibility a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:minCount 2 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path jumo:seatIds ;
            sh:pattern "^[a-z][a-z0-9-]*$" ] ;
    sh:targetClass jumo:SeatIncompatibility .

jumo:SeatIndependenceGroup a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:minCount 2 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path jumo:seatIds ;
            sh:pattern "^[a-z][a-z0-9-]*$" ] ;
    sh:targetClass jumo:SeatIndependenceGroup .

jumo:SecretBindingSpec a sh:NodeShape ;
    rdfs:comment "anyOf(allowedBundleRefs, allowedRemoteServiceRefs, allowedConnectorRefs, allowedWorkerSubstrateRefs) moves to Rego." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Account- or connector-scoped OpenBao KV-v2 reference resolved by the per-Realm SecretBroker; not a secret value." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path jumo:runtimeRef ;
            sh:pattern "^openbao://[a-z][a-z0-9.-]{2,}/[a-zA-Z0-9._/-]+$" ],
        [ sh:class jumo:SecretRotation ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 9 ;
            sh:path jumo:rotation ],
        [ sh:class jumo:ContractReference ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path jumo:allowedRemoteMcpServiceRefs ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path jumo:ownerRealm ;
            sh:pattern "^[a-z][a-z0-9-]*$" ],
        [ sh:class jumo:ContractReference ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path jumo:allowedMcpBundleRefs ],
        [ sh:in ( "DECLARED" "ENABLED" "SUSPENDED" "RETIRED" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 1 ;
            sh:path jumo:lifecycle ],
        [ sh:class jumo:ContractReference ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path jumo:allowedConnectorDefinitionRefs ],
        [ sh:class jumo:ContractReference ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path jumo:allowedWorkerSubstrateRefs ],
        [ sh:datatype xsd:string ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path jumo:allowedOperationRefs ;
            sh:pattern "^[a-z][a-z0-9-]*$" ],
        [ sh:class jumo:SecretInjection ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path jumo:injection ] ;
    sh:targetClass jumo:SecretBindingSpec .

jumo:SecretInjection a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path jumo:environmentVariable ;
            sh:pattern "^[A-Z][A-Z0-9_]{1,127}$" ],
        [ sh:in ( "MCP_PROCESS_ONLY" "FORGE_APPLIER_PROCESS_ONLY" "MODEL_WORKER_PROCESS_ONLY" "REGISTRY_WORKER_PROCESS_ONLY" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 0 ;
            sh:path jumo:target ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path jumo:fileName ;
            sh:pattern "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" ] ;
    sh:targetClass jumo:SecretInjection .

jumo:SecretRotation a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:boolean ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path jumo:required ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path jumo:maximumAge ;
            sh:pattern "^P(?!$)(\\d+Y)?(\\d+M)?(\\d+D)?(T(?=\\d)(\\d+H)?(\\d+M)?(\\d+S)?)?$" ] ;
    sh:targetClass jumo:SecretRotation .

jumo:SelfDescriptionAnswer a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:in ( "HUMAN" "AGENT" "CLIENT" ) ;
            sh:minCount 1 ;
            sh:order 3 ;
            sh:path jumo:audience ],
        [ sh:class jumo:ContractReference ;
            sh:description "Optional PromptTemplate that phrases the extracted facts." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path jumo:narrationPromptTemplateRef ],
        [ sh:class jumo:SelfDescriptionFact ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path jumo:facts ],
        [ sh:in ( "PURPOSE" "STATE" "COMMITMENTS" "CAPABILITIES" "WAITING_ON" "RECENT_CHANGES" "RISKS" "BOUNDARIES" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 0 ;
            sh:path jumo:question ] ;
    sh:targetClass jumo:SelfDescriptionAnswer .

jumo:SelfDescriptionFact a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:boolean ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path jumo:redactBeyondBoundary ],
        [ sh:datatype xsd:string ;
            sh:description "Deterministic source: a contract kind and path such as 'Project.spec.purpose', or a named recognized-state query. Evaluated without a model." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path jumo:from ;
            sh:pattern "^.{3,}$" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path jumo:name ;
            sh:pattern "^[a-z][a-zA-Z0-9_]*$" ] ;
    sh:targetClass jumo:SelfDescriptionFact .

jumo:SelfDescriptionSpec a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class jumo:SelfDescriptionSubject ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path jumo:subject ],
        [ sh:class jumo:SelfDescriptionAnswer ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path jumo:answers ],
        [ sh:class jumo:AgentCard ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path jumo:agentCard ] ;
    sh:targetClass jumo:SelfDescriptionSpec .

jumo:SelfDescriptionSubject a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path jumo:id ;
            sh:pattern "^[a-z][a-z0-9-]*$" ],
        [ sh:in ( "Project" "AgentArchetype" "Realm" "Role" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 0 ;
            sh:path jumo:kind ] ;
    sh:targetClass jumo:SelfDescriptionSubject .

jumo:SolicitationApproval a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:in ( "BOTH_WHEN_DIFFERENT" "BOTH_ALWAYS" "TARGET_ONLY" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 0 ;
            sh:path jumo:requiredOwners ] ;
    sh:targetClass jumo:SolicitationApproval .

jumo:SolicitationContractSpec a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path jumo:expiresAfter ;
            sh:pattern "^P(?!$)(\\d+Y)?(\\d+M)?(\\d+D)?(T(?=\\d)(\\d+H)?(\\d+M)?(\\d+S)?)?$" ],
        [ sh:in ( "raw_memory_access" "secret_access" "transitive_capability_use" "policy_inspection" "cross_realm_identity_resolution" ) ;
            sh:minCount 1 ;
            sh:order 5 ;
            sh:path jumo:forbidden ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path jumo:targetProject ;
            sh:pattern "^[a-z][a-z0-9-]*$" ],
        [ sh:class jumo:SolicitationApproval ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path jumo:approval ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path jumo:callerProject ;
            sh:pattern "^[a-z][a-z0-9-]*$" ],
        [ sh:class jumo:AllowedRequest ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path jumo:allowedRequests ] ;
    sh:targetClass jumo:SolicitationContractSpec .

jumo:Surface a sh:NodeShape ;
    rdfs:comment "Conditional (reads containing FORGE_PROJECTIONS forces audience REALM_PRIVATE) moves to Rego." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path jumo:id ;
            sh:pattern "^[a-z][a-z0-9-]*$" ],
        [ sh:in ( "INTERFACE_MANIFEST" "AGENT_ROLES" "CHANGE_PROPOSALS" "FORGE_PROJECTIONS" "EVIDENCE" "DOCUMENT_TREE" "DOCUMENT_CONTENT" "CONVERSATION" "JOURNEYS" "JOURNEY_RUN" "CONNECTOR_CATALOG" "ATTENTION_ITEMS" "THEME_PACK" "ACCOUNT_PROFILE" "TEAM_ROSTER" "TEAM_HUB" "WORK_ORDERS" "CONTEXT_GRAPH" "SESSION" "ORGANIZATIONS" "ORGANIZATION_GOVERNANCE" "ORGANIZATION_MEMBERS" "ORGANIZATION_COMPOSITION" "ORGANIZATION_RETENTION" "ORGANIZATION_RETENTION_HOLDS" "ORGANIZATION_AUDIT_HISTORY" "ORGANIZATION_ONBOARDING" "AUDIT_HISTORY" "EXECUTION_MACHINES" "MACHINE_OBSERVATIONS" "CLI_TOOLS" "PROVIDER_QUOTAS" "CONNECTOR_INTEGRATIONS" ) ;
            sh:minCount 1 ;
            sh:order 3 ;
            sh:path jumo:reads ],
        [ sh:in ( "PUBLISHED_SUMMARY" "TYPED_ATTENTION_ONLY" "PROJECT_SCOPED" "REALM_PRIVATE" "ORGANIZATION_ONLY" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 2 ;
            sh:path jumo:audience ],
        [ sh:class jumo:SurfaceWritePath ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path jumo:writePaths ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path jumo:presenceRef ;
            sh:pattern "^[a-z][a-zA-Z0-9]*$" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path jumo:purpose ;
            sh:pattern "^.{10,}$" ],
        [ sh:datatype xsd:string ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path jumo:proposes ;
            sh:pattern "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9]*){1,3}$" ] ;
    sh:targetClass jumo:Surface .

jumo:SurfaceWritePath a sh:NodeShape ;
    rdfs:comment "Path traversal, editor-to-path compatibility, and required-obligation preservation are semantic constraints enforced by Rego." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:in ( "RING_0_ROOT_OF_TRUST" "RING_1_CONTROL_PLANE" "RING_2_AGENT_BEHAVIOR" "RING_3_GOVERNED_PROJECT" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 2 ;
            sh:path jumo:ring ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path jumo:pathGlob ;
            sh:pattern "^[A-Za-z0-9._*-]+(/[A-Za-z0-9._*-]+)*$" ],
        [ sh:in ( "STEP_UP_AUTHENTICATION" "HUMAN_OWNER_APPROVAL" "INDEPENDENT_VERIFICATION" "DISCLOSE_AGENT_IDENTITY" "RETAIN_PROVENANCE" "REDACT_SECRETS" "PREVIEW_BEFORE_SEND" ) ;
            sh:minCount 1 ;
            sh:order 5 ;
            sh:path jumo:requiredObligations ],
        [ sh:in ( "WYSIWYG_MARKDOWN" "STRUCTURED_YAML" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 4 ;
            sh:path jumo:editor ],
        [ sh:datatype xsd:string ;
            sh:defaultValue "PROJECT_REPOSITORY"^^xsd:string ;
            sh:in ( "PROJECT_REPOSITORY" ) ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path jumo:target ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path jumo:capabilityRef ;
            sh:pattern "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9]*){1,3}$" ] ;
    sh:targetClass jumo:SurfaceWritePath .

jumo:TeamCoordination a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class jumo:CoordinationMechanismBinding ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path jumo:mechanisms ],
        [ sh:class jumo:ContractReference ;
            sh:description "Required when any mechanism binding uses DIRECT_SUPERVISION; must resolve to a role leaf of this team. Conditional requiredness moves to Rego." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path jumo:leadRoleDefinitionRef ] ;
    sh:targetClass jumo:TeamCoordination .

jumo:TeamMember a sh:NodeShape ;
    rdfs:comment "Discriminated union (roleMember | teamMember) in the source schema. Modeled as one class; exactly one of roleDefinitionRef/teamSpecRef is expected (Rego)." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path jumo:independenceGroup ;
            sh:pattern "^[a-z][a-z0-9-]*$" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path jumo:role ;
            sh:pattern "^.{3,}$" ],
        [ sh:class jumo:ContractReference ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path jumo:roleDefinitionRef ],
        [ sh:class jumo:ContractReference ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path jumo:teamSpecRef ] ;
    sh:targetClass jumo:TeamMember .

jumo:TeamSpecBody a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path jumo:purpose ;
            sh:pattern "^.{10,}$" ],
        [ sh:class jumo:TeamMember ;
            sh:minCount 2 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path jumo:members ],
        [ sh:class jumo:TeamCoordination ;
            sh:description "The managed dependency, not the team, is the unit of analysis (docs/concepts/positionnement-conceptuel.md#coordination-des-dependances). The source schema forced one `mode` for the whole team; this carries one or more CoordinationMechanismBinding entries instead, each scoped to the dependency it governs." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path jumo:coordination ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path jumo:roleKey ;
            sh:pattern "^[a-z][A-Za-z0-9]*$" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path jumo:ownerRealm ;
            sh:pattern "^[a-z][a-z0-9-]*$" ] ;
    sh:targetClass jumo:TeamSpecBody .

jumo:TerminologyEntry a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path jumo:roleKey ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path jumo:displayName ;
            sh:pattern "^.{1,}$" ] ;
    sh:targetClass jumo:TerminologyEntry .

jumo:TermsReview a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path jumo:sourceRef ;
            sh:pattern "^.{3,}$" ],
        [ sh:datatype xsd:date ;
            sh:description "The review's validity deadline; the window between reviewedAt and validUntil may not exceed 90 days (Rego)." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path jumo:validUntil ],
        [ sh:datatype xsd:date ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path jumo:reviewedAt ] ;
    sh:targetClass jumo:TermsReview .

jumo:ThemeObjectForm a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path jumo:entityKey ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path jumo:form ;
            sh:pattern "^.{1,}$" ] ;
    sh:targetClass jumo:ThemeObjectForm .

jumo:ThemePackSpec a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class jumo:ThemeVoice ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path jumo:voice ],
        [ sh:class jumo:ThemeVisualization ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path jumo:visualization ],
        [ sh:class jumo:TerminologyEntry ;
            sh:description "Display names by role key, such as chiefOfStaff or securityAgent. The technical identifier is unaffected." ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path jumo:terminology ] ;
    sh:targetClass jumo:ThemePackSpec .

jumo:ThemePresence a sh:NodeShape ;
    rdfs:comment "How the Chief of Staff is drawn on a surface. Every field here is presentation: there is no data source, no scope and no threshold, so the representation cannot become the thing represented." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:in ( "NONE" "SUBTLE" "EXPRESSIVE" ) ;
            sh:maxCount 1 ;
            sh:order 2 ;
            sh:path jumo:motion ],
        [ sh:in ( "CALM" "STANDARD" "DENSE" ) ;
            sh:maxCount 1 ;
            sh:order 1 ;
            sh:path jumo:density ],
        [ sh:datatype xsd:string ;
            sh:description "Named visual form. Naming one does not name an agent." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path jumo:chiefOfStaffForm ;
            sh:pattern "^.{3,}$" ] ;
    sh:targetClass jumo:ThemePresence .

jumo:ThemeRoom a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Asset reference for the room's illustrated 2D backdrop." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path jumo:background ;
            sh:pattern "^.{3,}$" ],
        [ sh:class jumo:ThemeObjectForm ;
            sh:description "Themed representation by business entity key -- the business term stays visible next to the metaphor (decision 216)." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path jumo:objectForms ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path jumo:roomId ;
            sh:pattern "^[a-z][a-z0-9-]*$" ] ;
    sh:targetClass jumo:ThemeRoom .

jumo:ThemeVisualization a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path jumo:palette ;
            sh:pattern "^.{3,}$" ],
        [ sh:class jumo:ThemePresence ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path jumo:presence ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path jumo:ecosystem ;
            sh:pattern "^.{3,}$" ],
        [ sh:class jumo:ThemeRoom ;
            sh:description "Illustrated room decor keyed by surface id (ADR-0087). A missing entry renders the classic view rather than failing." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path jumo:rooms ] ;
    sh:targetClass jumo:ThemeVisualization .

jumo:ThemeVoice a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:in ( "CALM_PRECISE" "DIRECT" "ANALYTICAL" "WARM" ) ;
            sh:maxCount 1 ;
            sh:order 0 ;
            sh:path jumo:style ],
        [ sh:in ( "TERSE" "BALANCED" "EXPANSIVE" ) ;
            sh:maxCount 1 ;
            sh:order 1 ;
            sh:path jumo:verbosity ],
        [ sh:class jumo:ThemeVoiceRoleOverride ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path jumo:roleOverrides ] ;
    sh:targetClass jumo:ThemeVoice .

jumo:ThemeVoiceRoleOverride a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path jumo:roleKey ;
            sh:pattern "^[a-z][A-Za-z0-9]*$" ],
        [ sh:in ( "CALM_PRECISE" "DIRECT" "ANALYTICAL" "WARM" ) ;
            sh:maxCount 1 ;
            sh:order 1 ;
            sh:path jumo:style ],
        [ sh:in ( "TERSE" "BALANCED" "EXPANSIVE" ) ;
            sh:maxCount 1 ;
            sh:order 2 ;
            sh:path jumo:verbosity ] ;
    sh:targetClass jumo:ThemeVoiceRoleOverride .

jumo:UpstreamToolEntry a sh:NodeShape ;
    rdfs:comment "Reason required when disposition is WITHHELD or QUARANTINED (Rego): exposing a tool is justified by the operation that maps it to a capability; holding one back has no such document, so the reason lives here or nowhere." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:in ( "EXPOSED" "WITHHELD" "QUARANTINED" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 1 ;
            sh:path jumo:disposition ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path jumo:reason ;
            sh:pattern "^.{10,}$" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path jumo:upstreamToolName ;
            sh:pattern "^.{1,}$" ] ;
    sh:targetClass jumo:UpstreamToolEntry .

jumo:VocabularyEntry a sh:NodeShape ;
    rdfs:comment "One CONTRACT kind's names. directory and trailer are target-state values the atomic rename (vocabulary-glossary-and-rename AC2/AC3) has not applied everywhere yet -- they are not cross-checked against the current filesystem or commit-msg hook." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path jumo:trailer ;
            sh:pattern "^Jumo-[A-Za-z-]+$" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path jumo:displayEn ;
            sh:pattern "^.{1,}$" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path jumo:directory ;
            sh:pattern "^[a-z][a-z0-9-]*$" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path jumo:pluralFr ;
            sh:pattern "^.{1,}$" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path jumo:displayFr ;
            sh:pattern "^.{1,}$" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path jumo:pluralEn ;
            sh:pattern "^.{1,}$" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path jumo:canonical ;
            sh:pattern "^[A-Z][A-Za-z0-9]*$" ] ;
    sh:targetClass jumo:VocabularyEntry .

jumo:VocabularySetSpec a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class jumo:VocabularyEntry ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path jumo:entries ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path jumo:ownerRealm ;
            sh:pattern "^[a-z][a-z0-9-]*$" ] ;
    sh:targetClass jumo:VocabularySetSpec .

jumo:WorkOrderSpec a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class jumo:ConsumptionReport ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 23 ;
            sh:path jumo:consumption ],
        [ sh:datatype xsd:string ;
            sh:description "Groups durable work contracts into a generated roadmap projection." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path jumo:roadmapRef ;
            sh:pattern "^[a-z][a-z0-9-]*$" ],
        [ sh:in ( "PROPOSED" "ACCEPTED" "IN_PROGRESS" "DECLINED" "COMPLETED" "FAILED" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 7 ;
            sh:path jumo:state ],
        [ sh:class jumo:ContractReference ;
            sh:description "WorkOrders that must be COMPLETED before this one starts." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 17 ;
            sh:path jumo:dependsOnWorkOrderRefs ],
        [ sh:datatype xsd:string ;
            sh:description "Glob patterns the work may touch." ;
            sh:nodeKind sh:Literal ;
            sh:order 15 ;
            sh:path jumo:pathScope ;
            sh:pattern "^.{1,}$" ],
        [ sh:class jumo:ContractReference ;
            sh:description "The larger item this decomposes." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 18 ;
            sh:path jumo:parentWorkOrderRef ],
        [ sh:datatype xsd:string ;
            sh:description "Commit that carried the last full (pre-compaction) revision of this record, for a COMPLETED WorkOrder compacted into .jumo/work/ledger/. Set by scripts/migrate/compact-completed-work.py, never by hand." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 22 ;
            sh:path jumo:ledgerSourceRevision ;
            sh:pattern "^.{7,}$" ],
        [ sh:datatype xsd:string ;
            sh:nodeKind sh:Literal ;
            sh:order 19 ;
            sh:path jumo:sourceRefs ;
            sh:pattern "^.{1,}$" ],
        [ sh:class jumo:ContractReference ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path jumo:projectRef ],
        [ sh:class jumo:WorkOrderSpecification ;
            sh:description "Long-form design lots too large for purpose/condition/acceptanceCriteria -- Markdown body, no language restriction (WorkOrder specification prose is exempt from the English-only rule, AGENTS.md)." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 14 ;
            sh:path jumo:specification ],
        [ sh:datatype xsd:string ;
            sh:description "Set when state is PROPOSED after having been ACCEPTED or IN_PROGRESS, to record why work paused rather than why it was declined. Distinct from declineReason, which is permanent." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path jumo:suspendedReason ;
            sh:pattern "^.{1,160}$" ],
        [ sh:datatype xsd:string ;
            sh:description "The role, team, or Project the work is owed to." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path jumo:creditor ;
            sh:pattern "^[a-z][a-z0-9-]*$" ],
        [ sh:in ( "OUT_OF_SCOPE" "NO_CAPABILITY" "OVER_BUDGET" "CONFLICTING_COMMITMENT" "AMBIGUOUS" "SUPERSEDED" ) ;
            sh:maxCount 1 ;
            sh:order 8 ;
            sh:path jumo:declineReason ],
        [ sh:class jumo:ContractReference ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path jumo:teamSpecRef ],
        [ sh:datatype xsd:string ;
            sh:description "Commit the contracts were read at." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 20 ;
            sh:path jumo:contractRevision ;
            sh:pattern "^.{7,}$" ],
        [ sh:description "The ring this work acts on. RING_0_ROOT_OF_TRUST exclusion (source schema's `not: const`) moves to Rego." ;
            sh:in ( "RING_0_ROOT_OF_TRUST" "RING_1_CONTROL_PLANE" "RING_2_AGENT_BEHAVIOR" "RING_3_GOVERNED_PROJECT" ) ;
            sh:maxCount 1 ;
            sh:order 16 ;
            sh:path jumo:ring ],
        [ sh:class jumo:ContractReference ;
            sh:description "The role that checks the result against the criteria below. May not be the producer; resolves through teamSpecRef to prove a different independence group (Rego)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path jumo:verifierRoleDefinitionRef ],
        [ sh:datatype xsd:string ;
            sh:description "The role or team that owes this work (commitment lifecycle addition, conceptual upgrades table). Defaults conceptually to producerRoleDefinitionRef/teamSpecRef; kept as an explicit field so a WorkOrder assigned onward carries an accountable debtor independent of who drafted it." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path jumo:debtor ;
            sh:pattern "^[a-z][a-z0-9-]*$" ],
        [ sh:datatype xsd:string ;
            sh:description "The condition under which this commitment is discharged, in addition to (not instead of) acceptanceCriteria -- acceptanceCriteria is what is checked; condition is the commitment-theoretic statement of when the debt is considered settled." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path jumo:condition ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path jumo:purpose ;
            sh:pattern "^.{10,}$" ],
        [ sh:class jumo:AcceptanceCriterion ;
            sh:description "What the result is checked against. Required from ACCEPTED onward (Rego, same as the source schema's conditional)." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 13 ;
            sh:path jumo:acceptanceCriteria ],
        [ sh:class jumo:ContractReference ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 24 ;
            sh:path jumo:resourceBudgetRef ],
        [ sh:datatype xsd:string ;
            sh:description "Architecture decisions this work implements or expects." ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path jumo:decisionRefs ;
            sh:pattern "^ADR-[0-9]{4}$" ],
        [ sh:class jumo:ContractReference ;
            sh:description "The individual accountable role. A team is never the final accountable addressee." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path jumo:producerRoleDefinitionRef ],
        [ sh:datatype xsd:string ;
            sh:nodeKind sh:Literal ;
            sh:order 21 ;
            sh:path jumo:evidenceRefs ;
            sh:pattern "^.{1,}$" ] ;
    sh:targetClass jumo:WorkOrderSpec .

jumo:WorkOrderSpecification a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path jumo:title ;
            sh:pattern "^.{1,}$" ],
        [ sh:datatype xsd:string ;
            sh:description "Markdown allowed." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path jumo:body ;
            sh:pattern "^.{1,}$" ] ;
    sh:targetClass jumo:WorkOrderSpecification .

jumo:WorkerContextRequirement a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:minInclusive 1024 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path jumo:minimumTokens ] ;
    sh:targetClass jumo:WorkerContextRequirement .

jumo:WorkerGrantedOperation a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class jumo:ContractReference ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path jumo:connectorDefinitionRef ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path jumo:operationRef ;
            sh:pattern "^[a-z][a-z0-9-]*$" ] ;
    sh:targetClass jumo:WorkerGrantedOperation .

jumo:WorkerImage a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path jumo:reference ;
            sh:pattern "^.{3,}$" ],
        [ sh:datatype xsd:string ;
            sh:description "A tag is a moving target; evidence names the bytes that ran." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path jumo:digest ;
            sh:pattern "^sha256:[0-9a-f]{64}$" ] ;
    sh:targetClass jumo:WorkerImage .

jumo:WorkerInteractionRequirement a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:in ( "NONE" "OPTIONAL" "REQUIRED" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 0 ;
            sh:path jumo:toolUse ],
        [ sh:in ( "NONE" "OPTIONAL" "REQUIRED" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 1 ;
            sh:path jumo:structuredOutput ] ;
    sh:targetClass jumo:WorkerInteractionRequirement .

jumo:WorkerIsolation a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class jumo:WorkerIsolationLimits ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path jumo:limits ],
        [ sh:description "Open egress is absent because it would let a CLI re-acquire authority outside Jumo's grant." ;
            sh:in ( "NONE" "MODEL_ENDPOINT_ONLY" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 0 ;
            sh:path jumo:network ],
        [ sh:datatype xsd:string ;
            sh:description "A runtime socket mount hands the container authority over its own sandbox." ;
            sh:in ( "ABSENT" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path jumo:containerRuntimeSocket ],
        [ sh:in ( "ABSENT" "READ_ONLY" "WRITABLE" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 5 ;
            sh:path jumo:workspace ],
        [ sh:datatype xsd:string ;
            sh:in ( "DROP_ALL" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path jumo:linuxCapabilities ],
        [ sh:datatype xsd:string ;
            sh:in ( "READ_ONLY" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path jumo:rootFilesystem ],
        [ sh:datatype xsd:string ;
            sh:in ( "DENIED" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path jumo:privilegeEscalation ] ;
    sh:targetClass jumo:WorkerIsolation .

jumo:WorkerIsolationLimits a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:maxInclusive 1024 ;
            sh:minCount 1 ;
            sh:minInclusive 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path jumo:pids ],
        [ sh:datatype xsd:float ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path jumo:cpus ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path jumo:wallClock ;
            sh:pattern "^P(?!$)(\\d+Y)?(\\d+M)?(\\d+D)?(T(?=\\d)(\\d+H)?(\\d+M)?(\\d+S)?)?$" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path jumo:memory ;
            sh:pattern "^[1-9][0-9]*(Mi|Gi)$" ] ;
    sh:targetClass jumo:WorkerIsolationLimits .

jumo:WorkerLimits a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:in ( "LOW" "MEDIUM" "HIGH" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 1 ;
            sh:path jumo:maximumCostClass ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path jumo:maximumLatency ;
            sh:pattern "^P(?!$)(\\d+Y)?(\\d+M)?(\\d+D)?(T(?=\\d)(\\d+H)?(\\d+M)?(\\d+S)?)?$" ] ;
    sh:targetClass jumo:WorkerLimits .

jumo:WorkerModelAccess a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "MODEL_WORKER_PROCESS may consume only an OpenBao-rendered file bound to this substrate; no environment value, repository mount, or ambient credential is permitted." ;
            sh:in ( "GATEWAY_TOKEN_ONLY" "PLAN_SESSION_ONLY" "OPENBAO_RENDERED_FILE" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 2 ;
            sh:path jumo:credentialSource ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path jumo:gatewayRef ;
            sh:pattern "^[a-z][a-z0-9.-]{2,}$" ],
        [ sh:in ( "PLAN_DIRECT" "GATEWAY_ROUTED" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 0 ;
            sh:path jumo:mode ],
        [ sh:class jumo:ContractReference ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path jumo:providerAccountRef ],
        [ sh:class jumo:ContractReference ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path jumo:secretBindingRef ] ;
    sh:targetClass jumo:WorkerModelAccess .

jumo:WorkerQualityRequirement a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class jumo:ContractReference ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path jumo:goldenTaskSetRefs ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path jumo:maximumEvaluationAge ;
            sh:pattern "^P(?!$)(\\d+Y)?(\\d+M)?(\\d+D)?(T(?=\\d)(\\d+H)?(\\d+M)?(\\d+S)?)?$" ],
        [ sh:in ( "NONE" "SELF_REPORTED" "OBSERVED" "INDEPENDENTLY_VERIFIED" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 0 ;
            sh:path jumo:minimumAssurance ],
        [ sh:in ( "LOW" "MEDIUM" "HIGH" ) ;
            sh:maxCount 1 ;
            sh:order 4 ;
            sh:path jumo:reasoningEffort ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path jumo:minimumTaskHorizon ;
            sh:pattern "^P(?!$)(\\d+Y)?(\\d+M)?(\\d+D)?(T(?=\\d)(\\d+H)?(\\d+M)?(\\d+S)?)?$" ],
        [ sh:datatype xsd:float ;
            sh:maxCount 1 ;
            sh:maxInclusive 1 ;
            sh:minCount 1 ;
            sh:minInclusive 0 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path jumo:minimumReliability ] ;
    sh:targetClass jumo:WorkerQualityRequirement .

jumo:WorkerRequirementProfileSpec a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class jumo:WorkerLimits ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path jumo:limits ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path jumo:ownerRealm ;
            sh:pattern "^[a-z][a-z0-9-]*$" ],
        [ sh:in ( "PUBLISHED_SUMMARY" "TYPED_ATTENTION_ONLY" "PROJECT_SCOPED" "REALM_PRIVATE" "ORGANIZATION_ONLY" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 3 ;
            sh:path jumo:dataScopeCeiling ],
        [ sh:in ( "TEXT" "AUDIO" "IMAGE" "VIDEO" ) ;
            sh:minCount 1 ;
            sh:order 2 ;
            sh:path jumo:modalities ],
        [ sh:class jumo:WorkerQualityRequirement ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path jumo:quality ],
        [ sh:class jumo:WorkerInteractionRequirement ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path jumo:interaction ],
        [ sh:class jumo:WorkerContextRequirement ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path jumo:context ],
        [ sh:datatype xsd:string ;
            sh:description "Narrows eligible ProviderAccounts to those sharing this independenceGroup (own, or inherited from their ProviderPlatform). Two profiles at the same reasoningEffort rung are otherwise indistinguishable for routing purposes (provider-platform-catalog lot); a producing and a verifying role's profiles declare disjoint values here when ADR-0019's independence separation must hold operationally, not just architecturally. Absent by default -- most profiles route on rung alone." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path jumo:requiredIndependenceGroup ;
            sh:pattern "^[a-z][a-z0-9-]*$" ],
        [ sh:in ( "CLASSIFICATION" "NARRATION" "REASONING" "CODING" "VERIFICATION" "REALTIME_DIALOGUE" ) ;
            sh:minCount 1 ;
            sh:order 1 ;
            sh:path jumo:taskClasses ] ;
    sh:targetClass jumo:WorkerRequirementProfileSpec .

jumo:WorkerSubstrateSpec a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class jumo:WorkerModelAccess ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path jumo:modelAccess ],
        [ sh:datatype xsd:string ;
            sh:description "No CLI home, image, plugin, repository file, or provider default silently grants tool access." ;
            sh:in ( "DISABLED" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path jumo:ambientToolAuthority ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path jumo:ownerRealm ;
            sh:pattern "^[a-z][a-z0-9-]*$" ],
        [ sh:class jumo:ContractReference ;
            sh:description "Durable execution machine selected for this CLI substrate; an ExecutionCellLease remains invocation-scoped." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path jumo:executionMachineRef ],
        [ sh:in ( "CLAUDE_CODE" "CODEX" "GEMINI_CLI" "COPILOT_CLI" ) ;
            sh:maxCount 1 ;
            sh:order 4 ;
            sh:path jumo:cli ],
        [ sh:class jumo:WorkerIsolation ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path jumo:isolation ],
        [ sh:class jumo:WorkerGrantedOperation ;
            sh:description "The only external reach available to the substrate." ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 9 ;
            sh:path jumo:grantedOperationRefs ],
        [ sh:in ( "LOCAL_CLI_CONTAINER" "MODEL_WORKER_PROCESS" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 3 ;
            sh:path jumo:substrate ],
        [ sh:class jumo:WorkerImage ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path jumo:image ],
        [ sh:in ( "DECLARED" "ENABLED" "SUSPENDED" "RETIRED" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 2 ;
            sh:path jumo:lifecycle ],
        [ sh:description "Licensing and entitlement fact only. Not a security boundary and not a sphere." ;
            sh:in ( "PERSONAL" "COMMERCIAL" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 13 ;
            sh:path jumo:usageContext ],
        [ sh:datatype xsd:string ;
            sh:description "A mounted CLI home carries native connectors, consent history and trusted folders; isolated per-invocation state removes that duplicated authority." ;
            sh:in ( "ISOLATED_PER_INVOCATION" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path jumo:homeState ],
        [ sh:description "Which ProviderAccount use context this substrate is authorized to consume, explicit so a declared substrate never silently upgrades from holder-operated to Jumo-managed use." ;
            sh:in ( "HOLDER_OPERATED" "JUMO_MANAGED" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 14 ;
            sh:path jumo:accountUse ],
        [ sh:datatype xsd:string ;
            sh:description "CLI-native connectors and MCP servers are disabled so the fact is reviewable rather than hidden in an image. Unaffected by AGENTS.md's development-agent MCP directives -- those govern a human's own terminal session, not a dispatched worker." ;
            sh:in ( "DISABLED" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path jumo:nativeToolAuthority ],
        [ sh:datatype xsd:string ;
            sh:description "Tool capabilities are dynamically projected by the Jumo capability gateway via an invocation-scoped Streamable HTTP MCP endpoint based on explicit InvocationCapabilityGrants." ;
            sh:in ( "GRANT_ONLY" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path jumo:projectedToolAuthority ] ;
    sh:targetClass jumo:WorkerSubstrateSpec .

jumo:AssistedJourneyFieldValidation a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:minInclusive 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path jumo:minimumLength ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path jumo:field ],
        [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:minInclusive 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path jumo:minimumItems ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path jumo:pattern ],
        [ sh:datatype xsd:boolean ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path jumo:required ] ;
    sh:targetClass jumo:AssistedJourneyFieldValidation .

jumo:CoordinationMechanismBinding a sh:NodeShape ;
    rdfs:comment "One coordination mechanism scoped to the dependency it actually governs, replacing a single team-wide mode (docs/concepts/positionnement-conceptuel.md#coordination-des-dependances). Shared by TeamSpec and CoordinationProfile so a team's inline coordination and a reusable named profile speak the same vocabulary." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Open vocabulary; aligns with ActionCapabilitySet's riskTier where relevant." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path jumo:riskTier ],
        [ sh:datatype xsd:string ;
            sh:description "Open vocabulary naming the work phase this binding applies to." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path jumo:phase ],
        [ sh:in ( "DIRECT_SUPERVISION" "STANDARDIZED_PROCESS" "STANDARDIZED_OUTPUT" "STANDARDIZED_SKILL" "MUTUAL_ADJUSTMENT" "ADVERSARIAL_REVIEW" "CONSENT" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 0 ;
            sh:path jumo:mechanism ],
        [ sh:datatype xsd:string ;
            sh:description "Open vocabulary naming the managed dependency (e.g. resource-sharing, prerequisite, simultaneity, decomposition -- Malone & Crowston's categories). Not an enum: the catalog of dependency kinds is expected to grow with experience, and closing it here would recreate the single-mode rigidity this redesign removes." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path jumo:dependencyKind ] ;
    sh:targetClass jumo:CoordinationMechanismBinding .

jumo:EffortRungSpec a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path jumo:modelAlias ;
            sh:pattern "^[a-z][a-z0-9-]*$" ],
        [ sh:class jumo:ProviderNativeEffort ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path jumo:nativeEffort ],
        [ sh:description "Matches a WorkerRequirementProfile.spec.quality.reasoningEffort value one for one; the resolver picks the account's rung with the same name instead of a per-profile alias." ;
            sh:in ( "LOW" "MEDIUM" "HIGH" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 0 ;
            sh:path jumo:rung ] ;
    sh:targetClass jumo:EffortRungSpec .

jumo:EntitlementUseContext a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:in ( "PERMITTED" "PROHIBITED" "UNVERIFIED" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 0 ;
            sh:path jumo:verdict ],
        [ sh:class jumo:TermsReview ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path jumo:termsReview ] ;
    sh:targetClass jumo:EntitlementUseContext .

jumo:AppraisalDimension a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path jumo:finding ;
            sh:pattern "^.{10,}$" ],
        [ sh:in ( "PASS" "CONCERN" "FAIL" "UNKNOWN" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 0 ;
            sh:path jumo:outcome ] ;
    sh:targetClass jumo:AppraisalDimension .

jumo:SchemaBinding a sh:NodeShape ;
    rdfs:comment "Deterministic link between a payload, its LinkML class, and exact schema digest." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:in ( "DRAFT_2020_12" "NATIVE_JSON_SCHEMA" "PROMPTED_JSON_VALIDATED" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 4 ;
            sh:path jumo:profile ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path jumo:modelClass ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path jumo:schemaDigest ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path jumo:schemaVersion ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path jumo:schemaId ] ;
    sh:targetClass jumo:SchemaBinding .

jumo:SchemaBoundPayload a sh:NodeShape ;
    rdfs:comment "Bounded dynamic JSON payload guaranteed by a validated SchemaBinding." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class jumo:SchemaBinding ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path jumo:schemaBinding ],
        [ sh:datatype xsd:boolean ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path jumo:validated ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path jumo:payloadJson ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path jumo:payloadDigest ] ;
    sh:targetClass jumo:SchemaBoundPayload .

jumo:Metadata a sh:NodeShape ;
    rdfs:comment "Shared identity block for every contract document." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class jumo:LayerOverride ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path jumo:overrides ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path jumo:defaultDisplayName ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path jumo:id ;
            sh:pattern "^[a-z][a-z0-9-]*$" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path jumo:namespace ;
            sh:pattern "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*){1,7}$" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path jumo:name ] ;
    sh:targetClass jumo:Metadata .

jumo:ContractReference a sh:NodeShape ;
    rdfs:comment "Structured reference to a Git-declared contract document." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Target contract identifier." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path jumo:id ;
            sh:pattern "^[a-z][a-z0-9-]*$" ],
        [ sh:datatype xsd:string ;
            sh:description "Declared Git-contract kind." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path jumo:kind ;
            sh:pattern "^[A-Z][A-Za-z0-9]+$" ],
        [ sh:datatype xsd:string ;
            sh:description "Target logical namespace." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path jumo:namespace ;
            sh:pattern "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*){1,7}$" ] ;
    sh:targetClass jumo:ContractReference .


