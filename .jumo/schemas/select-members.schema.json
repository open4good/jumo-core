{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jumo.dev/schemas/step-payload/select-members",
  "title": "Select team members step payload",
  "type": "object",
  "properties": {
    "members": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1
    },
    "proposedMembers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "roleRef": { "type": "string", "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$" },
          "role": { "type": "string", "minLength": 3 },
          "mission": { "type": "string", "minLength": 10 },
          "independenceGroup": { "type": "string", "minLength": 1 },
          "responsibilities": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "requestedCapabilities": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "taskClasses": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "modalities": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "minimumTokens": { "type": "integer", "minimum": 1024 },
          "reasoningEffort": { "type": "string" },
          "requiredIndependenceGroup": { "type": "string" },
          "requiredExecutionToolchainRefs": {
            "type": "array",
            "description": "Non-AI build or language-tool environments this member's own task requires (WorkerRequirementProfileSpec.requiredExecutionToolchainRefs). Absent for an AI-only member; each entry must name a same-Realm ExecutionToolchain a WorkerSubstrate provides, refused otherwise.",
            "items": {
              "type": "object",
              "properties": {
                "kind": { "const": "ExecutionToolchain" },
                "namespace": { "type": "string", "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*){1,7}$" },
                "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }
              },
              "required": ["kind", "namespace", "id"]
            }
          },
          "recommendedConnectorRefs": {
            "type": "array",
            "description": "Declared Realm connectors this member's mission would plausibly use, each with a rationale (AgentDefinitionSpec.recommendedConnectorRefs). A recommendation, never a grant: it creates no connector grant, secret binding or activation. Each connectorRef must name a same-Realm ConnectorDefinition, refused otherwise.",
            "items": {
              "type": "object",
              "properties": {
                "connectorRef": {
                  "type": "object",
                  "properties": {
                    "kind": { "const": "ConnectorDefinition" },
                    "namespace": { "type": "string", "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*){1,7}$" },
                    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }
                  },
                  "required": ["kind", "namespace", "id"]
                },
                "rationale": { "type": "string", "minLength": 10 }
              },
              "required": ["connectorRef", "rationale"]
            }
          }
        },
        "required": ["roleRef", "role", "mission", "independenceGroup", "responsibilities",
          "requestedCapabilities", "taskClasses", "modalities", "minimumTokens", "reasoningEffort"]
      }
    }
  },
  "required": ["members"]
}
