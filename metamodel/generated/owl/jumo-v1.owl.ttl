jumo:SchemaBoundPayload a owl:Class ;
    rdfs:label "SchemaBoundPayload" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty jumo:payloadJson ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty jumo:payloadJson ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty jumo:validated ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty jumo:payloadDigest ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty jumo:validated ],
        [ a owl:Restriction ;
            owl:allValuesFrom jumo:SchemaBinding ;
            owl:onProperty jumo:schemaBinding ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty jumo:payloadDigest ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty jumo:schemaBinding ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty jumo:payloadJson ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty jumo:validated ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty jumo:schemaBinding ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty jumo:payloadDigest ] ;
    skos:definition "Bounded dynamic JSON payload guaranteed by a validated SchemaBinding." ;
    skos:inScheme <https://jumo.dev/schemas/jumo-v1> ;
    jumo:jumo.audience "REALM_PRIVATE" ;
    jumo:jumo.boundary_eligible true ;
    jumo:jumo.model_role "VALUE_OBJECT" ;
    jumo:jumo.schema_profiles "draft-2020-12,native-json-schema,prompted-json-validated" ;
    jumo:jumo.sensitivity "INTERNAL" ;
    jumo:jumo.state_authority "NONE" .

jumo:SelfDescriptionQuestion a owl:Class ;
    rdfs:label "SelfDescriptionQuestion" ;
    owl:unionOf ( <https://jumo.dev/schemas/jumo-v1/SelfDescriptionQuestion#PURPOSE> <https://jumo.dev/schemas/jumo-v1/SelfDescriptionQuestion#STATE> <https://jumo.dev/schemas/jumo-v1/SelfDescriptionQuestion#COMMITMENTS> <https://jumo.dev/schemas/jumo-v1/SelfDescriptionQuestion#CAPABILITIES> <https://jumo.dev/schemas/jumo-v1/SelfDescriptionQuestion#WAITING_ON> <https://jumo.dev/schemas/jumo-v1/SelfDescriptionQuestion#RECENT_CHANGES> <https://jumo.dev/schemas/jumo-v1/SelfDescriptionQuestion#RISKS> <https://jumo.dev/schemas/jumo-v1/SelfDescriptionQuestion#BOUNDARIES> ) ;
    skos:definition "Fixed vocabulary so every governed Project answers the same questions, and Nestor can federate the answers without bespoke integration per Project." ;
    skos:inScheme <https://jumo.dev/schemas/jumo-v1> ;
    linkml:permissible_values <https://jumo.dev/schemas/jumo-v1/SelfDescriptionQuestion#BOUNDARIES>,
        <https://jumo.dev/schemas/jumo-v1/SelfDescriptionQuestion#CAPABILITIES>,
        <https://jumo.dev/schemas/jumo-v1/SelfDescriptionQuestion#COMMITMENTS>,
        <https://jumo.dev/schemas/jumo-v1/SelfDescriptionQuestion#PURPOSE>,
        <https://jumo.dev/schemas/jumo-v1/SelfDescriptionQuestion#RECENT_CHANGES>,
        <https://jumo.dev/schemas/jumo-v1/SelfDescriptionQuestion#RISKS>,
        <https://jumo.dev/schemas/jumo-v1/SelfDescriptionQuestion#STATE>,
        <https://jumo.dev/schemas/jumo-v1/SelfDescriptionQuestion#WAITING_ON> .

