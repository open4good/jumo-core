    skos:definition "How a SUB_JOURNEY step opens its child run. Meaningless on any other stepKind." ;
    skos:inScheme <https://jumo.dev/schemas/jumo-v1> ;
    linkml:permissible_values <https://jumo.dev/schemas/jumo-v1/SubJourneyOpenMode#INLINE>,
        <https://jumo.dev/schemas/jumo-v1/SubJourneyOpenMode#MODAL> .

jumo:SufficiencyEscalationPolicy a owl:Class ;
    rdfs:label "SufficiencyEscalationPolicy" ;
    owl:unionOf ( <https://jumo.dev/schemas/jumo-v1/SufficiencyEscalationPolicy#NONE> <https://jumo.dev/schemas/jumo-v1/SufficiencyEscalationPolicy#AUTO_BOUNDED> ) ;
    skos:definition "A profile's disposition on an INSUFFICIENT_NEEDS_DEPTH signal (ADR-0019). NONE is the default: no automatic retry, the existing human-decision path applies. AUTO_BOUNDED retries the same invocation once at the next effort rung, never above the ladder's own ceiling and only while the declared ResourceBudget still has model-call budget for it -- otherwise it falls back to the same human-decision path as NONE." ;
    skos:inScheme <https://jumo.dev/schemas/jumo-v1> ;
    linkml:permissible_values <https://jumo.dev/schemas/jumo-v1/SufficiencyEscalationPolicy#AUTO_BOUNDED>,
        <https://jumo.dev/schemas/jumo-v1/SufficiencyEscalationPolicy#NONE> .

jumo:VariableTrust a owl:Class ;
    rdfs:label "VariableTrust" ;
    owl:unionOf ( <https://jumo.dev/schemas/jumo-v1/VariableTrust#TRUSTED> <https://jumo.dev/schemas/jumo-v1/VariableTrust#UNTRUSTED> ) ;
    skos:definition "UNTRUSTED carries content originating outside the trust boundary -- email bodies, web pages, transcripts, inbound channel messages. This is propagated provenance metadata, not by itself a security boundary (docs/concepts/positionnement-conceptuel.md#separation-instructions-donnees): the runtime fences these and never treats them as instructions, but authorization decisions are made on concrete argument values, not on this tag alone." ;
    skos:inScheme <https://jumo.dev/schemas/jumo-v1> ;
    linkml:permissible_values <https://jumo.dev/schemas/jumo-v1/VariableTrust#TRUSTED>,
        <https://jumo.dev/schemas/jumo-v1/VariableTrust#UNTRUSTED> .

