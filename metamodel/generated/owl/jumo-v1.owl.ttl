jumo:projectId a owl:DatatypeProperty ;
    rdfs:label "projectId" ;
    skos:inScheme <https://jumo.dev/schemas/jumo-v1> .

jumo:projectedToolAuthority a owl:DatatypeProperty ;
    rdfs:label "projectedToolAuthority" ;
    skos:definition "Tool capabilities are dynamically projected by the Jumo capability gateway via an invocation-scoped Streamable HTTP MCP endpoint based on explicit InvocationCapabilityGrants." ;
    skos:inScheme <https://jumo.dev/schemas/jumo-v1> .

