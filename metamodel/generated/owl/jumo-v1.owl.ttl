jumo:AppraisalDimension a owl:Class ;
    rdfs:label "AppraisalDimension" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty jumo:finding ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:string [ a rdfs:Datatype ;
                                owl:onDatatype xsd:string ;
                                owl:withRestrictions ( [ xsd:pattern "^.{10,}$" ] ) ] ) ] ;
            owl:onProperty jumo:finding ],
        [ a owl:Restriction ;
            owl:allValuesFrom jumo:AppraisalDimensionOutcome ;
            owl:onProperty jumo:outcome ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty jumo:finding ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty jumo:outcome ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty jumo:outcome ] ;
    skos:inScheme <https://jumo.dev/schemas/jumo-v1> ;
    jumo:jumo.audience "REALM_PRIVATE" ;
    jumo:jumo.boundary_eligible true ;
    jumo:jumo.model_role "VALUE_OBJECT" ;
    jumo:jumo.schema_profiles "draft-2020-12,native-json-schema,prompted-json-validated" ;
    jumo:jumo.sensitivity "INTERNAL" ;
    jumo:jumo.state_authority "GIT" .

jumo:AppraisalVerdict a owl:Class ;
    rdfs:label "AppraisalVerdict" ;
    owl:unionOf ( <https://jumo.dev/schemas/jumo-v1/AppraisalVerdict#ACCEPTED> <https://jumo.dev/schemas/jumo-v1/AppraisalVerdict#ACCEPTED_WITH_CONDITIONS> <https://jumo.dev/schemas/jumo-v1/AppraisalVerdict#REFUSED> ) ;
    skos:definition "REFUSED is kept rather than deleted so a second submission of the same artifact meets the reasoning that rejected the first." ;
    skos:inScheme <https://jumo.dev/schemas/jumo-v1> ;
    linkml:permissible_values <https://jumo.dev/schemas/jumo-v1/AppraisalVerdict#ACCEPTED>,
        <https://jumo.dev/schemas/jumo-v1/AppraisalVerdict#ACCEPTED_WITH_CONDITIONS>,
        <https://jumo.dev/schemas/jumo-v1/AppraisalVerdict#REFUSED> .

