    rdfs:comment "Network configuration for an ExecutionMachine." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path jumo:outboundControlUrl ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path jumo:macAddress ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path jumo:ipAllocation ],
        [ sh:datatype xsd:string ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path jumo:egressAllowlist ] ;
    sh:targetClass jumo:MachineNetworkConfig .

jumo:McpBundleArtifact a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path jumo:reference ;
            sh:pattern "^.{3,}$" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path jumo:digest ;
            sh:pattern "^sha256:[0-9a-f]{64}$" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path jumo:sbomRef ;
            sh:pattern "^.{3,}$" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path jumo:license ;
            sh:pattern "^.{2,}$" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path jumo:publisher ;
            sh:pattern "^.{2,}$" ],
        [ sh:datatype xsd:string ;
            sh:in ( "OCI" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path jumo:format ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path jumo:signatureRef ;
            sh:pattern "^.{3,}$" ] ;
    sh:targetClass jumo:McpBundleArtifact .

jumo:McpBundleOperation a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path jumo:id ;
            sh:pattern "^[a-z][a-z0-9-]*$" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path jumo:outputSchemaRef ;
            sh:pattern "^.{3,}$" ],
        [ sh:datatype xsd:string ;
            sh:description "Required in Rego when effect is SYSTEM_EFFECT and the bundle is ENABLED (ADR-0056 decision 3)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path jumo:recoveryPlanDigest ;
            sh:pattern "^sha256:[0-9a-f]{64}$" ],
        [ sh:datatype xsd:string ;
            sh:description "When to reach for this operation and when not to, written for the choosing agent." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path jumo:agentGuidance ;
            sh:pattern "^.{10,}$" ],
        [ sh:in ( "REQUIRED" "NOT_APPLICABLE" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 8 ;
            sh:path jumo:idempotency ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path jumo:inputSchemaRef ;
            sh:pattern "^.{3,}$" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path jumo:description ;
            sh:pattern "^.{10,}$" ],
        [ sh:in ( "REQUIRED" "NOT_REQUIRED" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 9 ;
            sh:path jumo:reconciliation ],
        [ sh:datatype xsd:string ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path jumo:secretBindingRefs ;
            sh:pattern "^[a-z][a-z0-9-]*$" ],
        [ sh:datatype xsd:boolean ;
            sh:description "Whether this operation returns content originating outside the trust boundary." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path jumo:untrustedOutput ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path jumo:capabilityRef ;
            sh:pattern "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9]*){1,3}$" ],
        [ sh:datatype xsd:string ;
            sh:description "Required in Rego when effect is SYSTEM_EFFECT and the bundle is ENABLED (ADR-0056 decision 4)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path jumo:killSwitchRef ;
            sh:pattern "^.{3,}$" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path jumo:exposedName ;
            sh:pattern "^.{3,}$" ],
        [ sh:datatype xsd:string ;
            sh:description "The raw MCP tool this semantic operation wraps. Never leaves this document -- there is no generic connector.invoke (ADR-0019, decision 161)." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path jumo:upstreamToolName ;
            sh:pattern "^.{1,}$" ],
        [ sh:in ( "READ_ONLY" "EXTERNAL_EFFECT" "SYSTEM_EFFECT" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 7 ;
            sh:path jumo:effect ] ;
    sh:targetClass jumo:McpBundleOperation .

jumo:McpBundleRuntime a sh:NodeShape ;
    rdfs:comment "An McpBundle's single upstream branch is always OCI_STDIO with a pinned artifact (McpBundleSpec.artifact); the STREAMABLE_HTTP branch has no bundle and is reached only through ConnectorDefinitionSpec.remoteMcpServiceRef and RemoteMcpServiceSpec.transport MCP_STREAMABLE_HTTP (ADR-0050 decisions 6-7)." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Not schema-required -- the pinned jumo-core sibling source only gains this field at its own pace; enforced unconditionally in Rego instead (corpus.bundle.upstream-kind-required), which reads the live composed corpus rather than a stale lock." ;
            sh:in ( "OCI_STDIO" ) ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path jumo:upstreamKind ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path jumo:entrypoint ;
            sh:pattern "^.{1,}$" ],
        [ sh:description "v2 admits only EXECUTION_CELL; CLIENT_CELL and REMOTE remain declarable at the schema level but are refused by corpus.bundle.execution-cell-only-placement (Rego, not schema) for the same reason." ;
            sh:in ( "CLIENT_CELL" "EXECUTION_CELL" "REMOTE" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 2 ;
            sh:path jumo:placement ],
        [ sh:datatype xsd:string ;
            sh:in ( "MCP" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path jumo:transport ] ;
    sh:targetClass jumo:McpBundleRuntime .

jumo:McpBundleSemanticProfile a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path jumo:purpose ;
            sh:pattern "^.{10,}$" ],
        [ sh:class jumo:McpBundleOperation ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path jumo:operations ],
        [ sh:in ( "PUBLISHED_SUMMARY" "TYPED_ATTENTION_ONLY" "PROJECT_SCOPED" "REALM_PRIVATE" "ORGANIZATION_ONLY" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 1 ;
            sh:path jumo:dataScope ] ;
    sh:targetClass jumo:McpBundleSemanticProfile .

jumo:McpBundleSpec a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:in ( "JUMO_REVIEWED" "PROVIDER_TRUSTED" "CLIENT_QUARANTINED" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 2 ;
            sh:path jumo:trustClass ],
        [ sh:class jumo:McpBundleRuntime ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path jumo:runtime ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path jumo:ownerRealm ;
            sh:pattern "^[a-z][a-z0-9-]*$" ],
        [ sh:class jumo:ContractReference ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path jumo:connectorPackageRef ],
        [ sh:in ( "DECLARED" "REVIEWED" "ENABLED" "SUSPENDED" "RETIRED" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 1 ;
            sh:path jumo:lifecycle ],
        [ sh:class jumo:McpBundleArtifact ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path jumo:artifact ],
        [ sh:class jumo:McpBundleSemanticProfile ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path jumo:semanticProfile ] ;
    sh:targetClass jumo:McpBundleSpec .

jumo:McpCatalogProvenancePin a sh:NodeShape ;
    rdfs:comment "Immutable source observation pin carried into generated connector material; it is evidence, never authority." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path jumo:externalVersion ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path jumo:observationChecksum ;
            sh:pattern "^sha256:[0-9a-f]{64}$" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path jumo:externalId ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path jumo:sourceId ;
            sh:pattern "^[a-z][a-z0-9-]*$" ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path jumo:observedAt ] ;
    sh:targetClass jumo:McpCatalogProvenancePin .

jumo:McpRegistrySourceBindingSpec a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class jumo:ContractReference ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path jumo:workOrderRef ],
        [ sh:class jumo:ContractReference ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path jumo:executionMachineRef ],
        [ sh:class jumo:ContractReference ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path jumo:mcpRegistrySourceRef ],
        [ sh:in ( "ENABLED" "DISABLED" "BLOCKED" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 3 ;
            sh:path jumo:lifecycle ],
        [ sh:class jumo:ContractReference ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path jumo:roleDefinitionRef ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path jumo:ownerRealm ;
            sh:pattern "^[a-z][a-z0-9-]*$" ] ;
    sh:targetClass jumo:McpRegistrySourceBindingSpec .

jumo:McpRegistrySourceSpec a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:in ( "FULL_THEN_INCREMENTAL" "ENRICHMENT_ONLY" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 3 ;
            sh:path jumo:syncMode ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path jumo:jitter ;
            sh:pattern "^P(?!$)(\\d+Y)?(\\d+M)?(\\d+D)?(T(?=\\d)(\\d+H)?(\\d+M)?(\\d+S)?)?$" ],
        [ sh:description "Platform-declared default lifecycle. A Realm's McpRegistrySourceBinding.lifecycle is the live, Realm-scoped selection and may differ." ;
            sh:in ( "ENABLED" "DISABLED" "BLOCKED" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 6 ;
            sh:path jumo:lifecycle ],
        [ sh:class jumo:ContractReference ;
            sh:description "No longer required (decision AC1) -- attribution for a new binding belongs on McpRegistrySourceBinding." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path jumo:workOrderRef ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path jumo:cadence ;
            sh:pattern "^P(?!$)(\\d+Y)?(\\d+M)?(\\d+D)?(T(?=\\d)(\\d+H)?(\\d+M)?(\\d+S)?)?$" ],
        [ sh:in ( "OFFICIAL_REGISTRY" "GITHUB_ENRICHMENT" "GLAMA" "SMITHERY" "PULSE_MCP" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 0 ;
            sh:path jumo:sourceType ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path jumo:adapter ;
            sh:pattern "^.{3,}$" ],
        [ sh:class jumo:ContractReference ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 9 ;
            sh:path jumo:secretBindingRef ],
        [ sh:class jumo:ContractReference ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 10 ;
            sh:path jumo:termsApprovalRef ],
        [ sh:class jumo:ContractReference ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path jumo:roleDefinitionRef ],
        [ sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path jumo:baseUrlAllowlist ;
            sh:pattern "^https://.+$" ] ;
    sh:targetClass jumo:McpRegistrySourceSpec .

jumo:McpServerDescriptor a sh:NodeShape ;
    rdfs:comment "Descriptor specifying MCP server transport and connection target." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path jumo:ociImage ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path jumo:sourceCommitSha ],
        [ sh:in ( "STREAMABLE_HTTP" "STDIO_OCI" "STDIO_SOURCE" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 0 ;
            sh:path jumo:transport ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path jumo:endpointUrl ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path jumo:sourceRepository ],
        [ sh:datatype xsd:boolean ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path jumo:tlsRequired ] ;
    sh:targetClass jumo:McpServerDescriptor .

jumo:McpToolDescriptor a sh:NodeShape ;
    rdfs:comment "Tool schema and metadata captured during MCP discovery." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class jumo:SchemaBoundPayload ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path jumo:outputSchema ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path jumo:name ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path jumo:description ],
        [ sh:class jumo:SchemaBoundPayload ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path jumo:inputSchema ],
        [ sh:datatype xsd:string ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path jumo:annotations ] ;
    sh:targetClass jumo:McpToolDescriptor .

jumo:MethodologySource a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path jumo:name ;
            sh:pattern "^.{2,}$" ],
        [ sh:in ( "INSPIRED" "MAPPED" "CONFORMANT" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 1 ;
            sh:path jumo:complianceLevel ] ;
    sh:targetClass jumo:MethodologySource .

jumo:Milestone a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:integer ;
            sh:description "Delivery order. Breaks ties when two milestones would otherwise sort ambiguously; the generated roadmap groups in this order, not declaration order." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:minInclusive 0 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path jumo:order ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path jumo:id ;
            sh:pattern "^[a-z][a-z0-9-]*$" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path jumo:exitCondition ;
            sh:pattern "^.{10,}$" ] ;
    sh:targetClass jumo:Milestone .

jumo:ModuleDigestEntry a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path jumo:digest ;
            sh:pattern "^sha256:[0-9a-f]{64}$" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path jumo:moduleId ] ;
    sh:targetClass jumo:ModuleDigestEntry .

jumo:NotificationPreferences a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:boolean ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path jumo:quietHoursEnabled ],
        [ sh:datatype xsd:boolean ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path jumo:focusMode ],
        [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:maxInclusive 100 ;
            sh:minInclusive 0 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path jumo:maximumConcurrentSolicitations ],
        [ sh:class jumo:QuietHoursWindow ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path jumo:quietHours ],
        [ sh:in ( "MANDALA" "WEB_PUSH" "EMAIL" "WEBCHAT" "WHATSAPP" "SMS" "TELEPHONY" "STENTOR" ) ;
            sh:order 1 ;
            sh:path jumo:channels ],
        [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:maxInclusive 604800 ;
            sh:minInclusive 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path jumo:escalationDelaySeconds ],
        [ sh:in ( "PUBLISHED_SUMMARY" "TYPED_ATTENTION_ONLY" "PROJECT_SCOPED" "REALM_PRIVATE" "ORGANIZATION_ONLY" ) ;
            sh:maxCount 1 ;
            sh:order 2 ;
            sh:path jumo:classificationCeiling ],
        [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:maxInclusive 604800 ;
            sh:minInclusive 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path jumo:fallbackDelaySeconds ],
        [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:maxInclusive 100 ;
            sh:minInclusive 0 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path jumo:maximumLiveInterruptionsPerHour ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path jumo:timeZone ;
            sh:pattern "^.{1,}$" ] ;
    sh:targetClass jumo:NotificationPreferences .

jumo:OAuthClientBindingSpec a sh:NodeShape ;
    rdfs:comment "Specification for an OAuthClientBinding contract." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path jumo:authEndpoint ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path jumo:clientId ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path jumo:ownership ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path jumo:ownerRealm ;
            sh:pattern "^[a-z][a-z0-9-]*$" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
