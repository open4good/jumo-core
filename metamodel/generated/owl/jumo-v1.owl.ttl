    rdfs:label "outputBinding" ;
    skos:inScheme <https://jumo.dev/schemas/jumo-v1> .

jumo:outputType a owl:DatatypeProperty ;
    rdfs:label "outputType" ;
    skos:inScheme <https://jumo.dev/schemas/jumo-v1> .

