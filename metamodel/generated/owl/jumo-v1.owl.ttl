    rdfs:label "overage" ;
    skos:inScheme <https://jumo.dev/schemas/jumo-v1> .

jumo:overrides a owl:ObjectProperty ;
    rdfs:label "overrides" ;
    skos:inScheme <https://jumo.dev/schemas/jumo-v1> .

