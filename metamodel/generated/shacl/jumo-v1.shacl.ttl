jumo:EvidenceProfileSpec a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path jumo:method ],
        [ sh:class jumo:DataProtectionImpactAssessment ;
            sh:description "RGPD art. 35 impact assessment, when this evidence profile concerns personal data processing." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 10 ;
            sh:path jumo:dpia ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path jumo:evidenceType ;
            sh:pattern "^.{2,}$" ],
        [ sh:in ( "NONE" "SELF_REPORTED" "OBSERVED" "INDEPENDENTLY_VERIFIED" ) ;
            sh:maxCount 1 ;
            sh:order 4 ;
            sh:path jumo:requiredIndependence ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path jumo:sourceDependence ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path jumo:ownerRealm ;
            sh:pattern "^[a-z][a-z0-9-]*$" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path jumo:source ;
            sh:pattern "^.{2,}$" ],
        [ sh:datatype xsd:string ;
            sh:description "What claim this evidence class actually supports: provenance volume alone is not proof (docs/concepts/positionnement-conceptuel.md#preuve-et-assurance)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path jumo:claimCoverage ],
        [ sh:datatype xsd:string ;
            sh:description "Known conditions that would invalidate this evidence class." ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path jumo:defeaters ],
        [ sh:datatype xsd:string ;
            sh:description "How long this evidence must be kept, explicit rather than left implicit." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path jumo:retention ;
            sh:pattern "^P(?!$)(\\d+Y)?(\\d+M)?(\\d+D)?(T(?=\\d)(\\d+H)?(\\d+M)?(\\d+S)?)?$" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path jumo:requiredFreshness ;
            sh:pattern "^P(?!$)(\\d+Y)?(\\d+M)?(\\d+D)?(T(?=\\d)(\\d+H)?(\\d+M)?(\\d+S)?)?$" ] ;
    sh:targetClass jumo:EvidenceProfileSpec .

jumo:ExecutionCellIdentity a sh:NodeShape ;
