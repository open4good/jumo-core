jumo:RealmTemplate a sh:NodeShape ;
    rdfs:comment "A Realm is a governance, privacy and security boundary. Spheres group work inside a Realm without being security boundaries (canonical decision 12). `ingress` is the same shape one level up, for DNS instead of workspace grouping: `RealmIngressBinding` carries no audience, policy, capability or other authority-bearing attribute, so a subdomain stays routing only by construction, never a security boundary -- `enforcement` on this same spec remains the only field that is." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:in ( "jumo.dev/v1" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path jumo:apiVersion ],
        [ sh:class jumo:RealmTemplateSpec ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path jumo:spec ],
        [ sh:datatype xsd:string ;
            sh:in ( "RealmTemplate" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path jumo:kind ],
        [ sh:class jumo:Metadata ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path jumo:metadata ] ;
    sh:targetClass jumo:RealmTemplate .

