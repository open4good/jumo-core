            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path jumo:metadata ] ;
    sh:targetClass jumo:MachineHostDefinition .

jumo:MachineRuntimeInstallation a sh:NodeShape ;
