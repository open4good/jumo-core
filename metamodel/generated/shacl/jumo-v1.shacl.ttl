            sh:order 1 ;
            sh:path jumo:kind ],
        [ sh:datatype xsd:string ;
            sh:in ( "jumo.dev/v1" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path jumo:apiVersion ] ;
    sh:targetClass jumo:ProcessSpec .

jumo:Project a sh:NodeShape ;
    rdfs:comment "A governed body of work declared in a Realm control repository. Git repositories are optional bound resources, not the identity of a Project." ;
