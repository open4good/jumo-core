jumo:SchemaBinding a owl:Class ;
    rdfs:label "SchemaBinding" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty jumo:schemaVersion ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty jumo:schemaId ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty jumo:schemaVersion ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty jumo:modelClass ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty jumo:profile ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty jumo:modelClass ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty jumo:schemaDigest ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty jumo:schemaDigest ],
        [ a owl:Restriction ;
            owl:allValuesFrom jumo:SchemaProfile ;
            owl:onProperty jumo:profile ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty jumo:modelClass ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty jumo:schemaVersion ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty jumo:schemaId ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty jumo:schemaId ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty jumo:profile ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty jumo:schemaDigest ] ;
    skos:definition "Deterministic link between a payload, its LinkML class, and exact schema digest." ;
    skos:inScheme <https://jumo.dev/schemas/jumo-v1> ;
    jumo:jumo.audience "REALM_PRIVATE" ;
    jumo:jumo.boundary_eligible true ;
    jumo:jumo.model_role "VALUE_OBJECT" ;
    jumo:jumo.schema_profiles "draft-2020-12,native-json-schema,prompted-json-validated" ;
    jumo:jumo.sensitivity "INTERNAL" ;
    jumo:jumo.state_authority "NONE" .

