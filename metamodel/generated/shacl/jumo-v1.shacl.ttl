    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:in ( "ENABLED" "DISABLED" "BLOCKED" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 1 ;
