    rdfs:label "allowedRealms" ;
    skos:inScheme <https://jumo.dev/schemas/jumo-v1> .

jumo:allowedRemoteMcpServiceRefs a owl:ObjectProperty ;
    rdfs:label "allowedRemoteMcpServiceRefs" ;
    skos:inScheme <https://jumo.dev/schemas/jumo-v1> .

