            sh:order 8 ;
            sh:path jumo:expiresAt ],
        [ sh:datatype xsd:string ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path jumo:grantedScopes ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path jumo:realmRef ],
        [ sh:datatype xsd:string ;
