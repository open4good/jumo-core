jumo:SharedRepositoryApprovalPolicy a owl:Class ;
    rdfs:label "SharedRepositoryApprovalPolicy" ;
    owl:unionOf ( <https://jumo.dev/schemas/jumo-v1/SharedRepositoryApprovalPolicy#OWNER_ONLY> <https://jumo.dev/schemas/jumo-v1/SharedRepositoryApprovalPolicy#MUTUAL_CONSENT> ) ;
    skos:definition "Who must approve a forge-write against a shared repository binding. OWNER_ONLY applies when a single Realm owns the binding. MUTUAL_CONSENT blocks merge until all co-owner Realms have acknowledged." ;
    skos:inScheme <https://jumo.dev/schemas/jumo-v1> ;
    linkml:permissible_values <https://jumo.dev/schemas/jumo-v1/SharedRepositoryApprovalPolicy#MUTUAL_CONSENT>,
        <https://jumo.dev/schemas/jumo-v1/SharedRepositoryApprovalPolicy#OWNER_ONLY> .

