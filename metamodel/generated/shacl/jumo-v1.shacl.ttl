jumo:EntityFacet a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:in ( "Realm" "Agent" "ChangeProposal" "ForgeProjection" "Evidence" "AttentionItem" "Team" "WorkOrder" "ExecutionMachine" "CliTool" "ConnectorPackage" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 0 ;
            sh:path jumo:entity ],
        [ sh:datatype xsd:boolean ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
