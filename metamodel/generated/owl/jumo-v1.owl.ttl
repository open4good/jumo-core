jumo:EffectRecoveryKind a owl:Class ;
    rdfs:label "EffectRecoveryKind" ;
    owl:unionOf ( <https://jumo.dev/schemas/jumo-v1/EffectRecoveryKind#RETRY> <https://jumo.dev/schemas/jumo-v1/EffectRecoveryKind#DEDUPLICATION> <https://jumo.dev/schemas/jumo-v1/EffectRecoveryKind#COMPENSATION> <https://jumo.dev/schemas/jumo-v1/EffectRecoveryKind#CORRECTION> <https://jumo.dev/schemas/jumo-v1/EffectRecoveryKind#RECONCILIATION> <https://jumo.dev/schemas/jumo-v1/EffectRecoveryKind#EXPIRY_WINDOW> <https://jumo.dev/schemas/jumo-v1/EffectRecoveryKind#RESIDUAL_HARM> ) ;
