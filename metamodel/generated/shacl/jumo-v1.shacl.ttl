        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path jumo:protocolVersion ] ;
    sh:targetClass jumo:McpInventorySnapshot .

