    skos:definition "The CLI a worker substrate runs. Shared vocabulary -- a WorkerSubstrate declares which one it runs (integration) and a CliToolDefinition declares which one it implements (execution), so neither module has to import the other and no naming convention links a tool to a value." ;
    skos:inScheme <https://jumo.dev/schemas/jumo-v1> ;
    linkml:permissible_values <https://jumo.dev/schemas/jumo-v1/WorkerCli#CLAUDE_CODE>,
        <https://jumo.dev/schemas/jumo-v1/WorkerCli#CODEX>,
        <https://jumo.dev/schemas/jumo-v1/WorkerCli#COPILOT_CLI>,
        <https://jumo.dev/schemas/jumo-v1/WorkerCli#GEMINI_CLI> .

