    skos:inScheme <https://jumo.dev/schemas/jumo-v1> .

jumo:decisionOptions a owl:ObjectProperty ;
    rdfs:label "decisionOptions" ;
    skos:inScheme <https://jumo.dev/schemas/jumo-v1> .

