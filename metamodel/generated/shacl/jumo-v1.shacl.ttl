jumo:ConnectorIntentProposal a sh:NodeShape ;
    rdfs:comment "Structured output of a DIALOGUE_COLLECT step capturing what connectors the assistant proposes in response to the user's stated intent (AssistedJourneyStep.promptRef, PromptOutput form: STRUCTURED). A proposal, never a grant or a configuration: selectedConnectorRefs must be drawn only from the realm's declared ConnectorDefinition catalog supplied as the prompt's RAG context (the same corpus ContractLoader loads for CapabilityGatewayService), never invented by the model. The user still confirms selection explicitly; this class only bounds what the model may say back." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class jumo:ContractReference ;
            sh:description "ConnectorDefinition ids proposed, referencing the supplied catalog only." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path jumo:selectedConnectorDefinitionRefs ],
        [ sh:class jumo:ConnectorIntentRationale ;
            sh:description "One entry per selectedConnectorRefs, explaining the match to the stated intent." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path jumo:rationale ],
        [ sh:datatype xsd:string ;
            sh:description "A clarifying question to continue the dialogue when intent is still ambiguous. Absent once the proposal is considered final for this turn." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path jumo:openQuestion ] ;
    sh:targetClass jumo:ConnectorIntentProposal .

jumo:ConnectorPackage a sh:NodeShape ;
    rdfs:comment "Platform-only Git contract manifest defining a complete connector package under .jumo/connector-packages/<id>/. Publication in the Platform corpus is a technical-reuse fact and confers no Realm consent, secret or activation authority (ADR-0050 decision 8)." ;
