    skos:definition "Whether this document states rules. Travels with every chunk: a retriever may quote a false document as explanation and never as authority (ADR-0005 applied to retrieval)." ;
    skos:inScheme <https://jumo.dev/schemas/jumo-v1> .

jumo:notifications a owl:ObjectProperty ;
    rdfs:label "notifications" ;
    skos:inScheme <https://jumo.dev/schemas/jumo-v1> .

jumo:oauthSecretBindingRef a owl:ObjectProperty ;
    rdfs:label "oauthSecretBindingRef" ;
    skos:inScheme <https://jumo.dev/schemas/jumo-v1> .

jumo:observationProvenance a owl:ObjectProperty ;
    rdfs:label "observationProvenance" ;
    skos:inScheme <https://jumo.dev/schemas/jumo-v1> .

jumo:occurredAt a owl:DatatypeProperty ;
    rdfs:label "occurredAt" ;
    skos:inScheme <https://jumo.dev/schemas/jumo-v1> .

jumo:of a owl:DatatypeProperty ;
    rdfs:label "of" ;
    skos:definition "A generated LinkML class name (metamodel/generated/manifest.json), the same pattern ProcessFlow.payloadType and ProcessStep.signalType use. Must name a declared class (Rego). Mutually exclusive with payloadSchemaRef; exactly one of the two is required (Rego) -- a payload either has a generated class or it does not, never both." ;
    skos:inScheme <https://jumo.dev/schemas/jumo-v1> .

jumo:officialUri a owl:DatatypeProperty ;
    rdfs:label "officialUri" ;
    skos:definition "Stable URI to the official referential. No copyrighted text is stored here." ;
    skos:inScheme <https://jumo.dev/schemas/jumo-v1> .

jumo:oidcRealm a owl:DatatypeProperty ;
    rdfs:label "oidcRealm" ;
    skos:inScheme <https://jumo.dev/schemas/jumo-v1> .

jumo:oidcSubject a owl:DatatypeProperty ;
    rdfs:label "oidcSubject" ;
    skos:inScheme <https://jumo.dev/schemas/jumo-v1> .

jumo:onInsufficiency a owl:ObjectProperty ;
    rdfs:label "onInsufficiency" ;
    skos:definition "How this profile responds to its own worker's INSUFFICIENT_NEEDS_DEPTH signal (ADR-0019, worker-sufficiency-bounded-escalation). Absent defaults to NONE -- most profiles take the existing human-decision path rather than an automatic bounded retry." ;
    skos:inScheme <https://jumo.dev/schemas/jumo-v1> .

jumo:onInsufficientInformation a owl:DatatypeProperty ;
    rdfs:label "onInsufficientInformation" ;
    skos:inScheme <https://jumo.dev/schemas/jumo-v1> .

jumo:onboarding a owl:ObjectProperty ;
    rdfs:label "onboarding" ;
    skos:inScheme <https://jumo.dev/schemas/jumo-v1> .

jumo:opaEntrypoint a owl:DatatypeProperty ;
    rdfs:label "opaEntrypoint" ;
    skos:definition "Required on a GATEWAY step (Rego): the Rego rule the ProcessSpec compiler wires as the decision selecting this gateway's outgoing branch." ;
    skos:inScheme <https://jumo.dev/schemas/jumo-v1> .

jumo:openBao a owl:ObjectProperty ;
    rdfs:label "openBao" ;
    skos:inScheme <https://jumo.dev/schemas/jumo-v1> .

jumo:openBaoAccessorDigest a owl:DatatypeProperty ;
    rdfs:label "openBaoAccessorDigest" ;
    skos:inScheme <https://jumo.dev/schemas/jumo-v1> .

jumo:openQuestion a owl:DatatypeProperty ;
    rdfs:label "openQuestion" ;
    skos:definition "A clarifying question to continue the dialogue when intent is still ambiguous. Absent once the proposal is considered final for this turn." ;
    skos:inScheme <https://jumo.dev/schemas/jumo-v1> .

jumo:optInRequired a owl:DatatypeProperty ;
    rdfs:label "optInRequired" ;
    skos:inScheme <https://jumo.dev/schemas/jumo-v1> .

jumo:optionsFrom a owl:DatatypeProperty ;
    rdfs:label "optionsFrom" ;
    skos:definition "A contract kind whose declared instances populate this field's options, replacing a hardcoded roster lookup with a projection over real Git contracts. Must name a declared kind (Rego). An instance is offered as its `metadata.id` labelled by its `metadata.name`; a projection selects which instances are offered, never how one is addressed. Mutually exclusive with optionsFromEnum and optionsFromNested (Rego)." ;
    skos:inScheme <https://jumo.dev/schemas/jumo-v1> .

jumo:optionsFromEnum a owl:DatatypeProperty ;
    rdfs:label "optionsFromEnum" ;
    skos:definition "A generated LinkML enumeration whose permissible values populate this field's options, for a field whose domain is a closed vocabulary rather than a contract kind. Mutually exclusive with optionsFrom and optionsFromNested (Rego). Rego checks that an ENUMERATION field declares one of the three, not that this names an enumeration rather than a class: the repository facts carry per-class slots, not permissible values, so the narrower check waits on a fact this module does not produce." ;
    skos:inScheme <https://jumo.dev/schemas/jumo-v1> .

jumo:optionsFromNested a owl:ObjectProperty ;
    rdfs:label "optionsFromNested" ;
    skos:definition "An alternative to optionsFrom for a value object with no standalone Git contract of its own, such as Project.spec.milestones -- see NestedOptionsSource. Mutually exclusive with optionsFrom and optionsFromEnum (Rego)." ;
    skos:inScheme <https://jumo.dev/schemas/jumo-v1> .

jumo:organizationTemplateRef a owl:ObjectProperty ;
    rdfs:label "organizationTemplateRef" ;
    skos:definition "Optional OrganizationTemplate this organization was instantiated from." ;
    skos:inScheme <https://jumo.dev/schemas/jumo-v1> .

jumo:origin a owl:ObjectProperty ;
    rdfs:label "origin" ;
    skos:inScheme <https://jumo.dev/schemas/jumo-v1> .

jumo:osName a owl:DatatypeProperty ;
    rdfs:label "osName" ;
    skos:inScheme <https://jumo.dev/schemas/jumo-v1> .

jumo:osVersion a owl:DatatypeProperty ;
    rdfs:label "osVersion" ;
    skos:inScheme <https://jumo.dev/schemas/jumo-v1> .

jumo:otherwise a owl:DatatypeProperty ;
    rdfs:label "otherwise" ;
    skos:inScheme <https://jumo.dev/schemas/jumo-v1> .

jumo:outboundControlUrl a owl:DatatypeProperty ;
    rdfs:label "outboundControlUrl" ;
    skos:inScheme <https://jumo.dev/schemas/jumo-v1> .

jumo:output a owl:ObjectProperty ;
    rdfs:label "output" ;
    skos:inScheme <https://jumo.dev/schemas/jumo-v1> .

