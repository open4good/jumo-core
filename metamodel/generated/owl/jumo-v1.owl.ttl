            owl:onProperty jumo:id ],
        [ a owl:Restriction ;
            owl:allValuesFrom jumo:ContractReference ;
            owl:onProperty jumo:subprocessReleaseRef ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty jumo:terminalState ],
        [ a owl:Restriction ;
            owl:allValuesFrom jumo:Ring ;
            owl:onProperty jumo:ring ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:integer [ a rdfs:Datatype ;
                                owl:onDatatype xsd:integer ;
                                owl:withRestrictions ( [ xsd:minInclusive 1 ] ) ] [ a rdfs:Datatype ;
