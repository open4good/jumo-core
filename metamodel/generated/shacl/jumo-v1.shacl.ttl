jumo:ImprovementCeilings a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:boolean ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path jumo:mayRaiseCorpusCeiling ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path jumo:recommendationExpiry ;
            sh:pattern "^P(?!$)(\\d+Y)?(\\d+M)?(\\d+D)?(T(?=\\d)(\\d+H)?(\\d+M)?(\\d+S)?)?$" ],
        [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:maxInclusive 50 ;
            sh:minCount 1 ;
            sh:minInclusive 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path jumo:maximumOpenRecommendations ] ;
    sh:targetClass jumo:ImprovementCeilings .

jumo:ImprovementLoopSpec a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:in ( "CLARIFICATION_TURNS_USED" "WORK_DECLINE_RATE" "BUDGET_CONSUMPTION_RATIO" "ASSURANCE_SHORTFALL" "DOCUMENT_STALENESS" "MISSING_COMPLETION_EVIDENCE" "SUPERSESSION_COUNT" "CAPTURE_TO_COMPLETION_ELAPSED" "CORPUS_BUDGET_HEADROOM" "NON_NORMATIVE_CITATION_RATE" "ATTENTION_ACTED_ON_RATIO" ) ;
            sh:minCount 1 ;
            sh:order 3 ;
            sh:path jumo:measures ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path jumo:purpose ;
            sh:pattern "^.{10,}$" ],
        [ sh:class jumo:ContractReference ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path jumo:synthesisPracticeRef ],
        [ sh:class jumo:ImprovementTarget ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path jumo:targets ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path jumo:ownerRealm ;
            sh:pattern "^[a-z][a-z0-9-]*$" ],
        [ sh:class jumo:ContractReference ;
            sh:description "One loop never reaches across Projects; that would be a delegation, not a rhythm." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path jumo:projectRef ],
        [ sh:class jumo:ContractReference ;
            sh:description "Optional explicit ProcessSpec (execution.yaml)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path jumo:assessmentProcessSpecRef ],
        [ sh:class jumo:ImprovementCeilings ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path jumo:ceilings ] ;
    sh:targetClass jumo:ImprovementLoopSpec .

jumo:ImprovementObservation a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path jumo:value ;
            sh:pattern "^.{1,}$" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path jumo:measure ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path jumo:evidenceRef ;
            sh:pattern "^.{1,}$" ] ;
    sh:targetClass jumo:ImprovementObservation .

jumo:ImprovementRecommendationSpec a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path jumo:raisedAt ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path jumo:targetPath ;
            sh:pattern "^[A-Za-z0-9._-]+(/[A-Za-z0-9._-]+)*$" ],
        [ sh:in ( "ADD" "CONSOLIDATE" "CORRECT" "DELETE" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 4 ;
            sh:path jumo:direction ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path jumo:supersededBy ;
            sh:pattern "^[a-z][a-z0-9-]*$" ],
        [ sh:class jumo:ContractReference ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path jumo:improvementLoopRef ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path jumo:finding ;
            sh:pattern "^.{20,}$" ],
        [ sh:class jumo:ImprovementObservation ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path jumo:observedFrom ],
        [ sh:in ( "OPEN" "ACCEPTED" "REJECTED" "SUPERSEDED" "EXPIRED" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 5 ;
            sh:path jumo:state ],
        [ sh:in ( "NOT_A_PROBLEM" "ALREADY_ADDRESSED" "OUT_OF_SCOPE" "INSUFFICIENT_EVIDENCE" "DEFERRED_BY_OWNER" ) ;
            sh:maxCount 1 ;
            sh:order 6 ;
            sh:path jumo:rejectReason ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path jumo:changeProposalRef ;
            sh:pattern "^.{1,}$" ] ;
    sh:targetClass jumo:ImprovementRecommendationSpec .

jumo:ImprovementTarget a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "RING_0_ROOT_OF_TRUST exclusion moves to Rego." ;
            sh:in ( "RING_0_ROOT_OF_TRUST" "RING_1_CONTROL_PLANE" "RING_2_AGENT_BEHAVIOR" "RING_3_GOVERNED_PROJECT" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 1 ;
            sh:path jumo:ring ],
        [ sh:in ( "STEP_UP_AUTHENTICATION" "HUMAN_OWNER_APPROVAL" "INDEPENDENT_VERIFICATION" "DISCLOSE_AGENT_IDENTITY" "RETAIN_PROVENANCE" "REDACT_SECRETS" "PREVIEW_BEFORE_SEND" ) ;
            sh:minCount 1 ;
            sh:order 5 ;
            sh:path jumo:requiredObligations ],
        [ sh:datatype xsd:string ;
            sh:description "Required when autonomy is BOUNDED_AUTONOMOUS (Rego)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path jumo:mergeCapabilityRef ;
            sh:pattern "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9]*){1,3}$" ],
        [ sh:datatype xsd:string ;
            sh:description "Path-traversal exclusion (`not: pattern ..\\/`) moves to Rego." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path jumo:pathGlob ;
            sh:pattern "^[A-Za-z0-9._*-]+(/[A-Za-z0-9._*-]+)*$" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path jumo:capabilityRef ;
            sh:pattern "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9]*){1,3}$" ],
        [ sh:in ( "OBSERVE" "DRAFT" "SUPERVISED" "BOUNDED_AUTONOMOUS" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 3 ;
            sh:path jumo:autonomy ] ;
    sh:targetClass jumo:ImprovementTarget .

jumo:InterfaceSurfaceSpec a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class jumo:EntityFacet ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path jumo:facets ],
        [ sh:datatype xsd:string ;
