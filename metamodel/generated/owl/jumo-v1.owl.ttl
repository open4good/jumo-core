jumo:dependsOnWorkOrderRefs a owl:ObjectProperty ;
    rdfs:label "dependsOnWorkOrderRefs" ;
    skos:definition "WorkOrders that must be COMPLETED before this one starts." ;
    skos:inScheme <https://jumo.dev/schemas/jumo-v1> .

jumo:dialogueOptions a owl:ObjectProperty ;
    rdfs:label "dialogueOptions" ;
    skos:inScheme <https://jumo.dev/schemas/jumo-v1> .

jumo:dispositionRules a owl:ObjectProperty ;
    rdfs:label "dispositionRules" ;
    skos:inScheme <https://jumo.dev/schemas/jumo-v1> .

jumo:effortLadder a owl:ObjectProperty ;
    rdfs:label "effortLadder" ;
    skos:definition "Overrides the platform's defaultEffortLadder rung for rung when declared. Absent by default, so a newly declared account inherits the platform's ladder and is routable immediately -- the fix for the N-times-M dead account problem a per-account requirementAliases list produced." ;
    skos:inScheme <https://jumo.dev/schemas/jumo-v1> .

jumo:egressAllowlist a owl:DatatypeProperty ;
    rdfs:label "egressAllowlist" ;
    skos:inScheme <https://jumo.dev/schemas/jumo-v1> .

jumo:eligibleRoleDefinitionRefs a owl:ObjectProperty ;
    rdfs:label "eligibleRoleDefinitionRefs" ;
    skos:inScheme <https://jumo.dev/schemas/jumo-v1> .

jumo:eligibleTeamSpecRefs a owl:ObjectProperty ;
    rdfs:label "eligibleTeamSpecRefs" ;
    skos:inScheme <https://jumo.dev/schemas/jumo-v1> .

jumo:emissionBundle a owl:ObjectProperty ;
    rdfs:label "emissionBundle" ;
    skos:definition "The atomic same-repository alternative to emission: an ordered list of documents one run writes together, each reusing AssistedJourneyEmission unchanged and optionally fanning out over a collected collection field or gated by an equality condition. Runtime path resolution and atomic intake are a later lot; this vocabulary only." ;
    skos:inScheme <https://jumo.dev/schemas/jumo-v1> .

jumo:enabledAdapters a owl:ObjectProperty ;
    rdfs:label "enabledAdapters" ;
    skos:inScheme <https://jumo.dev/schemas/jumo-v1> .

jumo:entries a owl:ObjectProperty ;
    rdfs:label "entries" ;
    skos:inScheme <https://jumo.dev/schemas/jumo-v1> .

jumo:errorCodes a owl:DatatypeProperty ;
    rdfs:label "errorCodes" ;
    skos:inScheme <https://jumo.dev/schemas/jumo-v1> .

jumo:evaluationCriteria a owl:DatatypeProperty ;
    rdfs:label "evaluationCriteria" ;
    skos:inScheme <https://jumo.dev/schemas/jumo-v1> .

jumo:facets a owl:ObjectProperty ;
    rdfs:label "facets" ;
    skos:inScheme <https://jumo.dev/schemas/jumo-v1> .

jumo:facts a owl:ObjectProperty ;
    rdfs:label "facts" ;
    skos:inScheme <https://jumo.dev/schemas/jumo-v1> .

jumo:federationProfileRefs a owl:ObjectProperty ;
    rdfs:label "federationProfileRefs" ;
    skos:inScheme <https://jumo.dev/schemas/jumo-v1> .

jumo:fieldConditions a owl:ObjectProperty ;
    rdfs:label "fieldConditions" ;
    skos:definition "Fields the emitted document carries only under a declared condition. A template drops a key whose lone placeholder resolves to nothing, so a conditional key needs no template conditional of its own -- the condition removes the value and the existing absence rule removes the key. Applied after fieldDefaults, so a default never resurrects a field the condition has removed." ;
    skos:inScheme <https://jumo.dev/schemas/jumo-v1> .

jumo:fieldDefaults a owl:ObjectProperty ;
    rdfs:label "fieldDefaults" ;
    skos:definition "Values used when a field was not collected, so a template needs no conditional of its own." ;
    skos:inScheme <https://jumo.dev/schemas/jumo-v1> .

jumo:fields a owl:ObjectProperty ;
    rdfs:label "fields" ;
    skos:inScheme <https://jumo.dev/schemas/jumo-v1> .

jumo:files a owl:ObjectProperty ;
    rdfs:label "files" ;
    skos:inScheme <https://jumo.dev/schemas/jumo-v1> .

jumo:flows a owl:ObjectProperty ;
    rdfs:label "flows" ;
    skos:inScheme <https://jumo.dev/schemas/jumo-v1> .

jumo:forbidden a owl:ObjectProperty ;
    rdfs:label "forbidden" ;
    skos:inScheme <https://jumo.dev/schemas/jumo-v1> .

jumo:gitLfsPointers a owl:DatatypeProperty ;
    rdfs:label "gitLfsPointers" ;
    skos:inScheme <https://jumo.dev/schemas/jumo-v1> .

jumo:goldenTaskSetRefs a owl:ObjectProperty ;
    rdfs:label "goldenTaskSetRefs" ;
    skos:inScheme <https://jumo.dev/schemas/jumo-v1> .

jumo:grantIds a owl:DatatypeProperty ;
    rdfs:label "grantIds" ;
    skos:inScheme <https://jumo.dev/schemas/jumo-v1> .

jumo:grantedCapabilities a owl:DatatypeProperty ;
    rdfs:label "grantedCapabilities" ;
    skos:inScheme <https://jumo.dev/schemas/jumo-v1> .

jumo:grantedOperationRefs a owl:ObjectProperty ;
    rdfs:label "grantedOperationRefs" ;
    skos:definition "The only external reach available to the substrate." ;
    skos:inScheme <https://jumo.dev/schemas/jumo-v1> .

jumo:grantedScopes a owl:DatatypeProperty ;
    rdfs:label "grantedScopes" ;
    skos:inScheme <https://jumo.dev/schemas/jumo-v1> .

jumo:includes a owl:DatatypeProperty ;
    rdfs:label "includes" ;
    skos:inScheme <https://jumo.dev/schemas/jumo-v1> .

jumo:incompatibleSeatPairs a owl:ObjectProperty ;
    rdfs:label "incompatibleSeatPairs" ;
    skos:definition "Seats that may never be filled by the same RoleAssignment bearer (e.g. implementer and reviewer). Enforced in Rego, not here." ;
    skos:inScheme <https://jumo.dev/schemas/jumo-v1> .

jumo:independentSeatGroups a owl:ObjectProperty ;
    rdfs:label "independentSeatGroups" ;
    skos:definition "Seats whose bearers must sit in different independence groups (e.g. reviewer needs a distinct provider group from implementer). Enforced in Rego." ;
    skos:inScheme <https://jumo.dev/schemas/jumo-v1> .

jumo:inspiresPolicies a owl:DatatypeProperty ;
    rdfs:label "inspiresPolicies" ;
    skos:definition "A principle may inspire a policy, but the policy must be explicit and reviewable (canonical decision 16). Documentation link, not an authorization path." ;
    skos:inScheme <https://jumo.dev/schemas/jumo-v1> .

jumo:installedCliRefs a owl:ObjectProperty ;
    rdfs:label "installedCliRefs" ;
    skos:inScheme <https://jumo.dev/schemas/jumo-v1> .

jumo:installedConnectorRefs a owl:ObjectProperty ;
    rdfs:label "installedConnectorRefs" ;
    skos:inScheme <https://jumo.dev/schemas/jumo-v1> .

jumo:intentKinds a owl:ObjectProperty ;
    rdfs:label "intentKinds" ;
    skos:inScheme <https://jumo.dev/schemas/jumo-v1> .

jumo:itemValidations a owl:ObjectProperty ;
    rdfs:label "itemValidations" ;
    skos:definition "Checks applied to each item, naming a key of the item rather than a field of the payload." ;
    skos:inScheme <https://jumo.dev/schemas/jumo-v1> .

jumo:keys a owl:DatatypeProperty ;
    rdfs:label "keys" ;
    skos:definition "The keys each emitted item carries, in the order the document declares them." ;
    skos:inScheme <https://jumo.dev/schemas/jumo-v1> .

jumo:kitBindingRefs a owl:ObjectProperty ;
    rdfs:label "kitBindingRefs" ;
    skos:definition "Ordered list of kit bindings determining precedence." ;
    skos:inScheme <https://jumo.dev/schemas/jumo-v1> .

jumo:mandatoryObligations a owl:ObjectProperty ;
    rdfs:label "mandatoryObligations" ;
    skos:inScheme <https://jumo.dev/schemas/jumo-v1> .

jumo:mappings a owl:ObjectProperty ;
    rdfs:label "mappings" ;
    skos:inScheme <https://jumo.dev/schemas/jumo-v1> .

jumo:mayProposeCapabilities a owl:DatatypeProperty ;
    rdfs:label "mayProposeCapabilities" ;
    skos:definition "Enforced as a subset of the owning AgentDefinition's requestedCapabilities (Rego). Proposing is still not granting: policy decides." ;
    skos:inScheme <https://jumo.dev/schemas/jumo-v1> .

jumo:measures a owl:ObjectProperty ;
    rdfs:label "measures" ;
    skos:inScheme <https://jumo.dev/schemas/jumo-v1> .

jumo:memberConnectorRefs a owl:ObjectProperty ;
    rdfs:label "memberConnectorRefs" ;
    skos:inScheme <https://jumo.dev/schemas/jumo-v1> .

jumo:memberRealmIds a owl:DatatypeProperty ;
    rdfs:label "memberRealmIds" ;
    skos:inScheme <https://jumo.dev/schemas/jumo-v1> .

jumo:members a owl:ObjectProperty ;
    rdfs:label "members" ;
    skos:inScheme <https://jumo.dev/schemas/jumo-v1> .

jumo:messages a owl:ObjectProperty ;
    rdfs:label "messages" ;
    skos:inScheme <https://jumo.dev/schemas/jumo-v1> .

jumo:milestones a owl:ObjectProperty ;
    rdfs:label "milestones" ;
    skos:definition "Declared in delivery order. Groups the generated roadmap and bounds every WorkOrder's roadmapRef (Rego corpus.work.roadmap-ref-declared)." ;
    skos:inScheme <https://jumo.dev/schemas/jumo-v1> .

jumo:mitigations a owl:DatatypeProperty ;
    rdfs:label "mitigations" ;
    skos:inScheme <https://jumo.dev/schemas/jumo-v1> .

jumo:modalities a owl:ObjectProperty ;
    rdfs:label "modalities" ;
    skos:inScheme <https://jumo.dev/schemas/jumo-v1> .

jumo:moduleDigests a owl:ObjectProperty ;
    rdfs:label "moduleDigests" ;
    skos:inScheme <https://jumo.dev/schemas/jumo-v1> .

jumo:modules a owl:ObjectProperty ;
    rdfs:label "modules" ;
    skos:inScheme <https://jumo.dev/schemas/jumo-v1> .

jumo:mountedPersonalSpaceRefs a owl:ObjectProperty ;
    rdfs:label "mountedPersonalSpaceRefs" ;
    skos:definition "PersonalSpace documents mounted into this cell's private workspace filesystem. Each referenced PersonalSpace must belong to the same Realm as this cell (Rego, corpus.cell.workspace-realm-scoped) -- private documents never mount into another tenant's dedicated Execution Cell." ;
    skos:inScheme <https://jumo.dev/schemas/jumo-v1> .

jumo:objectForms a owl:ObjectProperty ;
    rdfs:label "objectForms" ;
    skos:definition "Themed representation by business entity key -- the business term stays visible next to the metaphor (decision 216)." ;
    skos:inScheme <https://jumo.dev/schemas/jumo-v1> .

jumo:observedFrom a owl:ObjectProperty ;
    rdfs:label "observedFrom" ;
    skos:inScheme <https://jumo.dev/schemas/jumo-v1> .

jumo:optionalKeys a owl:DatatypeProperty ;
    rdfs:label "optionalKeys" ;
    skos:definition "Keys carried only when the collected item supplies a non-blank value." ;
    skos:inScheme <https://jumo.dev/schemas/jumo-v1> .

jumo:optionsEligibility a owl:ObjectProperty ;
    rdfs:label "optionsEligibility" ;
    skos:definition "Conditions every instance of `optionsFrom` must satisfy to be offered. The eligibility a selection applies is part of what the contract says the field means, so it is declared here rather than left to whichever surface happens to render the field. Conditions read the candidate's Git document only -- desired and contractual state; recognized runtime state (a machine's observed health) is a different authority and is not reachable from a projection." ;
    skos:inScheme <https://jumo.dev/schemas/jumo-v1> .

jumo:pathScope a owl:DatatypeProperty ;
    rdfs:label "pathScope" ;
    skos:definition "Glob patterns the work may touch." ;
    skos:inScheme <https://jumo.dev/schemas/jumo-v1> .

jumo:personalSpaces a owl:ObjectProperty ;
    rdfs:label "personalSpaces" ;
    skos:inScheme <https://jumo.dev/schemas/jumo-v1> .

jumo:practiceRefs a owl:ObjectProperty ;
    rdfs:label "practiceRefs" ;
    skos:inScheme <https://jumo.dev/schemas/jumo-v1> .

jumo:preconditions a owl:DatatypeProperty ;
    rdfs:label "preconditions" ;
    skos:inScheme <https://jumo.dev/schemas/jumo-v1> .

jumo:preferredTransports a owl:ObjectProperty ;
    rdfs:label "preferredTransports" ;
    skos:inScheme <https://jumo.dev/schemas/jumo-v1> .

jumo:principleSetRefs a owl:ObjectProperty ;
    rdfs:label "principleSetRefs" ;
    skos:definition "Relative paths to PrincipleSet documents. Influence only." ;
    skos:inScheme <https://jumo.dev/schemas/jumo-v1> .

jumo:principles a owl:ObjectProperty ;
    rdfs:label "principles" ;
    skos:inScheme <https://jumo.dev/schemas/jumo-v1> .

jumo:processingRegister a owl:ObjectProperty ;
    rdfs:label "processingRegister" ;
    skos:definition "RGPD art. 30 register of processing activities this profile covers. Empty for non-privacy referentials." ;
    skos:inScheme <https://jumo.dev/schemas/jumo-v1> .

jumo:prohibitedAuthority a owl:ObjectProperty ;
    rdfs:label "prohibitedAuthority" ;
    skos:inScheme <https://jumo.dev/schemas/jumo-v1> .

jumo:proposes a owl:DatatypeProperty ;
    rdfs:label "proposes" ;
    skos:inScheme <https://jumo.dev/schemas/jumo-v1> .

jumo:provenancePins a owl:ObjectProperty ;
    rdfs:label "provenancePins" ;
    skos:inScheme <https://jumo.dev/schemas/jumo-v1> .

jumo:rationale a owl:ObjectProperty ;
    rdfs:label "rationale" ;
    skos:definition "One entry per selectedRefs, explaining the match to the stated intent." ;
    skos:inScheme <https://jumo.dev/schemas/jumo-v1> .

jumo:reads a owl:ObjectProperty ;
    rdfs:label "reads" ;
    skos:inScheme <https://jumo.dev/schemas/jumo-v1> .

jumo:referenceChecks a owl:ObjectProperty ;
    rdfs:label "referenceChecks" ;
    skos:definition "Checks that a collected value names a contract that exists, so a journey never proposes a document pointing at nothing." ;
    skos:inScheme <https://jumo.dev/schemas/jumo-v1> .

jumo:relatedCommitments a owl:DatatypeProperty ;
    rdfs:label "relatedCommitments" ;
    skos:inScheme <https://jumo.dev/schemas/jumo-v1> .

jumo:rendered a owl:ObjectProperty ;
    rdfs:label "rendered" ;
    skos:inScheme <https://jumo.dev/schemas/jumo-v1> .

jumo:renderedAssets a owl:ObjectProperty ;
    rdfs:label "renderedAssets" ;
    skos:definition "Provenance for assetExports (JumoKitSpec) admitted by this release, if any." ;
    skos:inScheme <https://jumo.dev/schemas/jumo-v1> .

jumo:repositoryBindings a owl:ObjectProperty ;
    rdfs:label "repositoryBindings" ;
    skos:definition "Zero or more Git resources governed by this Project. A repository-free Project remains valid." ;
    skos:inScheme <https://jumo.dev/schemas/jumo-v1> .

jumo:requestedCapabilities a owl:DatatypeProperty ;
    rdfs:label "requestedCapabilities" ;
    skos:definition "A request, not a grant. Policy decides." ;
    skos:inScheme <https://jumo.dev/schemas/jumo-v1> .

jumo:requiredCapabilities a owl:DatatypeProperty ;
    rdfs:label "requiredCapabilities" ;
    skos:definition "Complete capability allowlist for this journey. The runtime journey authorization entrypoint checks every admitted action against it; ProjectionSpec.actions and emitsCapability must be subsets (Rego)." ;
    skos:inScheme <https://jumo.dev/schemas/jumo-v1> .

jumo:requiredFields a owl:ObjectProperty ;
    rdfs:label "requiredFields" ;
    skos:definition "One entry per field the step collects or confirms, each carrying the i18n key journey-generic-step and the completed-step recap render for it. A bare field-name string list let two journeys reusing the same field name for a different meaning (e.g. purpose) collide on one hardcoded label; this does not." ;
    skos:inScheme <https://jumo.dev/schemas/jumo-v1> .

jumo:requiredScopes a owl:DatatypeProperty ;
    rdfs:label "requiredScopes" ;
    skos:inScheme <https://jumo.dev/schemas/jumo-v1> .

jumo:responseBindings a owl:ObjectProperty ;
    rdfs:label "responseBindings" ;
    skos:inScheme <https://jumo.dev/schemas/jumo-v1> .

jumo:responsibilities a owl:DatatypeProperty ;
    rdfs:label "responsibilities" ;
    skos:inScheme <https://jumo.dev/schemas/jumo-v1> .

jumo:risksToDataSubjects a owl:DatatypeProperty ;
    rdfs:label "risksToDataSubjects" ;
    skos:inScheme <https://jumo.dev/schemas/jumo-v1> .

jumo:roleOverrides a owl:ObjectProperty ;
    rdfs:label "roleOverrides" ;
    skos:inScheme <https://jumo.dev/schemas/jumo-v1> .

jumo:roleRefs a owl:ObjectProperty ;
    rdfs:label "roleRefs" ;
    skos:definition "References RoleDefinition entries this organization uses, each bound to a named seat." ;
    skos:inScheme <https://jumo.dev/schemas/jumo-v1> .

jumo:roles a owl:DatatypeProperty ;
    rdfs:label "roles" ;
    skos:inScheme <https://jumo.dev/schemas/jumo-v1> .

jumo:rooms a owl:ObjectProperty ;
    rdfs:label "rooms" ;
    skos:definition "Illustrated room decor keyed by surface id (ADR-0087). A missing entry renders the classic view rather than failing." ;
    skos:inScheme <https://jumo.dev/schemas/jumo-v1> .

jumo:roots a owl:ObjectProperty ;
    rdfs:label "roots" ;
    skos:inScheme <https://jumo.dev/schemas/jumo-v1> .

jumo:rules a owl:ObjectProperty ;
    rdfs:label "rules" ;
    skos:inScheme <https://jumo.dev/schemas/jumo-v1> .

jumo:sections a owl:ObjectProperty ;
    rdfs:label "sections" ;
    skos:definition "Rendered fields grouped into sections. May be empty only for an action-only projection, where actions is non-empty and the projection exists solely to anchor a headless journey step's callable capabilities (Rego)." ;
    skos:inScheme <https://jumo.dev/schemas/jumo-v1> .

jumo:selectedRefs a owl:ObjectProperty ;
    rdfs:label "selectedRefs" ;
    skos:definition "Ids proposed, of the kind PromptOutput.targetKind names, referencing the supplied catalog only." ;
    skos:inScheme <https://jumo.dev/schemas/jumo-v1> .

jumo:semanticTools a owl:DatatypeProperty ;
    rdfs:label "semanticTools" ;
    skos:inScheme <https://jumo.dev/schemas/jumo-v1> .

jumo:skills a owl:ObjectProperty ;
    rdfs:label "skills" ;
    skos:inScheme <https://jumo.dev/schemas/jumo-v1> .

jumo:sourcePaths a owl:DatatypeProperty ;
    rdfs:label "sourcePaths" ;
    skos:inScheme <https://jumo.dev/schemas/jumo-v1> .

jumo:sourceRefs a owl:DatatypeProperty ;
    rdfs:label "sourceRefs" ;
    skos:inScheme <https://jumo.dev/schemas/jumo-v1> .

jumo:specification a owl:ObjectProperty ;
    rdfs:label "specification" ;
    skos:definition "Long-form design lots too large for purpose/condition/acceptanceCriteria -- Markdown body, no language restriction (WorkOrder specification prose is exempt from the English-only rule, AGENTS.md)." ;
    skos:inScheme <https://jumo.dev/schemas/jumo-v1> .

jumo:spheres a owl:ObjectProperty ;
    rdfs:label "spheres" ;
    skos:inScheme <https://jumo.dev/schemas/jumo-v1> .

jumo:stageWorkerRequirementRef a owl:ObjectProperty ;
    rdfs:label "stageWorkerRequirementRef" ;
    skos:definition "Task requirements per model-using step (source schema's open string-keyed map, modeled as key/value pairs -- see ThemePack for the same pattern). Every key must name a declared step and every value resolves to a WorkerRequirementProfile (Rego)." ;
    skos:inScheme <https://jumo.dev/schemas/jumo-v1> .

jumo:stages a owl:ObjectProperty ;
    rdfs:label "stages" ;
    skos:inScheme <https://jumo.dev/schemas/jumo-v1> .

jumo:superseded_by a owl:DatatypeProperty ;
    rdfs:label "superseded_by" ;
    skos:inScheme <https://jumo.dev/schemas/jumo-v1> .

jumo:supersedes a owl:DatatypeProperty ;
    rdfs:label "supersedes" ;
    skos:inScheme <https://jumo.dev/schemas/jumo-v1> .

jumo:supportedAdapterProfiles a owl:DatatypeProperty ;
    rdfs:label "supportedAdapterProfiles" ;
    skos:inScheme <https://jumo.dev/schemas/jumo-v1> .

jumo:supportedTransportDigests a owl:DatatypeProperty ;
    rdfs:label "supportedTransportDigests" ;
    skos:definition "One digest per McpServerDescriptor in the certified package's supportedTransports, each sha256: followed by the SHA-256 of that descriptor's canonical JSON -- object keys sorted, no insignificant whitespace, absent fields omitted. Certifying a transport the package does not declare, or omitting one it does, is refused by corpus.certification.transport-consistency. Computed by scripts/generate/compute-package-digests.py." ;
    skos:inScheme <https://jumo.dev/schemas/jumo-v1> .

jumo:surfaces a owl:ObjectProperty ;
    rdfs:label "surfaces" ;
    skos:inScheme <https://jumo.dev/schemas/jumo-v1> .

jumo:targets a owl:ObjectProperty ;
    rdfs:label "targets" ;
    skos:inScheme <https://jumo.dev/schemas/jumo-v1> .

jumo:taskClasses a owl:ObjectProperty ;
    rdfs:label "taskClasses" ;
    skos:inScheme <https://jumo.dev/schemas/jumo-v1> .

jumo:teams a owl:DatatypeProperty ;
    rdfs:label "teams" ;
    skos:inScheme <https://jumo.dev/schemas/jumo-v1> .

jumo:terminology a owl:ObjectProperty ;
    rdfs:label "terminology" ;
    skos:definition "Display names by role key, such as chiefOfStaff or securityAgent. The technical identifier is unaffected." ;
    skos:inScheme <https://jumo.dev/schemas/jumo-v1> .

jumo:testCases a owl:ObjectProperty ;
    rdfs:label "testCases" ;
    skos:inScheme <https://jumo.dev/schemas/jumo-v1> .

jumo:testPlanRefs a owl:DatatypeProperty ;
    rdfs:label "testPlanRefs" ;
    skos:inScheme <https://jumo.dev/schemas/jumo-v1> .

jumo:tools a owl:ObjectProperty ;
    rdfs:label "tools" ;
    skos:inScheme <https://jumo.dev/schemas/jumo-v1> .

jumo:triggers a owl:ObjectProperty ;
    rdfs:label "triggers" ;
    skos:inScheme <https://jumo.dev/schemas/jumo-v1> .

jumo:upstreamInventory a owl:ObjectProperty ;
    rdfs:label "upstreamInventory" ;
    skos:definition "Every tool the upstream server offered when it was looked at, exposed or not -- enumerating what was held back is the point of the whole document." ;
    skos:inScheme <https://jumo.dev/schemas/jumo-v1> .

jumo:validations a owl:ObjectProperty ;
    rdfs:label "validations" ;
    skos:definition "Field-level checks the collected payload must pass before anything is written." ;
    skos:inScheme <https://jumo.dev/schemas/jumo-v1> .

jumo:values a owl:ObjectProperty ;
    rdfs:label "values" ;
    skos:inScheme <https://jumo.dev/schemas/jumo-v1> .

jumo:writePaths a owl:ObjectProperty ;
    rdfs:label "writePaths" ;
    skos:inScheme <https://jumo.dev/schemas/jumo-v1> .

jumo:AssistedJourneyCompletionMode a owl:Class ;
    rdfs:label "AssistedJourneyCompletionMode" ;
    owl:unionOf ( <https://jumo.dev/schemas/jumo-v1/AssistedJourneyCompletionMode#PROPOSAL> <https://jumo.dev/schemas/jumo-v1/AssistedJourneyCompletionMode#OBSERVATION> ) ;
    skos:definition "Whether a journey emits a governed proposal or only records an observation." ;
    skos:inScheme <https://jumo.dev/schemas/jumo-v1> ;
    linkml:permissible_values <https://jumo.dev/schemas/jumo-v1/AssistedJourneyCompletionMode#OBSERVATION>,
        <https://jumo.dev/schemas/jumo-v1/AssistedJourneyCompletionMode#PROPOSAL> .

jumo:AssistedJourneyConcurrencyPolicy a owl:Class ;
    rdfs:label "AssistedJourneyConcurrencyPolicy" ;
