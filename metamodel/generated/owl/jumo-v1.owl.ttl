    rdfs:label "annotations" ;
    skos:inScheme <https://jumo.dev/schemas/jumo-v1> .

jumo:approverPrincipalRefs a owl:ObjectProperty ;
    rdfs:label "approverPrincipalRefs" ;
    skos:inScheme <https://jumo.dev/schemas/jumo-v1> .

jumo:artifactAllowlist a owl:DatatypeProperty ;
    rdfs:label "artifactAllowlist" ;
    skos:inScheme <https://jumo.dev/schemas/jumo-v1> .

jumo:assetExports a owl:DatatypeProperty ;
    rdfs:label "assetExports" ;
    skos:definition "Optional binary assets (images) and i18n bundles (json) the kit distributes, distinct from `exports` because these are opaque content, not corpus-governed YAML documents -- no LinkML class validates their bytes, only their provenance (KitLockSpec.renderedAssets digest). Images and i18n bundles share this one tree rather than splitting into two export lists: both are inert content a journey (AssistedJourneyStep.image/heroImage) or the frontend i18n loader references by rendered path, never executed." ;
    skos:inScheme <https://jumo.dev/schemas/jumo-v1> .

jumo:baseUrlAllowlist a owl:DatatypeProperty ;
    rdfs:label "baseUrlAllowlist" ;
    skos:inScheme <https://jumo.dev/schemas/jumo-v1> .

jumo:bindings a owl:ObjectProperty ;
    rdfs:label "bindings" ;
    skos:definition "Open string-keyed map in the source schema, modeled as a list of key/type pairs (see ThemePack for the same pattern)." ;
    skos:inScheme <https://jumo.dev/schemas/jumo-v1> .

jumo:booleanFields a owl:DatatypeProperty ;
    rdfs:label "booleanFields" ;
    skos:definition "Field names whose collected \"true\"/\"false\" string is coerced to a real YAML boolean before rendering. The platform compensates here rather than in the renderer: the generic step form has no boolean-aware widget yet (projection-field-options-resolution), so a BOOLEAN_FLAG-shaped value still arrives as free text." ;
    skos:inScheme <https://jumo.dev/schemas/jumo-v1> .

jumo:cases a owl:ObjectProperty ;
    rdfs:label "cases" ;
    skos:inScheme <https://jumo.dev/schemas/jumo-v1> .

jumo:channels a owl:ObjectProperty ;
    rdfs:label "channels" ;
    skos:inScheme <https://jumo.dev/schemas/jumo-v1> .

jumo:coOwnerRealms a owl:DatatypeProperty ;
    rdfs:label "coOwnerRealms" ;
    skos:definition "Additional Realm identifiers that co-govern this repository. When non-empty, all named Realms must declare a matching RepositoryBinding pointing at the same repository. Policy enforces mutual binding via Rego (corpus.project.mutual-repo-binding)." ;
    skos:inScheme <https://jumo.dev/schemas/jumo-v1> .

jumo:collectionProjections a owl:ObjectProperty ;
    rdfs:label "collectionProjections" ;
    skos:definition "What a multivalued field contributes to the emitted document. A collected item may carry more than the contract needs, so the emitted item is a projection of it -- declared here rather than decided by the renderer, which is what keeps the emitted shape a contract fact." ;
    skos:inScheme <https://jumo.dev/schemas/jumo-v1> .

jumo:commands a owl:DatatypeProperty ;
    rdfs:label "commands" ;
    skos:inScheme <https://jumo.dev/schemas/jumo-v1> .

jumo:conditions a owl:DatatypeProperty ;
    rdfs:label "conditions" ;
    skos:definition "Required and non-empty under ACCEPTED_WITH_CONDITIONS (Rego)." ;
    skos:inScheme <https://jumo.dev/schemas/jumo-v1> .

jumo:connectorDefinitionRefs a owl:ObjectProperty ;
    rdfs:label "connectorDefinitionRefs" ;
    skos:inScheme <https://jumo.dev/schemas/jumo-v1> .

jumo:contractPaths a owl:DatatypeProperty ;
    rdfs:label "contractPaths" ;
    skos:inScheme <https://jumo.dev/schemas/jumo-v1> .

jumo:controls a owl:ObjectProperty ;
