jumo:upstreamKind a owl:DatatypeProperty ;
    rdfs:label "upstreamKind" ;
    skos:definition "Not schema-required -- the pinned jumo-core sibling source only gains this field at its own pace; enforced unconditionally in Rego instead (corpus.bundle.upstream-kind-required), which reads the live composed corpus rather than a stale lock." ;
    skos:inScheme <https://jumo.dev/schemas/jumo-v1> .

jumo:upstreamToolsDigest a owl:DatatypeProperty ;
    rdfs:label "upstreamToolsDigest" ;
    skos:definition "Digest of the complete discovered tool inventory of the one upstream connector accepted for this plan, using mcp-tools-jcs-v1. Signed with the plan so a gateway can refuse a later upstream inventory change before dispatch." ;
    skos:inScheme <https://jumo.dev/schemas/jumo-v1> .

