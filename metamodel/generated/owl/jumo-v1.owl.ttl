    rdfs:label "AttentionAdmissionReason" ;
    owl:unionOf ( <https://jumo.dev/schemas/jumo-v1/AttentionAdmissionReason#NO_ELIGIBLE_ROLE> <https://jumo.dev/schemas/jumo-v1/AttentionAdmissionReason#ADMISSION_DECLINED> <https://jumo.dev/schemas/jumo-v1/AttentionAdmissionReason#POLICY_DENIED> ) ;
    skos:inScheme <https://jumo.dev/schemas/jumo-v1> ;
    linkml:permissible_values <https://jumo.dev/schemas/jumo-v1/AttentionAdmissionReason#ADMISSION_DECLINED>,
        <https://jumo.dev/schemas/jumo-v1/AttentionAdmissionReason#NO_ELIGIBLE_ROLE>,
