jumo:InvocationAuthorizationReceipt a sh:NodeShape ;
    rdfs:comment "Signed, single-use MCP invocation authorization (ADR-0055). Bound to exactly one invocation id, lease, Realm, operation, argument digest and tools digest; carries no session or renewal field and therefore cannot represent renewable session authority. A lease gateway without this receipt cannot contact the upstream." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path jumo:toolsDigest ;
            sh:pattern "^sha256:[0-9a-f]{64}$" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path jumo:executionCellLeaseRef ;
            sh:pattern "^[a-z][a-z0-9-]*$" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path jumo:invocationId ;
            sh:pattern "^[a-z][a-z0-9-]*$" ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path jumo:expiresAt ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path jumo:argumentDigest ;
            sh:pattern "^sha256:[0-9a-f]{64}$" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path jumo:ownerRealm ;
            sh:pattern "^[a-z][a-z0-9-]*$" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path jumo:operationRef ;
            sh:pattern "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9]*){1,3}$" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path jumo:signature ;
            sh:pattern "^.{16,}$" ] ;
    sh:targetClass jumo:InvocationAuthorizationReceipt .

