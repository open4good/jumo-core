jumo:AppraisalDimensionOutcome a owl:Class ;
    rdfs:label "AppraisalDimensionOutcome" ;
    owl:unionOf ( <https://jumo.dev/schemas/jumo-v1/AppraisalDimensionOutcome#PASS> <https://jumo.dev/schemas/jumo-v1/AppraisalDimensionOutcome#CONCERN> <https://jumo.dev/schemas/jumo-v1/AppraisalDimensionOutcome#FAIL> <https://jumo.dev/schemas/jumo-v1/AppraisalDimensionOutcome#UNKNOWN> ) ;
    skos:definition "CONCERN sits between PASS and FAIL so a reviewer can record something that did not block promotion without calling it clean." ;
    skos:inScheme <https://jumo.dev/schemas/jumo-v1> ;
    linkml:permissible_values <https://jumo.dev/schemas/jumo-v1/AppraisalDimensionOutcome#CONCERN>,
        <https://jumo.dev/schemas/jumo-v1/AppraisalDimensionOutcome#FAIL>,
        <https://jumo.dev/schemas/jumo-v1/AppraisalDimensionOutcome#PASS>,
        <https://jumo.dev/schemas/jumo-v1/AppraisalDimensionOutcome#UNKNOWN> .

