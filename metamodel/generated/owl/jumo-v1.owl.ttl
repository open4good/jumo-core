jumo:Metadata a owl:Class ;
    rdfs:label "Metadata" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty jumo:namespace ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty jumo:id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty jumo:defaultDisplayName ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty jumo:name ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty jumo:name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty jumo:overrides ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty jumo:namespace ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty jumo:defaultDisplayName ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty jumo:id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty jumo:name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty jumo:overrides ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty jumo:namespace ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty jumo:defaultDisplayName ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty jumo:id ],
        [ a owl:Restriction ;
            owl:allValuesFrom jumo:LayerOverride ;
            owl:onProperty jumo:overrides ] ;
    skos:definition "Shared identity block for every contract document." ;
    skos:inScheme <https://jumo.dev/schemas/jumo-v1> ;
    jumo:jumo.audience "REALM_PRIVATE" ;
    jumo:jumo.boundary_eligible true ;
    jumo:jumo.model_role "VALUE_OBJECT" ;
    jumo:jumo.schema_profiles "draft-2020-12,native-json-schema,prompted-json-validated" ;
    jumo:jumo.sensitivity "INTERNAL" ;
    jumo:jumo.state_authority "GIT" .

jumo:id a owl:DatatypeProperty .

xsd:integer a rdfs:Datatype .

jumo:ContractReference a owl:Class ;
    rdfs:label "ContractReference" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:string [ a rdfs:Datatype ;
                                owl:onDatatype xsd:string ;
                                owl:withRestrictions ( [ xsd:pattern "^[A-Z][A-Za-z0-9]+$" ] ) ] ) ] ;
            owl:onProperty jumo:kind ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty jumo:id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty jumo:namespace ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty jumo:namespace ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty jumo:namespace ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty jumo:kind ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty jumo:id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty jumo:id ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty jumo:kind ] ;
    skos:definition "Structured reference to a Git-declared contract document." ;
    skos:inScheme <https://jumo.dev/schemas/jumo-v1> ;
    jumo:jumo.audience "REALM_PRIVATE" ;
    jumo:jumo.boundary_eligible true ;
    jumo:jumo.composition "ADDITIVE" ;
    jumo:jumo.model_role "CONTRACT" ;
    jumo:jumo.schema_profiles "draft-2020-12,native-json-schema,prompted-json-validated" ;
    jumo:jumo.sensitivity "INTERNAL" ;
    jumo:jumo.state_authority "GIT" .

