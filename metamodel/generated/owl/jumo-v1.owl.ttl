            owl:onProperty jumo:executionMachineRef ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty jumo:expiresAt ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
