jumo:ProviderPlatform a sh:NodeShape ;
    rdfs:comment "The declared catalog entry a ProviderAccount is opened against -- wire protocol, upstream host, credential header style, egress route, and the default effort ladder new accounts inherit. Adding an aggregator or OpenAI-compatible endpoint is a contract change against this catalog and a provider-egress regeneration, never a value typed directly into a ProviderAccount (ADR-0002 -- the worker cannot select a host)." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class jumo:Metadata ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path jumo:metadata ],
