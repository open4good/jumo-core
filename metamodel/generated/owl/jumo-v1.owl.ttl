    rdfs:label "Reversibility" ;
    owl:unionOf ( <https://jumo.dev/schemas/jumo-v1/Reversibility#REVERSIBLE> <https://jumo.dev/schemas/jumo-v1/Reversibility#IRREVERSIBLE> ) ;
