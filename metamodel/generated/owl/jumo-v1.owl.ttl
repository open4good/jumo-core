jumo:JourneyPresentation a owl:Class ;
    rdfs:label "JourneyPresentation" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom jumo:JourneySurfaceMode ;
            owl:onProperty jumo:surfaceMode ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty jumo:maxWidth ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty jumo:maxWidth ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty jumo:surfaceMode ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty jumo:maxWidth ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty jumo:subJourneyOpenMode ],
        [ a owl:Restriction ;
            owl:allValuesFrom jumo:JourneyStepperLayout ;
            owl:onProperty jumo:stepperLayout ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty jumo:surfaceMode ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty jumo:subJourneyOpenMode ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty jumo:stepperLayout ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty jumo:stepperLayout ],
        [ a owl:Restriction ;
            owl:allValuesFrom jumo:SubJourneyOpenMode ;
            owl:onProperty jumo:subJourneyOpenMode ] ;
    skos:definition "Decorative and layout-only: how a journey or step is drawn, never what it may do. Carries no capability, no policy, no budget and no workflow field, on the same terms as ThemePack. Declared on the journey and overridable per step; an absent field at step level falls back to the journey's." ;
    skos:inScheme <https://jumo.dev/schemas/jumo-v1> ;
    jumo:jumo.audience "REALM_PRIVATE" ;
    jumo:jumo.boundary_eligible true ;
    jumo:jumo.model_role "VALUE_OBJECT" ;
    jumo:jumo.schema_profiles "draft-2020-12,native-json-schema,prompted-json-validated" ;
    jumo:jumo.sensitivity "PUBLIC" ;
    jumo:jumo.state_authority "GIT" .

