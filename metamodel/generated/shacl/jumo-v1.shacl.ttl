jumo:GoldenTaskCase a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:in ( "TASK_SUCCESS" "RELIABILITY" "LATENCY" "STRUCTURED_OUTPUT" "TOOL_USE" "PROVENANCE" ) ;
            sh:minCount 1 ;
