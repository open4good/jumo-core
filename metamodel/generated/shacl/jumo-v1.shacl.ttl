            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path jumo:workerRequirementProfileRef ],
        [ sh:class jumo:GoldenTaskCase ;
            sh:minCount 10 ;
