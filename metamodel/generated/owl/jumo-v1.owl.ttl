        <https://jumo.dev/schemas/jumo-v1/HostnameInclusion#UNASSIGNED> .

jumo:InformationClassification a owl:Class ;
    rdfs:label "InformationClassification" ;
    owl:unionOf ( <https://jumo.dev/schemas/jumo-v1/InformationClassification#PUBLIC> <https://jumo.dev/schemas/jumo-v1/InformationClassification#INTERNAL> <https://jumo.dev/schemas/jumo-v1/InformationClassification#REALM_CONFIDENTIAL> <https://jumo.dev/schemas/jumo-v1/InformationClassification#SECRET> ) ;
    skos:definition "Confidentiality dimension, split out from the single DataScope enum: classification, ownership, and declassification are distinct concerns (docs/concepts/positionnement-conceptuel.md#flux-dinformation). Used where an explicit cross-Realm release transformation is modeled, alongside ReleaseTransformation and ReleaseCompartment below -- not a replacement for DataScope's simpler publication-boundary role." ;
    skos:inScheme <https://jumo.dev/schemas/jumo-v1> ;
    linkml:permissible_values <https://jumo.dev/schemas/jumo-v1/InformationClassification#INTERNAL>,
        <https://jumo.dev/schemas/jumo-v1/InformationClassification#PUBLIC>,
        <https://jumo.dev/schemas/jumo-v1/InformationClassification#REALM_CONFIDENTIAL>,
        <https://jumo.dev/schemas/jumo-v1/InformationClassification#SECRET> .

