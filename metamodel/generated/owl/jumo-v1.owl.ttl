    rdfs:label "ResponseSufficiency" ;
    owl:unionOf ( <https://jumo.dev/schemas/jumo-v1/ResponseSufficiency#SUFFICIENT> <https://jumo.dev/schemas/jumo-v1/ResponseSufficiency#INSUFFICIENT_NEEDS_DEPTH> ) ;
