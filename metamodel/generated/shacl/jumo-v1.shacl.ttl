jumo:PromptTemplate a sh:NodeShape ;
    rdfs:comment "A prompt is Ring 2 material: reviewable, versioned agent behavior (ADR-0008). Belongs to exactly one AgentDefinition; the capabilities its output may propose are constrained to a subset of what that definition requests." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:in ( "PromptTemplate" ) ;
            sh:maxCount 1 ;
