            sh:order 0 ;
            sh:path jumo:sessionId ;
            sh:pattern "^[a-z][a-z0-9-]*$" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path jumo:secretBindingRef ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
