            sh:order 1 ;
            sh:path jumo:kind ],
        [ sh:class jumo:PromptTemplateSpec ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path jumo:spec ],
        [ sh:class jumo:Metadata ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path jumo:metadata ],
        [ sh:datatype xsd:string ;
            sh:in ( "jumo.dev/v1" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
