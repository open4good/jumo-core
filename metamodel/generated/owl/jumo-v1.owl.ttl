jumo:AttentionInterruptibility a owl:Class ;
    rdfs:label "AttentionInterruptibility" ;
    owl:unionOf ( <https://jumo.dev/schemas/jumo-v1/AttentionInterruptibility#DEFER_TO_DIGEST> <https://jumo.dev/schemas/jumo-v1/AttentionInterruptibility#MAY_INTERRUPT> <https://jumo.dev/schemas/jumo-v1/AttentionInterruptibility#QUIET_HOURS_EXEMPT> ) ;
    skos:definition "Ordered least to most intrusive. Separate from urgency on purpose: a critical item can still belong in the morning digest, and conflating the two is how everything urgent becomes an interruption." ;
    skos:inScheme <https://jumo.dev/schemas/jumo-v1> ;
    linkml:permissible_values <https://jumo.dev/schemas/jumo-v1/AttentionInterruptibility#DEFER_TO_DIGEST>,
        <https://jumo.dev/schemas/jumo-v1/AttentionInterruptibility#MAY_INTERRUPT>,
        <https://jumo.dev/schemas/jumo-v1/AttentionInterruptibility#QUIET_HOURS_EXEMPT> .

