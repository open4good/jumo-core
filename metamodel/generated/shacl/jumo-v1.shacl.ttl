            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path jumo:kind ],
        [ sh:class jumo:Metadata ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path jumo:metadata ],
        [ sh:class jumo:SecretBindingSpec ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path jumo:spec ],
        [ sh:datatype xsd:string ;
            sh:in ( "jumo.dev/v1" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path jumo:apiVersion ] ;
    sh:targetClass jumo:SecretBinding .

jumo:SelfDescription a sh:NodeShape ;
    rdfs:comment "How a Project or agent explains itself. Extraction is deterministic and reads only .jumo/ and recognized state; narration merely phrases facts already extracted. A model never retrieves here, so an explanation cannot invent a commitment the contracts do not contain." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class jumo:Metadata ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path jumo:metadata ],
        [ sh:datatype xsd:string ;
            sh:in ( "jumo.dev/v1" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path jumo:apiVersion ],
        [ sh:datatype xsd:string ;
            sh:in ( "SelfDescription" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path jumo:kind ],
        [ sh:class jumo:SelfDescriptionSpec ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path jumo:spec ] ;
    sh:targetClass jumo:SelfDescription .

jumo:SolicitationContract a sh:NodeShape ;
    rdfs:comment "The only way one Project or Realm may solicit another (canonical decision 25). Exposes a typed interface, never internal Project data. Renamed from DelegationContract: the word \"delegation\" is reserved for authority delegation, explicitly excluded from V1, and this schema never modeled that -- it models a typed cross-Project request contract." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:in ( "SolicitationContract" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path jumo:kind ],
        [ sh:datatype xsd:string ;
            sh:in ( "jumo.dev/v1" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path jumo:apiVersion ],
        [ sh:class jumo:Metadata ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path jumo:metadata ],
        [ sh:class jumo:SolicitationContractSpec ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path jumo:spec ] ;
    sh:targetClass jumo:SolicitationContract .

jumo:TeamSpec a sh:NodeShape ;
    rdfs:comment "A Realm-owned composition of roles and nested teams. Coordinates eligible roles but grants no data access, capability or effect authority. Renamed from OperatorTeam." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class jumo:Metadata ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path jumo:metadata ],
        [ sh:datatype xsd:string ;
            sh:in ( "TeamSpec" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path jumo:kind ],
        [ sh:datatype xsd:string ;
            sh:in ( "jumo.dev/v1" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path jumo:apiVersion ],
        [ sh:class jumo:TeamSpecBody ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path jumo:spec ] ;
    sh:targetClass jumo:TeamSpec .

jumo:ThemePack a sh:NodeShape ;
    rdfs:comment "Naming, voice and visual presentation. Decorative and linguistic only: a theme carries no capability, policy, budget, assurance or workflow field, so renaming an agent cannot change what it may do. Open string-keyed maps in the source schema (terminology, roleOverrides, objectForms, rooms) are modeled as lists of key/value entries -- LinkML has no direct patternProperties/additionalProperties-map equivalent; the list form is exact for reading and writing, and Rego can still check \"no duplicate key\" as an invariant." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:in ( "jumo.dev/v1" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path jumo:apiVersion ],
        [ sh:class jumo:Metadata ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path jumo:metadata ],
        [ sh:datatype xsd:string ;
            sh:in ( "ThemePack" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path jumo:kind ],
        [ sh:class jumo:ThemePackSpec ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path jumo:spec ] ;
    sh:targetClass jumo:ThemePack .

jumo:VocabularySet a sh:NodeShape ;
    rdfs:comment "Generated concept glossary. One entry per CONTRACT kind names its canonical class, English and French display and plural forms, target instance directory and commit trailer -- the single source every directory, trailer, UI label and metamodel description name is renamed to match (canonical decision 15's sibling for vocabulary)." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class jumo:Metadata ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path jumo:metadata ],
        [ sh:datatype xsd:string ;
            sh:in ( "VocabularySet" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path jumo:kind ],
        [ sh:datatype xsd:string ;
            sh:in ( "jumo.dev/v1" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path jumo:apiVersion ],
        [ sh:class jumo:VocabularySetSpec ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path jumo:spec ] ;
    sh:targetClass jumo:VocabularySet .

jumo:WorkOrder a sh:NodeShape ;
    rdfs:comment "One unit of dispatched work, in Git. Renamed from WorkItem. Carries debtor, creditor, and condition (docs/concepts/positionnement-conceptuel.md#engagements-sociaux): an accepted order is not yet a social commitment without a named debtor, creditor, and discharge condition. The existing state enum (PROPOSED..FAILED) is retained as the closest Git-contract analogue of create/accept/discharge; the fuller create/discharge/release/cancel/assign operation set belongs to the runtime Matter/Episode this Git file is not -- this module models Git contracts only." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:in ( "jumo.dev/v1" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path jumo:apiVersion ],
        [ sh:class jumo:Metadata ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path jumo:metadata ],
        [ sh:datatype xsd:string ;
            sh:in ( "WorkOrder" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path jumo:kind ],
        [ sh:class jumo:WorkOrderSpec ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path jumo:spec ] ;
    sh:targetClass jumo:WorkOrder .

jumo:WorkerInvocation a sh:NodeShape ;
    rdfs:comment "Ephemeral recognized binding of a turn, route, cell, grant and execution evidence." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path jumo:executionCellRef ;
            sh:pattern "^[a-z][a-z0-9-]*$" ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path jumo:startedAt ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path jumo:routingDecisionRef ;
            sh:pattern "^[a-z][a-z0-9-]*$" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path jumo:status ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path jumo:id ;
            sh:pattern "^[a-z][a-z0-9-]*$" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path jumo:ownerRealm ;
            sh:pattern "^[a-z][a-z0-9-]*$" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path jumo:contextSha256 ;
            sh:pattern "^sha256:[0-9a-f]{64}$" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path jumo:capabilityGrantRef ;
            sh:pattern "^[a-z][a-z0-9-]*$" ] ;
    sh:targetClass jumo:WorkerInvocation .

jumo:WorkerRequirementProfile a sh:NodeShape ;
    rdfs:comment "A multi-dimensional task requirement vector used to select an eligible runtime Worker. Names neither provider nor model and defines no aggregate power score." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class jumo:Metadata ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path jumo:metadata ],
        [ sh:datatype xsd:string ;
            sh:in ( "WorkerRequirementProfile" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path jumo:kind ],
        [ sh:class jumo:WorkerRequirementProfileSpec ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path jumo:spec ],
        [ sh:datatype xsd:string ;
            sh:in ( "jumo.dev/v1" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path jumo:apiVersion ] ;
    sh:targetClass jumo:WorkerRequirementProfile .

jumo:WorkerSubstrate a sh:NodeShape ;
    rdfs:comment "Realm-owned declaration of a constrained worker runtime. A Git-reviewed security boundary: native CLI homes, repository mounts, database reach, open egress, container runtime sockets and built-in connector authority are absent so Jumo policy remains the only authority path." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:in ( "jumo.dev/v1" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path jumo:apiVersion ],
        [ sh:datatype xsd:string ;
            sh:in ( "WorkerSubstrate" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path jumo:kind ],
        [ sh:class jumo:Metadata ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path jumo:metadata ],
        [ sh:class jumo:WorkerSubstrateSpec ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path jumo:spec ] ;
    sh:targetClass jumo:WorkerSubstrate .

jumo:WorkloadCommand a sh:NodeShape ;
    rdfs:comment "Typed workload command claimed by pull from an ExecutionMachine, distinct from the Ansible-only MachineAdminCommand. Bound to the ExecutionCellLease that scopes its workload boundary (ADR-0047)." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:in ( "MCP_REGISTRY" "MCP_GATEWAY" "MCP_DISCOVERY" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 3 ;
            sh:path jumo:driverKind ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path jumo:machineId ;
            sh:pattern "^[a-z][a-z0-9-]*$" ],
        [ sh:class jumo:SchemaBoundPayload ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path jumo:payload ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path jumo:leaseId ;
            sh:pattern "^[a-z][a-z0-9-]*$" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path jumo:expiresAt ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path jumo:commandId ;
            sh:pattern "^[a-z][a-z0-9-]*$" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path jumo:workOrderId ;
            sh:pattern "^[a-z][a-z0-9-]*$" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path jumo:contractRevision ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path jumo:issuedAt ] ;
    sh:targetClass jumo:WorkloadCommand .

jumo:WorkloadCommandResult a sh:NodeShape ;
    rdfs:comment "Terminal outcome of a claimed WorkloadCommand, sanitized before it leaves the machine." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:in ( "QUEUED" "CLAIMED" "STARTED" "COMPLETED" "FAILED" "TIMED_OUT" "CANCELLED" "EXPIRED" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 2 ;
            sh:path jumo:status ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path jumo:sanitizedEvidence ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path jumo:machineId ;
            sh:pattern "^[a-z][a-z0-9-]*$" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path jumo:commandId ;
            sh:pattern "^[a-z][a-z0-9-]*$" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path jumo:evidenceDigest ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path jumo:completedAt ] ;
    sh:targetClass jumo:WorkloadCommandResult .

jumo:AcceptanceCriterion a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "One checkable claim about the finished result." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path jumo:statement ;
            sh:pattern "^.{10,}$" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path jumo:id ;
            sh:pattern "^.{1,}$" ] ;
    sh:targetClass jumo:AcceptanceCriterion .

jumo:AcknowledgementPolicy a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:in ( "DECOMPOSED" "DELEGATED" "WAITING" "NOTABLE_EFFECT" ) ;
            sh:minCount 1 ;
            sh:order 1 ;
            sh:path jumo:triggers ],
        [ sh:datatype xsd:string ;
            sh:in ( "ADAPTIVE" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path jumo:mode ],
        [ sh:datatype xsd:boolean ;
            sh:description "Source schema pins this to `const: true`; enforced in Rego." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path jumo:immediateAnswerMaySatisfy ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path jumo:maximumDelay ;
            sh:pattern "^P(?!$)(\\d+Y)?(\\d+M)?(\\d+D)?(T(?=\\d)(\\d+H)?(\\d+M)?(\\d+S)?)?$" ] ;
    sh:targetClass jumo:AcknowledgementPolicy .

jumo:ActionCapability a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:in ( "LOW" "MEDIUM" "HIGH" "ROOT" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 2 ;
            sh:path jumo:riskTier ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path jumo:description ;
            sh:pattern "^.{10,}$" ],
        [ sh:datatype xsd:string ;
            sh:description "The trusted component that applies the effect. Must not be the component that proposes it -- the prompt-injection boundary." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path jumo:appliedBy ],
        [ sh:description "Highest-blast-radius ring this capability may ever act on. Absent means the capability is bounded by policy and obligations alone." ;
            sh:in ( "RING_0_ROOT_OF_TRUST" "RING_1_CONTROL_PLANE" "RING_2_AGENT_BEHAVIOR" "RING_3_GOVERNED_PROJECT" ) ;
            sh:maxCount 1 ;
            sh:order 8 ;
            sh:path jumo:ringCeiling ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path jumo:maximumGrantDuration ;
            sh:pattern "^P(?!$)(\\d+Y)?(\\d+M)?(\\d+D)?(T(?=\\d)(\\d+H)?(\\d+M)?(\\d+S)?)?$" ],
        [ sh:in ( "STEP_UP_AUTHENTICATION" "HUMAN_OWNER_APPROVAL" "INDEPENDENT_VERIFICATION" "DISCLOSE_AGENT_IDENTITY" "RETAIN_PROVENANCE" "REDACT_SECRETS" "PREVIEW_BEFORE_SEND" ) ;
            sh:order 6 ;
            sh:path jumo:requiredObligations ],
        [ sh:in ( "NONE" "SELF_REPORTED" "OBSERVED" "INDEPENDENTLY_VERIFIED" ) ;
            sh:maxCount 1 ;
            sh:order 7 ;
            sh:path jumo:minimumAssurance ],
        [ sh:datatype xsd:boolean ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path jumo:producesExternalEffect ],
        [ sh:datatype xsd:boolean ;
            sh:description "Whether the effect can be inspected, corrected and undone. Kept alongside the newer EffectRecoveryKind (core.yaml) rather than replaced -- this boolean is the coarse policy-facing gate (irreversible needs stronger obligations); EffectRecoveryKind is the finer-grained recovery mechanism used where a specific capability's recovery path is modeled." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path jumo:reversible ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path jumo:name ;
            sh:pattern "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9]*){1,3}$" ] ;
    sh:targetClass jumo:ActionCapability .

jumo:ActionCapabilitySetSpec a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class jumo:ActionCapability ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path jumo:capabilities ] ;
    sh:targetClass jumo:ActionCapabilitySetSpec .

jumo:AdvisorDialogueOption a sh:NodeShape ;
    rdfs:comment "One named effort option for a role. CapabilityProfile expresses intent; EngagementMethod carries the prompt, worker, budget, assurance and stages." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class jumo:ContractReference ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path jumo:engagementMethodRef ],
        [ sh:class jumo:ContractReference ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path jumo:capabilityProfileRef ],
        [ sh:datatype xsd:boolean ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path jumo:defaultOption ] ;
    sh:targetClass jumo:AdvisorDialogueOption .

jumo:AdvisorProfileSpec a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class jumo:AdvisorDialogueOption ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path jumo:dialogueOptions ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path jumo:ownerRealm ;
            sh:pattern "^[a-z][a-z0-9-]*$" ],
        [ sh:class jumo:ContractReference ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path jumo:roleDefinitionRef ],
        [ sh:class jumo:ContractReference ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path jumo:practiceRefs ] ;
    sh:targetClass jumo:AdvisorProfileSpec .

jumo:AgentCard a sh:NodeShape ;
    rdfs:comment "A2A v1.0 Agent Card projection. Discoverability metadata, not a capability grant." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:in ( "JSONRPC" "GRPC" "HTTP_JSON" ) ;
            sh:order 2 ;
            sh:path jumo:preferredTransports ],
        [ sh:datatype xsd:string ;
            sh:in ( "1.0" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path jumo:protocolVersion ],
        [ sh:class jumo:AgentCardSkill ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path jumo:skills ],
        [ sh:in ( "DISABLED" "PUBLIC" "AUTHENTICATED_EXTENDED" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 1 ;
            sh:path jumo:exposure ] ;
    sh:targetClass jumo:AgentCard .

jumo:AgentCardSkill a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path jumo:capabilityRefs ;
            sh:pattern "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9]*){1,3}$" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path jumo:id ;
            sh:pattern "^[a-z][a-z0-9-]*$" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path jumo:name ;
            sh:pattern "^.{1,}$" ] ;
    sh:targetClass jumo:AgentCardSkill .

jumo:AgentDefinitionSpec a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:in ( "RING_0_ROOT_OF_TRUST" "RING_1_CONTROL_PLANE" "RING_2_AGENT_BEHAVIOR" "RING_3_GOVERNED_PROJECT" ) ;
            sh:maxCount 1 ;
            sh:order 4 ;
            sh:path jumo:modificationRing ],
        [ sh:in ( "self_grant_capability" "bypass_policy" "infer_transitive_access" "self_approve_privilege_change" "modify_root_of_trust" "act_as_super_administrator" ) ;
            sh:minCount 1 ;
            sh:order 2 ;
            sh:path jumo:prohibitedAuthority ],
        [ sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path jumo:responsibilities ;
            sh:pattern "^.{5,}$" ],
        [ sh:datatype xsd:string ;
            sh:description "A request, not a grant. Policy decides." ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path jumo:requestedCapabilities ;
            sh:pattern "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9]*){1,3}$" ],
        [ sh:in ( "OBSERVE" "DRAFT" "SUPERVISED" "BOUNDED_AUTONOMOUS" ) ;
            sh:maxCount 1 ;
            sh:order 3 ;
            sh:path jumo:defaultAutonomy ] ;
    sh:targetClass jumo:AgentDefinitionSpec .

jumo:AllowedRequest a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:in ( "PUBLISHED_SUMMARY" "TYPED_ATTENTION_ONLY" "PROJECT_SCOPED" "REALM_PRIVATE" "ORGANIZATION_ONLY" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 1 ;
            sh:path jumo:dataScope ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path jumo:capability ;
            sh:pattern "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9]*){1,3}$" ] ;
    sh:targetClass jumo:AllowedRequest .

jumo:ApiOperation a sh:NodeShape ;
    rdfs:comment "Typed operation declaration in an API surface contract." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path jumo:errorCodes ],
        [ sh:class jumo:SchemaBinding ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path jumo:requestBinding ],
        [ sh:in ( "STEP_UP_AUTHENTICATION" "HUMAN_OWNER_APPROVAL" "INDEPENDENT_VERIFICATION" "DISCLOSE_AGENT_IDENTITY" "RETAIN_PROVENANCE" "REDACT_SECRETS" "PREVIEW_BEFORE_SEND" ) ;
            sh:order 7 ;
            sh:path jumo:obligations ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path jumo:operationId ],
        [ sh:in ( "PUBLIC_WEB" "REALM_PRIVATE" "MACHINE_MTLS" "INTERNAL_WORKER" "POLICY" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 3 ;
            sh:path jumo:audience ],
        [ sh:class jumo:ApiResponseBinding ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path jumo:responseBindings ],
        [ sh:in ( "GET" "POST" "PUT" "DELETE" "PATCH" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 1 ;
            sh:path jumo:method ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path jumo:path ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path jumo:authAction ] ;
    sh:targetClass jumo:ApiOperation .

jumo:ApiResponseBinding a sh:NodeShape ;
    rdfs:comment "Response schema binding for a specific HTTP status code." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class jumo:SchemaBinding ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path jumo:schemaBinding ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path jumo:description ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path jumo:mediaType ],
        [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path jumo:statusCode ] ;
    sh:targetClass jumo:ApiResponseBinding .

jumo:ApiSurfaceSpec a sh:NodeShape ;
    rdfs:comment "Specification of an ApiSurface contract." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path jumo:basePath ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path jumo:surfaceId ],
        [ sh:datatype xsd:string ;
            sh:defaultValue "HTTPS"^^xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path jumo:protocol ],
        [ sh:class jumo:ApiOperation ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path jumo:operations ],
        [ sh:in ( "PUBLIC_WEB" "REALM_PRIVATE" "MACHINE_MTLS" "INTERNAL_WORKER" "POLICY" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 1 ;
            sh:path jumo:audience ] ;
    sh:targetClass jumo:ApiSurfaceSpec .

jumo:AppraisalDimensions a sh:NodeShape ;
    rdfs:comment "Four questions asked of every submission, separate because they fail independently: a perfectly signed artifact can be unusable by an agent, and a well-described tool can have no business in this Realm." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class jumo:AppraisalDimension ;
            sh:description "Signature, digest, SBOM, licence and publisher." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path jumo:provenance ],
        [ sh:class jumo:AppraisalDimension ;
            sh:description "Whether each exposed operation maps to a capability this Realm already declares." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path jumo:relevance ],
        [ sh:class jumo:AppraisalDimension ;
            sh:description "Whether an agent can use it without guessing." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path jumo:agentUsability ],
        [ sh:class jumo:AppraisalDimension ;
            sh:description "Blast radius per operation, network egress, secret material held, and untrusted output." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path jumo:security ] ;
    sh:targetClass jumo:AppraisalDimensions .

jumo:AssistedJourneyCollectionProjection a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path jumo:field ],
        [ sh:datatype xsd:string ;
            sh:description "The keys each emitted item carries, in the order the document declares them." ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path jumo:keys ],
        [ sh:class jumo:AssistedJourneyFieldValidation ;
            sh:description "Checks applied to each item, naming a key of the item rather than a field of the payload." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path jumo:itemValidations ],
        [ sh:datatype xsd:string ;
            sh:description "When the collected item is a plain reference id rather than an object (an ENTITY_COLLECTION field submits ids), the declared contract kind it names. Must be a declared kind (Rego). The resolved document supplies each declared key not already carried by the submission itself -- keys read spec.<key>, falling back to metadata.name -- so the emitted item never trusts a client-submitted facet the contract can resolve authoritatively instead." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path jumo:itemReferenceKind ],
        [ sh:datatype xsd:string ;
            sh:description "Keys carried only when the collected item supplies a non-blank value." ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path jumo:optionalKeys ] ;
    sh:targetClass jumo:AssistedJourneyCollectionProjection .

jumo:AssistedJourneyEmission a sh:NodeShape ;
    rdfs:comment "The declarative replacement for a per-journey emission branch. Everything here is read by one generic renderer: nothing in it names a journey, and nothing outside it decides what a journey emits." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class jumo:AssistedJourneyRoutingEligibilityCheck ;
            sh:description "Refuses a proposal that would route work to a team the project did not declare eligible. A project with no declared eligibility constrains nothing, as RoutingEligibility itself is additive." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 9 ;
            sh:path jumo:routingEligibilityCheck ],
        [ sh:datatype xsd:string ;
            sh:description "Field names whose collected \"true\"/\"false\" string is coerced to a real YAML boolean before rendering. The platform compensates here rather than in the renderer: the generic step form has no boolean-aware widget yet (projection-field-options-resolution), so a BOOLEAN_FLAG-shaped value still arrives as free text." ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path jumo:booleanFields ],
        [ sh:class jumo:AssistedJourneyFieldValidation ;
            sh:description "Field-level checks the collected payload must pass before anything is written." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path jumo:validations ],
        [ sh:datatype xsd:string ;
            sh:description "The contract kind the emitted document declares. Must name a declared kind (Rego)." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path jumo:targetKind ],
        [ sh:class jumo:AssistedJourneyEmittedIdentifier ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path jumo:identifier ],
        [ sh:class jumo:AssistedJourneyFieldCondition ;
            sh:description "Fields the emitted document carries only under a declared condition. A template drops a key whose lone placeholder resolves to nothing, so a conditional key needs no template conditional of its own -- the condition removes the value and the existing absence rule removes the key. Applied after fieldDefaults, so a default never resurrects a field the condition has removed." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path jumo:fieldConditions ],
        [ sh:class jumo:AssistedJourneyReferenceCheck ;
            sh:description "Checks that a collected value names a contract that exists, so a journey never proposes a document pointing at nothing." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path jumo:referenceChecks ],
        [ sh:class jumo:ContractReference ;
            sh:description "The DocumentTemplate that renders the document. Must resolve to a declared template rendering the same kind (Rego). Absent while a journey emits a document this vocabulary cannot yet describe -- the renderer refuses such an emission rather than guessing, and the journey keeps a named branch until a template can replace it, which is exactly what the boundary allowlist records." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path jumo:documentTemplateRef ],
        [ sh:datatype xsd:string ;
            sh:description "Where the document is written, with ${id} standing for the resolved identifier, e.g. `.jumo/teams/${id}.yml`." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path jumo:pathTemplate ],
        [ sh:class jumo:AssistedJourneyFieldDefault ;
            sh:description "Values used when a field was not collected, so a template needs no conditional of its own." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path jumo:fieldDefaults ],
        [ sh:class jumo:AssistedJourneyCollectionProjection ;
            sh:description "What a multivalued field contributes to the emitted document. A collected item may carry more than the contract needs, so the emitted item is a projection of it -- declared here rather than decided by the renderer, which is what keeps the emitted shape a contract fact." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path jumo:collectionProjections ] ;
    sh:targetClass jumo:AssistedJourneyEmission .

jumo:AssistedJourneyEmittedIdentifier a sh:NodeShape ;
    rdfs:comment "How the emitted document's identifier is derived from the run, always by slugifying one collected field rather than by a rule the platform keeps per journey." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:defaultValue "NONE" ;
            sh:in ( "NONE" "RUN_PREFIX" ) ;
            sh:maxCount 1 ;
            sh:order 2 ;
            sh:path jumo:suffix ],
        [ sh:datatype xsd:string ;
            sh:description "Used when the field was not collected." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path jumo:defaultValue ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path jumo:fromField ] ;
    sh:targetClass jumo:AssistedJourneyEmittedIdentifier .

jumo:AssistedJourneyFieldCondition a sh:NodeShape ;
    rdfs:comment "One field of the emitted document and the collected value that decides whether it is present at all." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "`field` is kept when `whenField` equals this value, and removed otherwise." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path jumo:equalsValue ],
        [ sh:datatype xsd:string ;
            sh:description "The collected or derived value the presence of `field` depends on." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path jumo:whenField ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path jumo:field ] ;
    sh:targetClass jumo:AssistedJourneyFieldCondition .

jumo:AssistedJourneyFieldDefault a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "May itself interpolate ${id} or another collected field." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path jumo:value ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path jumo:field ] ;
    sh:targetClass jumo:AssistedJourneyFieldDefault .

jumo:AssistedJourneyReferenceCheck a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "The contract kind the value must name. Must be a declared kind (Rego)." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path jumo:kind ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path jumo:field ],
        [ sh:datatype xsd:string ;
            sh:description "For a multivalued field, the key inside each item that carries the reference." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path jumo:itemPath ] ;
    sh:targetClass jumo:AssistedJourneyReferenceCheck .

jumo:AssistedJourneyRoutingEligibilityCheck a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path jumo:projectField ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path jumo:teamField ] ;
    sh:targetClass jumo:AssistedJourneyRoutingEligibilityCheck .

jumo:AssistedJourneySpec a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path jumo:journeyId ;
            sh:pattern "^[a-z][a-z0-9-]*$" ],
        [ sh:in ( "SINGLE_ACTIVE_RUN" "MULTIPLE_ACTIVE_RUNS" ) ;
            sh:maxCount 1 ;
            sh:order 6 ;
            sh:path jumo:concurrencyPolicy ],
        [ sh:class jumo:AssistedJourneyStep ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 15 ;
            sh:path jumo:steps ],
        [ sh:datatype xsd:boolean ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path jumo:lifetimeUnique ],
        [ sh:class jumo:AssistedJourneyEmission ;
            sh:description "What a PROPOSAL journey emits when its run completes: the contract kind, where it is written, the template that renders it, and the checks the collected fields must pass. Rego requires it of every PROPOSAL journey (canonical decision 15) -- without it the platform would have to recognise the journey by name to know what it produces, which is the dispatch this slot exists to remove." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 14 ;
            sh:path jumo:emission ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path jumo:heroImage ],
        [ sh:defaultValue "SEQUENTIAL" ;
            sh:description "FREE permits navigation among dependency-ready steps; dependencies remain mandatory server-side." ;
            sh:in ( "SEQUENTIAL" "FREE" ) ;
            sh:maxCount 1 ;
            sh:order 13 ;
            sh:path jumo:navigationMode ],
        [ sh:class jumo:ContractReference ;
            sh:description "Names the ResourceBudget whose modelCalls limit bounds the clarification-turn ceiling (AC1). The journey does not declare its own ceiling." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 10 ;
            sh:path jumo:resourceBudgetRef ],
        [ sh:defaultValue "PROPOSAL" ;
            sh:in ( "PROPOSAL" "OBSERVATION" ) ;
            sh:maxCount 1 ;
            sh:order 12 ;
            sh:path jumo:completionMode ],
        [ sh:datatype xsd:boolean ;
            sh:defaultValue true ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path jumo:interruptible ],
        [ sh:datatype xsd:boolean ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path jumo:firstRunMandatory ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path jumo:name ],
        [ sh:datatype xsd:string ;
            sh:description "Catalog category for this journey." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path jumo:category ],
        [ sh:datatype xsd:string ;
            sh:description "Display icon for this journey." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path jumo:icon ],
        [ sh:datatype xsd:string ;
            sh:description "The single capability a proposal journey may invoke. Observation journeys leave this absent." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path jumo:emitsCapability ;
            sh:pattern "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9]*){1,3}$" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path jumo:description ] ;
    sh:targetClass jumo:AssistedJourneySpec .

jumo:AssistedJourneyStep a sh:NodeShape ;
    rdfs:comment "stepKind/projectionRef/processRef are additive: the model-driven rendering engine that consumes them does not exist yet, so requiredFields stays required and load-bearing -- JourneyService (control-plane) reads it server-side and apps/web/components/journey/JourneyRunner.vue reads it client-side. requiredFields is retired once every AssistedJourney step declares projectionRef/processRef and the renderer that replaces JourneyRunner.vue exists; until then both describe the same steps." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Step-level hero image, overriding the journey's heroImage for this step only. Falls back to AssistedJourneySpec.heroImage when absent. Not validated by the schema (same convention as heroImage) -- a kit-distributed asset once JumoKit exports binary assets (portability.yaml)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path jumo:image ],
        [ sh:datatype xsd:string ;
            sh:description "Step IDs that must be completed before this step becomes available." ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path jumo:dependsOn ],
        [ sh:class jumo:ContractReference ;
            sh:description "The PromptTemplate this step uses when stepKind is DIALOGUE_COLLECT." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path jumo:promptTemplateRef ],
        [ sh:datatype xsd:string ;
            sh:description "i18n key resolving this step's user-facing description. When present, takes precedence over the literal description string, which remains the fallback for journeys that have not been translated." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path jumo:descriptionI18nKey ],
        [ sh:class jumo:ContractReference ;
            sh:description "The ProcessSpec whose run an AWAIT step observes. Required on AWAIT once stepKind is set (Rego)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path jumo:processSpecRef ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path jumo:name ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path jumo:id ],
        [ sh:datatype xsd:boolean ;
            sh:description "Marks a dependency-ready step as part of a parallelizable work group in the renderer." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path jumo:parallelizable ],
        [ sh:class jumo:ContractReference ;
            sh:description "Generic real observation required before this step can advance." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 9 ;
            sh:path jumo:verificationSpecRef ],
        [ sh:class jumo:ContractReference ;
            sh:description "The ProjectionSpec this step renders. Its `of:` class is the step payload type, so the shape is derived rather than declared twice. Required on COLLECT and CONFIRM once stepKind is set (Rego)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path jumo:projectionSpecRef ],
        [ sh:datatype xsd:string ;
            sh:nodeKind sh:Literal ;
            sh:order 15 ;
            sh:path jumo:requiredFields ],
        [ sh:datatype xsd:string ;
            sh:description "i18n key resolving this step's personaNarration (\"Nestor's voice\"). Same fallback convention as descriptionI18nKey." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path jumo:narrationI18nKey ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path jumo:personaNarration ],
        [ sh:class jumo:ContractReference ;
            sh:description "The AssistedJourney this step delegates to when stepKind is SUB_JOURNEY." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path jumo:subAssistedJourneyRef ],
        [ sh:description "Required from the model-driven renderer onward (Rego)." ;
            sh:in ( "COLLECT" "AWAIT" "CONFIRM" "DIALOGUE_COLLECT" "SUB_JOURNEY" ) ;
            sh:maxCount 1 ;
            sh:order 4 ;
            sh:path jumo:stepKind ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path jumo:description ] ;
    sh:targetClass jumo:AssistedJourneyStep .

jumo:AttentionDecisionOption a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path jumo:id ;
            sh:pattern "^[a-z][a-z0-9-]*$" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path jumo:capabilityRef ;
            sh:pattern "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9]*){1,3}$" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path jumo:label ;
            sh:pattern "^.{1,}$" ] ;
    sh:targetClass jumo:AttentionDecisionOption .

jumo:AttentionItemSpec a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:in ( "DECISION_REQUEST" "RESULT" "RISK" "ADMISSION_REFUSED" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 0 ;
            sh:path jumo:type ],
        [ sh:datatype xsd:float ;
            sh:description "Confidence of the interpretation behind this item, not of the outcome it reports." ;
            sh:maxCount 1 ;
            sh:maxInclusive 1 ;
            sh:minInclusive 0 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path jumo:confidence ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path jumo:decisionRef ;
            sh:pattern "^.{1,}$" ],
        [ sh:in ( "LOW" "NORMAL" "HIGH" "CRITICAL" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 6 ;
            sh:path jumo:urgency ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path jumo:occurredAt ],
        [ sh:class jumo:AttentionDecisionOption ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path jumo:decisionOptions ],
        [ sh:class jumo:AttentionTarget ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path jumo:target ],
        [ sh:class jumo:AttentionSource ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path jumo:source ],
        [ sh:description "Same enumeration as capability data access, retrieval and rendering (canonical decision 98)." ;
            sh:in ( "PUBLISHED_SUMMARY" "TYPED_ATTENTION_ONLY" "PROJECT_SCOPED" "REALM_PRIVATE" "ORGANIZATION_ONLY" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 5 ;
            sh:path jumo:classification ],
        [ sh:in ( "LIVE" "DIGEST" "ESCALATION_ONLY" "DELEGATED" "MUTED_UNTIL" "QUIET_HOURS" ) ;
            sh:maxCount 1 ;
            sh:order 9 ;
            sh:path jumo:deliveryMode ],
        [ sh:in ( "NONE" "ACKNOWLEDGEMENT" "INFORMATION" "DECISION" ) ;
            sh:maxCount 1 ;
            sh:order 8 ;
            sh:path jumo:requestedResponse ],
        [ sh:description "Required on ADMISSION_REFUSED (Rego)." ;
            sh:in ( "NO_ELIGIBLE_ROLE" "ADMISSION_DECLINED" "POLICY_DENIED" ) ;
            sh:maxCount 1 ;
            sh:order 11 ;
            sh:path jumo:admissionReason ],
        [ sh:datatype xsd:string ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path jumo:relatedCommitments ;
            sh:pattern "^.{1,}$" ],
        [ sh:datatype xsd:string ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path jumo:evidenceRefs ;
            sh:pattern "^.{1,}$" ],
        [ sh:in ( "DEFER_TO_DIGEST" "MAY_INTERRUPT" "QUIET_HOURS_EXEMPT" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 7 ;
            sh:path jumo:interruptibility ] ;
    sh:targetClass jumo:AttentionItemSpec .

jumo:AttentionSource a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path jumo:episodeId ;
            sh:pattern "^.{1,}$" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path jumo:realmId ;
            sh:pattern "^[a-z][a-z0-9-]*$" ],
        [ sh:datatype xsd:string ;
            sh:description "The individual acting role this came from, never a team (ADR-0017). Absent on ADMISSION_REFUSED." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path jumo:roleId ;
            sh:pattern "^[a-z][a-z0-9-]*$" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path jumo:projectId ;
            sh:pattern "^[a-z][a-z0-9-]*$" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path jumo:journeyRunId ;
            sh:pattern "^.{1,}$" ] ;
    sh:targetClass jumo:AttentionSource .

jumo:AttentionTarget a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path jumo:subjectRef ;
            sh:pattern "^[a-z][a-z0-9-]*$" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path jumo:realmRef ;
            sh:pattern "^[a-z][a-z0-9-]*$" ],
        [ sh:in ( "ROLE" "PRINCIPAL" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 1 ;
            sh:path jumo:subjectKind ] ;
    sh:targetClass jumo:AttentionTarget .

jumo:BudgetLimits a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:minInclusive 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path jumo:modelCalls ],
        [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:minInclusive 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path jumo:tokens ],
        [ sh:datatype xsd:float ;
            sh:maxCount 1 ;
            sh:minInclusive 0 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path jumo:estimatedCostEur ],
        [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:minInclusive 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path jumo:toolCalls ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path jumo:wallClock ;
            sh:pattern "^P(?!$)(\\d+Y)?(\\d+M)?(\\d+D)?(T(?=\\d)(\\d+H)?(\\d+M)?(\\d+S)?)?$" ] ;
    sh:targetClass jumo:BudgetLimits .

jumo:CapabilityProfileSpec a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path jumo:ownerRealm ;
            sh:pattern "^[a-z][a-z0-9-]*$" ],
        [ sh:datatype xsd:string ;
            sh:description "Optional ThemePack terminology key. Decoration only." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path jumo:presenceRef ;
            sh:pattern "^[a-z][a-zA-Z0-9]*$" ],
        [ sh:class jumo:ContractReference ;
            sh:description "The WorkerRequirementProfile this preset resolves to." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path jumo:workerRequirementProfileRef ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path jumo:intent ;
            sh:pattern "^.{10,}$" ] ;
    sh:targetClass jumo:CapabilityProfileSpec .

jumo:ChangeSetFile a sh:NodeShape ;
    rdfs:comment "One ordered file within a ChangeSetProposal. Path traversal and duplicate paths within a proposal are rejected by ChangeSetProposalService, not by this shape." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path jumo:contentDigest ;
            sh:pattern "^sha256:[0-9a-f]{64}$" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path jumo:path ;
            sh:pattern "^.{1,}$" ] ;
    sh:targetClass jumo:ChangeSetFile .

jumo:ChiefOfStaffProfileSpec a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path jumo:ownerRealm ;
            sh:pattern "^[a-z][a-z0-9-]*$" ],
        [ sh:class jumo:ContractReference ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 9 ;
            sh:path jumo:statusPracticeRef ],
        [ sh:class jumo:DispositionRule ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path jumo:dispositionRules ],
        [ sh:class jumo:ContractReference ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path jumo:intakeProcessSpecRef ],
        [ sh:datatype xsd:string ;
            sh:in ( "ROUTING_ONLY" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path jumo:authority ],
        [ sh:datatype xsd:string ;
            sh:in ( "OWN_REALM_SANITIZED" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path jumo:connectorCatalogScope ],
        [ sh:class jumo:ContractReference ;
            sh:description "Governed child Episode started by HANDLE_DIRECTLY; cannot be the intake workflow itself (Rego). References a ProcessSpec (execution.yaml)." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path jumo:directWorkProcessSpecRef ],
        [ sh:class jumo:ClarificationPolicy ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path jumo:clarification ],
        [ sh:class jumo:AcknowledgementPolicy ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path jumo:acknowledgement ],
        [ sh:class jumo:ContractReference ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path jumo:roleDefinitionRef ] ;
    sh:targetClass jumo:ChiefOfStaffProfileSpec .

jumo:ClarificationPolicy a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:boolean ;
            sh:description "Source schema pins this to `const: true`; enforced in Rego, not expressible as a LinkML boolean constant." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path jumo:enabled ],
        [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:maxInclusive 10 ;
            sh:minCount 1 ;
            sh:minInclusive 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path jumo:maximumTurns ],
        [ sh:datatype xsd:string ;
            sh:in ( "ASK_FOR_INFORMATION" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path jumo:onInsufficientInformation ],
        [ sh:in ( "DEFER" "DECLINE" "ESCALATE" ) ;
            sh:maxCount 1 ;
            sh:order 3 ;
            sh:path jumo:onExhaustion ] ;
    sh:targetClass jumo:ClarificationPolicy .

jumo:CliReleaseSpec a sh:NodeShape ;
    rdfs:comment "Specification for a CliRelease contract." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path jumo:platform ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path jumo:sbomDigest ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path jumo:ociImage ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path jumo:version ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path jumo:provenanceDigest ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path jumo:toolRef ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path jumo:signatureDigest ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path jumo:imageDigest ] ;
    sh:targetClass jumo:CliReleaseSpec .

jumo:CliToolDefinitionSpec a sh:NodeShape ;
    rdfs:comment "Specification for a CliToolDefinition contract." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path jumo:toolName ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path jumo:defaultProfile ],
        [ sh:description "The WorkerCli value this tool implements. Without it a runtime has to derive the tool from the enum value by naming convention, which is the instance-naming the boundary forbids." ;
            sh:in ( "CLAUDE_CODE" "CODEX" "GEMINI_CLI" "COPILOT_CLI" ) ;
            sh:maxCount 1 ;
            sh:order 1 ;
            sh:path jumo:cli ],
        [ sh:datatype xsd:string ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path jumo:supportedAdapterProfiles ],
        [ sh:in ( "QUALIFIED" "DECLARABLE_ONLY" "DEPRECATED" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 2 ;
            sh:path jumo:qualification ] ;
    sh:targetClass jumo:CliToolDefinitionSpec .

jumo:ComplianceMapping a sh:NodeShape ;
    rdfs:comment "Example mappings are marked DRAFT; no MAPPED or EVIDENCED status may be displayed as a certification claim (enforced in Rego, not here)." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "e.g. an AI Act article number, an ISO clause number." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path jumo:referentialArticle ],
        [ sh:datatype xsd:boolean ;
            sh:defaultValue true ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path jumo:draft ],
        [ sh:datatype xsd:string ;
            sh:description "References a Control.controlId in the linked ControlCatalog." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path jumo:controlRef ] ;
    sh:targetClass jumo:ComplianceMapping .

jumo:ComplianceProfileSpec a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Stable URI to the official referential. No copyrighted text is stored here." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path jumo:officialUri ],
        [ sh:class jumo:ComplianceMapping ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path jumo:mappings ],
        [ sh:class jumo:ProcessingRegisterEntry ;
            sh:description "RGPD art. 30 register of processing activities this profile covers. Empty for non-privacy referentials." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path jumo:processingRegister ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path jumo:ownerRealm ;
            sh:pattern "^[a-z][a-z0-9-]*$" ],
        [ sh:in ( "NOT_ASSESSED" "MAPPED" "EVIDENCED" "EXTERNALLY_ATTESTED" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 4 ;
            sh:path jumo:status ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path jumo:frameworkName ;
            sh:pattern "^.{3,}$" ],
        [ sh:class jumo:ContractReference ;
            sh:description "The ControlCatalog this profile maps against." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path jumo:controlCatalogRef ],
        [ sh:datatype xsd:string ;
            sh:description "e.g. \"2023\", \"2022\" -- the referential's published edition, never its text." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path jumo:edition ] ;
    sh:targetClass jumo:ComplianceProfileSpec .

jumo:ConnectorAppraisalSpec a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "The exact artifact that was looked at. When the bundle digest moves, this appraisal stops being accepted, so an upstream version bump cannot inherit the prior review." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path jumo:appraisedDigest ;
            sh:pattern "^sha256:[0-9a-f]{64}$" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path jumo:ownerRealm ;
            sh:pattern "^[a-z][a-z0-9-]*$" ],
        [ sh:datatype xsd:string ;
            sh:description "Required and non-empty under ACCEPTED_WITH_CONDITIONS (Rego)." ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path jumo:conditions ;
            sh:pattern "^.{10,}$" ],
        [ sh:class jumo:AppraisalDimensions ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path jumo:dimensions ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path jumo:appraisedAt ],
        [ sh:class jumo:ContractReference ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path jumo:appraisedByRoleDefinitionRef ],
        [ sh:class jumo:ContractReference ;
            sh:description "The role that checked it, which is not the one that performed it." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path jumo:verifiedByRoleDefinitionRef ],
        [ sh:class jumo:UpstreamToolEntry ;
            sh:description "Every tool the upstream server offered when it was looked at, exposed or not -- enumerating what was held back is the point of the whole document." ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 9 ;
            sh:path jumo:upstreamInventory ],
        [ sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path jumo:evidenceRefs ;
            sh:pattern "^.{1,}$" ],
        [ sh:in ( "ACCEPTED" "ACCEPTED_WITH_CONDITIONS" "REFUSED" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 6 ;
            sh:path jumo:verdict ],
        [ sh:class jumo:ContractReference ;
            sh:description "The McpBundle this appraises. Refused across Realms (Rego)." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path jumo:mcpBundleRef ] ;
    sh:targetClass jumo:ConnectorAppraisalSpec .

jumo:ConnectorDefinitionSpec a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class jumo:ContractReference ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path jumo:connectorPackageRef ],
        [ sh:class jumo:ConnectorOperation ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path jumo:operations ],
        [ sh:in ( "MCP" "HTTP" "LOCAL_PROCESS" "FORGE" "CHANNEL" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 2 ;
            sh:path jumo:transport ],
        [ sh:in ( "CONTROL_PLANE" "CLIENT_CELL" "EXECUTION_CELL" "REMOTE" ) ;
            sh:maxCount 1 ;
            sh:order 7 ;
            sh:path jumo:placement ],
        [ sh:class jumo:ContractReference ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path jumo:mcpBundleRef ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path jumo:configurationRef ;
            sh:pattern "^[a-z][a-z0-9.-]{2,}$" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path jumo:ownerRealm ;
            sh:pattern "^[a-z][a-z0-9-]*$" ],
        [ sh:in ( "DECLARED" "ENABLED" "SUSPENDED" "RETIRED" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 1 ;
            sh:path jumo:lifecycle ],
        [ sh:class jumo:ContractReference ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path jumo:remoteMcpServiceRef ] ;
    sh:targetClass jumo:ConnectorDefinitionSpec .

jumo:ConnectorIntegrationSpec a sh:NodeShape ;
    rdfs:comment "Specification for a ConnectorIntegration contract." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path jumo:ownerRealm ;
            sh:pattern "^[a-z][a-z0-9-]*$" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path jumo:category ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path jumo:description ],
        [ sh:datatype xsd:string ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path jumo:memberConnectorRefs ] ;
    sh:targetClass jumo:ConnectorIntegrationSpec .

jumo:ConnectorIntentRationale a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class jumo:ContractReference ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path jumo:connectorDefinitionRef ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path jumo:reason ;
            sh:pattern "^.{1,}$" ] ;
    sh:targetClass jumo:ConnectorIntentRationale .

jumo:ConnectorOperation a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class jumo:ContractReference ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path jumo:secretBindingRefs ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path jumo:bundleOperationRef ;
            sh:pattern "^[a-z][a-z0-9-]*$" ],
        [ sh:in ( "REQUIRED" "NOT_APPLICABLE" ) ;
            sh:maxCount 1 ;
            sh:order 6 ;
            sh:path jumo:idempotency ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path jumo:capabilityRef ;
            sh:pattern "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9]*){1,3}$" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path jumo:description ;
            sh:pattern "^.{10,}$" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path jumo:inputSchemaRef ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path jumo:id ;
            sh:pattern "^[a-z][a-z0-9-]*$" ],
        [ sh:in ( "REQUIRED" "NOT_REQUIRED" ) ;
            sh:maxCount 1 ;
            sh:order 7 ;
            sh:path jumo:reconciliation ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path jumo:outputSchemaRef ] ;
    sh:targetClass jumo:ConnectorOperation .

jumo:ConnectorPackageCertificationSpec a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path jumo:imageDigest ;
            sh:pattern "^sha256:[0-9a-f]{64}$" ],
        [ sh:datatype xsd:string ;
            sh:description "One digest per McpServerDescriptor in the certified package's supportedTransports, each sha256: followed by the SHA-256 of that descriptor's canonical JSON -- object keys sorted, no insignificant whitespace, absent fields omitted. Certifying a transport the package does not declare, or omitting one it does, is refused by corpus.certification.transport-consistency. Computed by scripts/generate/compute-package-digests.py." ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path jumo:supportedTransportDigests ;
            sh:pattern "^sha256:[0-9a-f]{64}$" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path jumo:provenanceDigest ;
            sh:pattern "^sha256:[0-9a-f]{64}$" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path jumo:licenceDigest ;
            sh:pattern "^sha256:[0-9a-f]{64}$" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path jumo:sbomDigest ;
            sh:pattern "^sha256:[0-9a-f]{64}$" ],
        [ sh:class jumo:ContractReference ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path jumo:connectorPackageRef ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path jumo:signatureDigest ;
            sh:pattern "^sha256:[0-9a-f]{64}$" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path jumo:testDigest ;
            sh:pattern "^sha256:[0-9a-f]{64}$" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path jumo:packageDigest ;
            sh:pattern "^sha256:[0-9a-f]{64}$" ] ;
    sh:targetClass jumo:ConnectorPackageCertificationSpec .

jumo:ConnectorPackageSpec a sh:NodeShape ;
    rdfs:comment "Specification for a ConnectorPackage manifest." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path jumo:provenanceDigest ],
        [ sh:datatype xsd:boolean ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 17 ;
            sh:path jumo:requiresAdapter ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path jumo:connectorId ;
            sh:pattern "^[a-z][a-z0-9-]*$" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path jumo:sbomDigest ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path jumo:licenceDigest ],
        [ sh:class jumo:McpCatalogProvenancePin ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 12 ;
            sh:path jumo:provenancePins ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path jumo:version ],
        [ sh:class jumo:McpServerDescriptor ;
            sh:description "The MCP transports this package exposes. A ConnectorPackageCertification attests to exactly this set through supportedTransportDigests, one digest per descriptor." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path jumo:supportedTransports ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path jumo:testDigest ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path jumo:manifestPath ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path jumo:signatureDigest ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path jumo:contractsPath ],
        [ sh:datatype xsd:string ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path jumo:sourcePaths ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path jumo:runtimeImageDigest ],
        [ sh:datatype xsd:string ;
            sh:nodeKind sh:Literal ;
            sh:order 15 ;
            sh:path jumo:testPlanRefs ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 16 ;
            sh:path jumo:buildRecipeRef ],
        [ sh:datatype xsd:string ;
            sh:description "SHA-256 of the package's content manifest. The manifest lists one line per content file, \"<sha256 hex>  <path relative to the package directory>\", sorted by path, newline terminated; packageDigest is sha256: followed by the SHA-256 of those bytes. Content files are exactly sourcePaths when declared, otherwise every file in the package directory except this manifest, which carries the digest and so cannot hash itself. Computed and checked by scripts/generate/compute-package-digests.py." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path jumo:packageDigest ;
            sh:pattern "^sha256:[0-9a-f]{64}$" ],
        [ sh:datatype xsd:string ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path jumo:contractPaths ] ;
    sh:targetClass jumo:ConnectorPackageSpec .

jumo:ConnectorTestCase a sh:NodeShape ;
    rdfs:comment "A single test case in a connector verification plan." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class jumo:SchemaBoundPayload ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path jumo:inputPayload ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path jumo:operationId ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path jumo:effectClass ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path jumo:expectedOutputDigest ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path jumo:testCaseId ],
        [ sh:class jumo:SchemaBoundPayload ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path jumo:rollbackPayload ] ;
    sh:targetClass jumo:ConnectorTestCase .

jumo:ConsumptionReport a sh:NodeShape ;
    rdfs:comment "What the work spent, in units ResourceBudget declares. Keys held identical to ResourceBudget.spec.limits by scripts/validate-integration-contracts.py today; Rego takes over that cross-check." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:minInclusive 0 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path jumo:tokens ],
        [ sh:datatype xsd:float ;
            sh:maxCount 1 ;
            sh:minInclusive 0 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path jumo:estimatedCostEur ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path jumo:wallClock ;
            sh:pattern "^P(?!$)(\\d+Y)?(\\d+M)?(\\d+D)?(T(?=\\d)(\\d+H)?(\\d+M)?(\\d+S)?)?$" ],
        [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:minInclusive 0 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path jumo:toolCalls ],
        [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:minInclusive 0 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path jumo:modelCalls ] ;
    sh:targetClass jumo:ConsumptionReport .

jumo:Control a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path jumo:controlId ;
            sh:pattern "^.{2,}$" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path jumo:category ;
            sh:pattern "^.{2,}$" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path jumo:title ;
            sh:pattern "^.{3,}$" ],
        [ sh:in ( "STEP_UP_AUTHENTICATION" "HUMAN_OWNER_APPROVAL" "INDEPENDENT_VERIFICATION" "DISCLOSE_AGENT_IDENTITY" "RETAIN_PROVENANCE" "REDACT_SECRETS" "PREVIEW_BEFORE_SEND" ) ;
            sh:order 3 ;
            sh:path jumo:mandatoryObligations ] ;
    sh:targetClass jumo:Control .

jumo:ControlCatalogSpec a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class jumo:Control ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path jumo:controls ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path jumo:ownerRealm ;
            sh:pattern "^[a-z][a-z0-9-]*$" ] ;
    sh:targetClass jumo:ControlCatalogSpec .

jumo:CoordinationProfileSpec a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path jumo:ownerRealm ;
            sh:pattern "^[a-z][a-z0-9-]*$" ],
        [ sh:in ( "NONE" "SELF_REPORTED" "OBSERVED" "INDEPENDENTLY_VERIFIED" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 4 ;
            sh:path jumo:assuranceLevel ],
        [ sh:in ( "REVERSIBLE" "IRREVERSIBLE" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 2 ;
            sh:path jumo:reversibility ],
        [ sh:in ( "RING_0_ROOT_OF_TRUST" "RING_1_CONTROL_PLANE" "RING_2_AGENT_BEHAVIOR" "RING_3_GOVERNED_PROJECT" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 3 ;
            sh:path jumo:maxRing ],
        [ sh:datatype xsd:string ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path jumo:preconditions ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path jumo:rhythm ;
            sh:pattern "^P(?!$)(\\d+Y)?(\\d+M)?(\\d+D)?(T(?=\\d)(\\d+H)?(\\d+M)?(\\d+S)?)?$" ],
        [ sh:in ( "FAST_LANE" "VERTICAL_COMMAND" "COOPERATIVE_ADAPTIVE" "ASSURANCE_CELL" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 1 ;
            sh:path jumo:profileName ],
        [ sh:class jumo:CoordinationMechanismBinding ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path jumo:mechanisms ] ;
    sh:targetClass jumo:CoordinationProfileSpec .

jumo:DataProtectionImpactAssessment a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path jumo:mitigations ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path jumo:reviewer ;
            sh:pattern "^[a-z][a-z0-9-]*$" ],
        [ sh:datatype xsd:string ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path jumo:risksToDataSubjects ],
        [ sh:datatype xsd:date ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path jumo:assessedAt ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path jumo:necessityAndProportionality ;
            sh:pattern "^.{10,}$" ] ;
    sh:targetClass jumo:DataProtectionImpactAssessment .

jumo:DispositionMatch a sh:NodeShape ;
    rdfs:comment "minProperties:1 in the source (at least one match field present) moves to Rego." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:boolean ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path jumo:otherwise ],
        [ sh:class jumo:ContractReference ;
            sh:description "RoleDefinitions this rule matches as the addressee." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path jumo:addressedRoleRefs ],
        [ sh:class jumo:ContractReference ;
            sh:description "TeamSpecs this rule matches as the addressee." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path jumo:addressedTeamRefs ],
        [ sh:in ( "QUESTION" "RESEARCH" "PROJECT_WORK" "STATUS" "COMMUNICATION" "OTHER" ) ;
            sh:order 2 ;
            sh:path jumo:intentKinds ] ;
    sh:targetClass jumo:DispositionMatch .

jumo:DispositionRule a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class jumo:DispositionMatch ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path jumo:match ],
        [ sh:in ( "HANDLE_DIRECTLY" "ROUTE_TO_ROLE" "ASK_FOR_INFORMATION" "DEFER" "DECLINE" "ESCALATE" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 2 ;
            sh:path jumo:outcome ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path jumo:id ;
            sh:pattern "^[a-z][a-z0-9-]*$" ] ;
    sh:targetClass jumo:DispositionRule .

jumo:DocumentTemplateBody a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "The contract kind this template produces, checked against the emission that names it (Rego)." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path jumo:renders ],
        [ sh:datatype xsd:string ;
            sh:description "The YAML document, with ${placeholder} where a collected or derived value goes." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path jumo:body ] ;
    sh:targetClass jumo:DocumentTemplateBody .

jumo:DocumentationRoot a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "Widest audience any document under this root may claim. A ceiling, not a default: a directory set to REALM_PRIVATE holds for everything in it regardless of what a single file declares." ;
            sh:in ( "PUBLISHED_SUMMARY" "TYPED_ATTENTION_ONLY" "PROJECT_SCOPED" "REALM_PRIVATE" "ORGANIZATION_ONLY" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 1 ;
            sh:path jumo:maximumAudience ],
        [ sh:datatype xsd:string ;
            sh:description "Repository-relative directory. No leading slash and no '..'." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path jumo:path ;
            sh:pattern "^[A-Za-z0-9._-]+(/[A-Za-z0-9._-]+)*$" ] ;
    sh:targetClass jumo:DocumentationRoot .

jumo:EngagementMethodSpec a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class jumo:EngagementStage ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path jumo:stages ],
        [ sh:class jumo:ContractReference ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path jumo:agentDefinitionRef ],
        [ sh:class jumo:ContractReference ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path jumo:workerRequirementProfileRef ],
        [ sh:class jumo:ContractReference ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path jumo:resourceBudgetRef ],
        [ sh:in ( "NONE" "SELF_REPORTED" "OBSERVED" "INDEPENDENTLY_VERIFIED" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 3 ;
            sh:path jumo:assurance ],
        [ sh:class jumo:EngagementTermination ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path jumo:termination ] ;
    sh:targetClass jumo:EngagementMethodSpec .

jumo:EngagementStage a sh:NodeShape ;
