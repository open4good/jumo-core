            owl:minCardinality 1 ;
            owl:onProperty jumo:signature ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:string [ a rdfs:Datatype ;
                                owl:onDatatype xsd:string ;
                                owl:withRestrictions ( [ xsd:pattern "^.{16,}$" ] ) ] ) ] ;
            owl:onProperty jumo:signature ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:string [ a rdfs:Datatype ;
                                owl:onDatatype xsd:string ;
                                owl:withRestrictions ( [ xsd:pattern "^sha256:[0-9a-f]{64}$" ] ) ] ) ] ;
            owl:onProperty jumo:argumentDigest ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty jumo:expiresAt ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty jumo:ownerRealm ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty jumo:operationRef ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty jumo:expiresAt ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty jumo:argumentDigest ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty jumo:toolsDigest ] ;
    skos:definition "Signed, single-use MCP invocation authorization (ADR-0055). Bound to exactly one invocation id, lease, Realm, operation, argument digest and tools digest; carries no session or renewal field and therefore cannot represent renewable session authority. A lease gateway without this receipt cannot contact the upstream." ;
    skos:inScheme <https://jumo.dev/schemas/jumo-v1> ;
    jumo:jumo.audience "POLICY" ;
    jumo:jumo.boundary_eligible true ;
