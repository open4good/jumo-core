            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path jumo:expiresAt ],
        [ sh:in ( "SPRING_AI_API" "CODEX_CLI" "GEMINI_CLI" "COPILOT_CLI" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 3 ;
            sh:path jumo:adapter ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path jumo:sessionFingerprint ;
            sh:pattern "^sha256:[0-9a-f]{64}$" ] ;
    sh:targetClass jumo:ProviderSessionBinding .

jumo:RealmPublication a sh:NodeShape ;
