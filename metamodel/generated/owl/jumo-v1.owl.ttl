jumo:CoordinationMechanismBinding a owl:Class ;
    rdfs:label "CoordinationMechanismBinding" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty jumo:phase ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty jumo:riskTier ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty jumo:riskTier ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty jumo:riskTier ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty jumo:phase ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty jumo:phase ],
        [ a owl:Restriction ;
            owl:allValuesFrom jumo:CoordinationMechanism ;
            owl:onProperty jumo:mechanism ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty jumo:dependencyKind ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty jumo:mechanism ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty jumo:dependencyKind ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty jumo:mechanism ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty jumo:dependencyKind ] ;
    skos:definition "One coordination mechanism scoped to the dependency it actually governs, replacing a single team-wide mode (docs/concepts/positionnement-conceptuel.md#coordination-des-dependances). Shared by TeamSpec and CoordinationProfile so a team's inline coordination and a reusable named profile speak the same vocabulary." ;
    skos:inScheme <https://jumo.dev/schemas/jumo-v1> ;
    jumo:jumo.audience "REALM_PRIVATE" ;
    jumo:jumo.boundary_eligible true ;
    jumo:jumo.model_role "VALUE_OBJECT" ;
    jumo:jumo.schema_profiles "draft-2020-12,native-json-schema,prompted-json-validated" ;
    jumo:jumo.sensitivity "INTERNAL" ;
    jumo:jumo.state_authority "NONE" .

