jumo:ExecutionCellSpec a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:in ( "PLATFORM" "HOSTED_VM" "DESKTOP" "ANDROID" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 1 ;
