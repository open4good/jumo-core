jumo:JumoKitSpec a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class jumo:KitModule ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path jumo:modules ],
        [ sh:class jumo:KitBindingDeclaration ;
            sh:description "Open string-keyed map in the source schema, modeled as a list of key/type pairs (see ThemePack for the same pattern)." ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path jumo:bindings ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path jumo:minimumJumoVersion ;
            sh:pattern "^\\d+\\.\\d+\\.\\d+$" ],
        [ sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path jumo:exports ;
            sh:pattern "^\\.jumo/[A-Za-z0-9._/-]+\\.yml$" ],
        [ sh:datatype xsd:string ;
            sh:description "Optional binary assets (images) and i18n bundles (json) the kit distributes, distinct from `exports` because these are opaque content, not corpus-governed YAML documents -- no LinkML class validates their bytes, only their provenance (KitLockSpec.renderedAssets digest). Images and i18n bundles share this one tree rather than splitting into two export lists: both are inert content a journey (AssistedJourneyStep.image/heroImage) or the frontend i18n loader references by rendered path, never executed." ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path jumo:assetExports ;
            sh:pattern "^\\.jumo/assets/[A-Za-z0-9._/-]+\\.(png|jpg|jpeg|svg|webp|json)$" ],
        [ sh:class jumo:KitProfile ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path jumo:profiles ] ;
    sh:targetClass jumo:JumoKitSpec .

jumo:KitBindingDeclaration a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:in ( "STRING" "NUMBER" "BOOLEAN" "REALM_ID" "PROJECT_ID" "ENDPOINT_URL" "CONFIGURATION_REF" "SECRET_SLOT" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 1 ;
            sh:path jumo:type ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path jumo:key ] ;
    sh:targetClass jumo:KitBindingDeclaration .

jumo:KitBindingSpec a sh:NodeShape ;
    sh:closed true ;
