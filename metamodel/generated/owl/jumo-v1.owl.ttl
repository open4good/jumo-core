    rdfs:label "palette" ;
    skos:inScheme <https://jumo.dev/schemas/jumo-v1> .

jumo:parallelizable a owl:DatatypeProperty ;
    rdfs:label "parallelizable" ;
    skos:definition "Marks a dependency-ready step as part of a parallelizable work group in the renderer." ;
    skos:inScheme <https://jumo.dev/schemas/jumo-v1> .

