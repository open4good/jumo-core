            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path jumo:namespace ;
            sh:pattern "^[a-z][a-z0-9.-]{2,63}$" ],
