jumo:MachineAdminPlaybookSpec a sh:NodeShape ;
    rdfs:comment "Specification of an allowlisted machine admin playbook." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path jumo:playbookDigest ],
        [ sh:datatype xsd:string ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path jumo:allowedRealms ;
            sh:pattern "^[a-z][a-z0-9-]*$" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path jumo:signature ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path jumo:description ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path jumo:variablesSchemaId ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path jumo:playbookPath ],
        [ sh:datatype xsd:string ;
            sh:description "The capability this playbook implements. The platform resolves which playbook to dispatch by scanning for the one declaring the capability a ProcessStep names (capabilityRef), instead of naming the playbook instance by id -- a sealed capability name is platform vocabulary, never an instance identifier (canonical decision 15). At most one playbook may claim a given capability (Rego)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path jumo:appliesToCapability ;
            sh:pattern "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9]*){1,3}$" ] ;
    sh:targetClass jumo:MachineAdminPlaybookSpec .

