    skos:definition "WorkOrders authorized to request a delegated lease grant of this binding. Reciprocity with WorkOrderSpec.secretBindingRefs is required by policy (openbao-delegated-lease AC2)." ;
    skos:inScheme <https://jumo.dev/schemas/jumo-v1> .

jumo:allowedWorkerSubstrateRefs a owl:ObjectProperty ;
    rdfs:label "allowedWorkerSubstrateRefs" ;
    skos:inScheme <https://jumo.dev/schemas/jumo-v1> .

