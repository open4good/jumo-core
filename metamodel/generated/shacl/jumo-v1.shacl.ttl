        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path jumo:inputSha256 ;
            sh:pattern "^sha256:[0-9a-f]{64}$" ],
