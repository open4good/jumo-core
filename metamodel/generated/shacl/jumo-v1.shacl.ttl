            sh:order 3 ;
            sh:path jumo:identity ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path jumo:ownerRealm ;
            sh:pattern "^[a-z][a-z0-9-]*$" ],
        [ sh:class jumo:ExecutionCellTransport ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path jumo:transport ] ;
    sh:targetClass jumo:ExecutionCellSpec .

jumo:ExecutionCellTransport a sh:NodeShape ;
    sh:closed true ;
