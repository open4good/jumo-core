            sh:description "References RoleDefinition entries this organization uses, each bound to a named seat." ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path jumo:roleRefs ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path jumo:ownerRealm ;
            sh:pattern "^[a-z][a-z0-9-]*$" ] ;
