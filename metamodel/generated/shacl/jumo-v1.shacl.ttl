            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path jumo:kind ],
        [ sh:class jumo:ProjectSpec ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path jumo:spec ] ;
    sh:targetClass jumo:Project .

jumo:ProjectionSpec a sh:NodeShape ;
    rdfs:comment "A named view of one generated LinkML class. `of:` follows the same \"generated LinkML class name\" pattern as ProcessFlow.payloadType and ProcessStep.signalType (execution.yaml) rather than introducing a second typed-payload vocabulary." ;
