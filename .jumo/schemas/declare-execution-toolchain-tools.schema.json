{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jumo.dev/schemas/step-payload/declare-execution-toolchain-tools",
  "title": "Declare execution toolchain tool inventory step payload",
  "type": "object",
  "properties": {
    "tools": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 64 },
          "version": { "type": "string", "minLength": 1, "maxLength": 64 }
        },
        "required": ["name", "version"]
      }
    }
  },
  "required": ["tools"]
}
