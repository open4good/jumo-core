    rdfs:label "principalKind" ;
    skos:definition "OWNER and MEMBER may hold a PersonalSpace and bear RoleDefinitions; a CONTACT is modeled by someone else's Realm and has neither." ;
    skos:inScheme <https://jumo.dev/schemas/jumo-v1> .

jumo:priority a owl:DatatypeProperty ;
    rdfs:label "priority" ;
