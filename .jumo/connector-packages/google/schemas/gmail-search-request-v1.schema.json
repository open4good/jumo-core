{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jumo.dev/schemas/connector-packages/google-workspace/gmail-search-request-v1",
  "type": "object",
  "properties": {
    "query": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "description": "A Gmail search query using Gmail's own query syntax (e.g. from:, subject:, after:, label:). No sender, address or label is declared by this contract; the caller supplies one."
    },
    "maxResults": {
      "type": "integer",
      "minimum": 1,
      "maximum": 50,
      "default": 10
    }
  },
  "required": ["query"],
  "additionalProperties": false
}
