{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jumo.dev/schemas/step-payload/build-project-team",
  "title": "Build project team step payload",
  "type": "object",
  "properties": {
    "teamId": { "type": "string", "minLength": 1, "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$" },
    "teamName": { "type": "string", "minLength": 1 },
    "projectPurpose": { "type": "string", "minLength": 1 },
    "projectRef": { "type": "string", "minLength": 1 }
  },
  "required": ["teamId", "teamName", "projectPurpose", "projectRef"]
}
