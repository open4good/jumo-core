    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class jumo:SeatIndependenceGroup ;
            sh:description "Seats whose bearers must sit in different independence groups (e.g. reviewer needs a distinct provider group from implementer). Enforced in Rego." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path jumo:independentSeatGroups ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path jumo:mission ;
            sh:pattern "^.{10,}$" ],
        [ sh:class jumo:SeatIncompatibility ;
            sh:description "Seats that may never be filled by the same RoleAssignment bearer (e.g. implementer and reviewer). Enforced in Rego, not here." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path jumo:incompatibleSeatPairs ],
        [ sh:class jumo:ContractReference ;
            sh:description "Optional OrganizationTemplate this organization was instantiated from." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path jumo:organizationTemplateRef ],
