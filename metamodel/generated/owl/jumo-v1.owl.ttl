    rdfs:label "ownerPrincipalId" ;
    skos:inScheme <https://jumo.dev/schemas/jumo-v1> .

jumo:pairedGatewayRef a owl:DatatypeProperty ;
    rdfs:label "pairedGatewayRef" ;
